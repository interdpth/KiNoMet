.macro mp3mac_upsample_2_point_linear_2x
 ;note: could alternately use two hardware channels (one half-sample apart)
 ;for linear 2x interpolation (but would need an extra timer for that,
 ;which is possible on GBA, but it would hurt the "rdtsc" profiling feature)
 ;---
 timelog_start rdtsc_upsampler
 ldr  r8,[r11,mp3ctx_samples_output_size]  ;siz
 ldr  r7,=mp3_upsample_buf                 ;src
;mov  r9,r9                                ;dst
 ldr  r1,[r11,mp3ctx_upsample_recent]          ;-end of recent block
 ldr  r10,=80808080h
@@lop:                    ;Linear 2x
 ldr  r6,[r7],4         ;new
 xor  r6,r10            ;make unsigned (faster because "r2+steps" won't flip sign, and thus doesn't neeed three AND FFh's)
 and  r2,r6,0ffh        ;new          ;-fetch new
 add  r1,r2                           ;\(A+B)/2
 xor  r4,r10,r1,lsr 1                 ;/
 xor  r4,r2,lsl 8                     ;-(B)
 mov  r1,r6,lsr 8       ;new          ;\fetch new
 and  r1,0ffh           ;new          ;/
 add  r2,r1                           ;\
 mov  r0,r2,lsr 1                     ; (A+B)/2
 xor  r4,r0,lsl 16                    ;/
 xor  r4,r1,lsl 24                    ;-(B)
 mov  r2,r6,lsr 16      ;new          ;\fetch new
 and  r2,0ffh           ;new          ;/
 add  r1,r2                           ;\(A+B)/2
 xor  r5,r10,r1,lsr 1                 ;/
 xor  r5,r2,lsl 8                     ;-(B)
 mov  r1,r6,lsr 24      ;new          ;-fetch new
 add  r2,r1                           ;\
 mov  r0,r2,lsr 1                     ; (A+B)/2
 xor  r5,r0,lsl 16                    ;/
 xor  r5,r1,lsl 24                    ;-(B)
 stmia [r9]!,r4,r5                    ;-output
 subs r8,4*2
 bhi  @@lop
;blo  $        ;oops
 str  r1,[r11,mp3ctx_upsample_recent]          ;-end of curr block
 timelog_end rdtsc_upsampler
 bx   lr
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
.macro mp3mac_upsample_2_point_linearrepeat_3x
 timelog_start rdtsc_upsampler
 ldr  r8,[r11,mp3ctx_samples_output_size]  ;siz
 ldr  r7,=mp3_upsample_buf                 ;src
 mov  r6,r9                                ;dst
 ldr  r1,[r11,mp3ctx_upsample_recent]          ;-end of recent block
@@lop:
;SHIM-UNROLLED .rept 4 = 4
   ldrsb r2,[r7],1
   add  r1,r2,r1
   mov  r1,r1,asr 1
  ;and  r1,0ffh
   strb r1,[r6],1
   mov  r1,r2
   strb r1,[r6],1
   strb r1,[r6],1
   ldrsb r2,[r7],1
   add  r1,r2,r1
   mov  r1,r1,asr 1
  ;and  r1,0ffh
   strb r1,[r6],1
   mov  r1,r2
   strb r1,[r6],1
   strb r1,[r6],1
   ldrsb r2,[r7],1
   add  r1,r2,r1
   mov  r1,r1,asr 1
  ;and  r1,0ffh
   strb r1,[r6],1
   mov  r1,r2
   strb r1,[r6],1
   strb r1,[r6],1
   ldrsb r2,[r7],1
   add  r1,r2,r1
   mov  r1,r1,asr 1
  ;and  r1,0ffh
   strb r1,[r6],1
   mov  r1,r2
   strb r1,[r6],1
   strb r1,[r6],1
 subs r8,4*3
 bhi  @@lop
;blo  $        ;oops
 str  r1,[r11,mp3ctx_upsample_recent]          ;-end of curr block
 timelog_end rdtsc_upsampler
 bx   lr
;SHIM-RENAMED .endm -> .endmacro
.endmacro
