.macro mp3mac_upsample_2_point_linear_4x
 timelog_start rdtsc_upsampler
 ldr  r8,[r11,mp3ctx_samples_output_size]  ;siz
 ldr  r7,=mp3_upsample_buf                 ;src
 mov  r6,r9                                ;dst
 ldr  r1,[r11,mp3ctx_upsample_recent]          ;-end of recent block
 ldr  r10,=80808080h
@@lop:
;SHIM-UNROLLED .rept 4 = 4
   ldrb r4,[r7],1         ;new
   xor  r4,80h            ;make unsigned (faster because "sub new,diff" won't flip sign, and thus doesn't neeed three AND FFh's)
   sub  r5,r4,r1,lsr 24   ;diff=new-old
   sub  r3,r4,r5,asr 2    ;new-diff/4           ;new-(1/4)
   sub  r2,r4,r5,asr 1    ;new-diff/2           ;new-(2/4)
   sub  r1,r3,r5,asr 1    ;new-diff/4-diff/2    ;new-(3/4)
   orr  r1,r2,lsl 8
   orr  r1,r3,lsl 16
   orr  r1,r4,lsl 24
   xor  r2,r1,r10         ;make signed
   str  r2,[r6],4
   ldrb r4,[r7],1         ;new
   xor  r4,80h            ;make unsigned (faster because "sub new,diff" won't flip sign, and thus doesn't neeed three AND FFh's)
   sub  r5,r4,r1,lsr 24   ;diff=new-old
   sub  r3,r4,r5,asr 2    ;new-diff/4           ;new-(1/4)
   sub  r2,r4,r5,asr 1    ;new-diff/2           ;new-(2/4)
   sub  r1,r3,r5,asr 1    ;new-diff/4-diff/2    ;new-(3/4)
   orr  r1,r2,lsl 8
   orr  r1,r3,lsl 16
   orr  r1,r4,lsl 24
   xor  r2,r1,r10         ;make signed
   str  r2,[r6],4
   ldrb r4,[r7],1         ;new
   xor  r4,80h            ;make unsigned (faster because "sub new,diff" won't flip sign, and thus doesn't neeed three AND FFh's)
   sub  r5,r4,r1,lsr 24   ;diff=new-old
   sub  r3,r4,r5,asr 2    ;new-diff/4           ;new-(1/4)
   sub  r2,r4,r5,asr 1    ;new-diff/2           ;new-(2/4)
   sub  r1,r3,r5,asr 1    ;new-diff/4-diff/2    ;new-(3/4)
   orr  r1,r2,lsl 8
   orr  r1,r3,lsl 16
   orr  r1,r4,lsl 24
   xor  r2,r1,r10         ;make signed
   str  r2,[r6],4
   ldrb r4,[r7],1         ;new
   xor  r4,80h            ;make unsigned (faster because "sub new,diff" won't flip sign, and thus doesn't neeed three AND FFh's)
   sub  r5,r4,r1,lsr 24   ;diff=new-old
   sub  r3,r4,r5,asr 2    ;new-diff/4           ;new-(1/4)
   sub  r2,r4,r5,asr 1    ;new-diff/2           ;new-(2/4)
   sub  r1,r3,r5,asr 1    ;new-diff/4-diff/2    ;new-(3/4)
   orr  r1,r2,lsl 8
   orr  r1,r3,lsl 16
   orr  r1,r4,lsl 24
   xor  r2,r1,r10         ;make signed
   str  r2,[r6],4
 subs r8,4*4
 bhi  @@lop
;blo  $        ;oops
 str  r1,[r11,mp3ctx_upsample_recent]          ;-end of curr block
 timelog_end rdtsc_upsampler
 bx   lr
;SHIM-RENAMED .endm -> .endmacro
.endmacro
