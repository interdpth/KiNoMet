.align 4
fmt_layer_proc_names:   ;constants for "mp3_layer"
 fmt_none       equ 00h
 dd 0
 db "--",0,"         "
 fmt_mp1        equ 01h
 dd 0
 db "mp1",0,"        "
 fmt_mp2        equ 02h
 dd 0
 db "mp2",0,"        "
 .definelabel fmt_mp3, 03h
 dd 0
 db "mp3",0,"        "
 fmt_wav_pcm    equ 04h
 dd decoder_select_wav_pcm
 db "wav/pcm",0,"    "
 fmt_wav_alaw   equ 05h
 dd decoder_select_wav_alaw
 db "wav/alaw",0,"   "
 fmt_wav_ulaw   equ 06h
 dd decoder_select_wav_ulaw
 db "wav/ulaw",0,"   "
 fmt_wav_float  equ 07h
 dd decoder_select_wav_float
 db "wav/float",0,"  "
 fmt_aiff       equ 08h
 dd decoder_select_aiff
 db "aiff",0,"       "
 fmt_aifc_none  equ 09h
 dd decoder_select_aifc_none
 db "aifc/none",0,"  "
 fmt_aifc_sowt  equ 0ah
 dd decoder_select_aifc_sowt
 db "aifc/sowt",0,"  "
 fmt_aifc_alaw  equ 0bh
 dd decoder_select_aifc_alaw
 db "aifc/alaw",0,"  "
 fmt_aifc_ulaw  equ 0ch
 dd decoder_select_aifc_ulaw
 db "aifc/ulaw",0,"  "
 fmt_aifc_float equ 0dh
 dd decoder_select_aifc_float
 db "aifc/float",0,' '
 .definelabel fmt_flac, 0eh
 dd 0
 db "flac",0,"       "
 fmt_au_pcm     equ 0fh
