;https://en.wikipedia.org/wiki/List_of_Unicode_characters
;------------------
charset_gap_list:   ;CHARSET_GAP's
 dw 0020h,024Fh+1       ;Latin characters
 dw 2010h,20C0h+1       ;Symbols/Superscript/Subscript and Currency symbols
 dw 0,0   ;end of list
;------------------
sortcode_gap_list:  ;SORTCODE_GAP's (unlike chars, this includes 00h-1Fh, ie. with NUL char) (there may be further differences if not all chars are implemented in each list)
 dw 0000h,024Fh+1       ;Latin characters
 dw 2000h,20C0h+1       ;Symbols/superscript/subscript and Currency symbols
 dw 0,0   ;end of list
 SORTCODE_1ST_GAP equ (024Fh+1)  ;hardcoded for faster compare
;------------------
prop_charset:                      ;XXXunicode
@@code_0020h:
