 db sortcode_blank      ;2020h Dagger single (typograhy)            (ANSI=86h)
 db sortcode_blank      ;2021h Dagger double (typograhy)            (ANSI=87h)
 db sortcode_blank      ;2022h Bullet, circular dot                 (ANSI=95h)
 db sortcode_blank      ;2023h Bullet, triangular bullet
