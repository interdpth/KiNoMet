 dd playqueue_info; primary
   .definelabel tab_id_search, (org()-gui_tab_list)/4
   dd search_info;
 .definelabel tab_id_options, (org()-gui_tab_list)/4
 dd options_info;
 .definelabel tab_id_help, (org()-gui_tab_list)/4
 dd help_info;
 .definelabel gui_num_tabs, (org()-gui_tab_list)/4;/
 .definelabel tab_id_curr_option, (org()-gui_tab_list)/4
 dd curr_option_info;-extra
