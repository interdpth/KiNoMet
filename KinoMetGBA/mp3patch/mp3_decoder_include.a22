;:----------------- Mp3 data (log strings)
;------------------
;SHIM-REMOVED.code  ;or .const
 txt_hello:
  db "nocash mp3 arm decoder v",30h+ver_hi,'.',30h+ver_lo,", 2024.."
  db 30h+(year/1000)% 10,30h+(year/100)% 10,30h+(year/10)% 10,30h+(year)% 10
  db " martin korth, BDS now",0dh,0ah,0
 txt_prescanning: db "Prescanning...",0
 src_data_name: db "audiofile",0
;---
  txt_mode_stats: db "channel modes:",0
  .align 4                                         ;\
  mp3_mode_names:                                 ;
   dd txt_mode_stereo_lr        ;\              ;
   dd txt_mode_invalid          ; mode 0        ;
   dd txt_mode_invalid          ;               ;
   dd txt_mode_invalid          ;/              ;
   dd txt_mode_joint_lr         ;\              ;
   dd txt_mode_joint_i          ; mode 1        ;
   dd txt_mode_joint_ms         ;               ;
   dd txt_mode_joint_i_ms       ;/              ;
   dd txt_mode_dual             ;\              ;
   dd txt_mode_invalid          ; mode 2        ;
   dd txt_mode_invalid          ;               ;
   dd txt_mode_invalid          ;/              ;
   dd txt_mode_mono             ;\              ;
   dd txt_mode_invalid          ; mode 3        ;
   dd txt_mode_invalid          ;               ;
   dd txt_mode_invalid          ;/              ;/
  ;---
   .align 4
   .definelabel flac_mode_names, org();aka asgn
    dd txt_mode_mono      ;00h 1 channel: mono
    dd txt_mode_stereo_lr ;01h 2 channels: left, right
    dd txt_mode_N_ch      ;02h 3 channels: left, right, center
    dd txt_mode_N_ch      ;03h 4 channels: front left, front right, back left, back right
    dd txt_mode_N_ch      ;04h 5 channels: front left, front right, front center, back/surround left, back/surround right
    dd txt_mode_N_ch      ;05h 6 channels: front left, front right, front center, LFE, back/surround left, back/surround right
    dd txt_mode_N_ch      ;06h 7 channels: front left, front right, front center, LFE, back center, side left, side right
    dd txt_mode_N_ch      ;07h 8 channels: front left, front right, front center, LFE, back left, back right, side left, side right
    dd txt_mode_joint_ls  ;08h 2 channels: left, right; stored as left-side stereo
    dd txt_mode_joint_sr  ;09h 2 channels: left, right; stored as side-right stereo
    dd txt_mode_joint_ms  ;0Ah 2 channels: left, right; stored as mid-side stereo
    dd txt_mode_invalid   ;0Bh Reserved
    dd txt_mode_invalid   ;0Ch Reserved
    dd txt_mode_invalid   ;0Dh Reserved
    dd txt_mode_invalid   ;0Eh Reserved
    dd txt_mode_invalid   ;0Fh Reserved
   ;---
   txt_mode_N_ch:      db " N-channel=",0
   txt_mode_joint_ls:  db " joint(l/s)=",0
   txt_mode_joint_sr:  db " joint(s/r)=",0
  txt_mode_stereo_lr:  db " stereo(l/r)=",0
  txt_mode_joint_lr:   db " joint(l/r)=",0
  txt_mode_joint_i:    db " joint(i)=",0
  txt_mode_joint_ms:   db " joint(m/s)=",0
  txt_mode_joint_i_ms: db " joint(i+m/s)=",0
  txt_mode_dual:       db " dual=",0
  txt_mode_mono:       db " mono=",0
  txt_mode_invalid:    db " INVALID(???)=",0
;---
 txt_file_name: db "file name: ",0
 txt_file_size: db "file size: ",0
 txt_id3_size:  db ", id3 size: ",0
 txt_tag_size:  db ", tag size: ",0
 txt_src_ms1:   db ", duration: ",0
 txt_src_ms2:   db " ms",0
 txt_input:     db "input: ",0
 txt_output:    db "output: ",0
 txt_hz:        db " hz, ",0
 txt_channels:  db " channels, ",0
 txt_bit:       db " bit",0
 txt_kbit_s:    db " kbit/s",0
   txt_upsampled: db ", upsampled to ",0, " Hz",0
   txt_flac_block_size: db "block size: ",0
   txt_flac_frame_size: db ", frame size: ",0
   txt_flac_thru:       db "..",0
txt_not_found:  db "cannot open source file",0dh,0ah,0
