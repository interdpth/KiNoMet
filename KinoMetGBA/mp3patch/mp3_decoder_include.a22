gui_help_text:
 db "nocash mp3 player v",30h+ver_hi,'.',30h+ver_lo
   db " - gba version",0                ;
 db 0
 db ">general controls",0
 db "  up/down    = move cursor",0
 db "  left/right = change window",0
 db "  A          = trigger",0
; db '  L/R        = rewind/fastforward',0               XXX
 db 0
 db ">playqueue controls",0
 db "  A          = play (newly selected song)",0
 db "  A          = play/pause (on active song)",0
 db "  A+up/down  = change position in playqueue",0
 db "  A+left     = remove from playqueue",0
 db 0
 db ">filelist controls",0
 db "  A          = add song to playqueue",0
 db "  A+up/down  = add multiple songs",0
 db 0
   db ">search controls",0
   db "replace punctuation marks by space characters, &",0
   db "use letters A-Z without accent marks, for example:",0
   db "  Letter O    ="                                                         ;\
   db ' '
   db_ansi_to_utf8 08Ch;Letter OE, uppercase                 ;
   db ' '
   db_ansi_to_utf8 0D8h;Letter O stroke, uppercase           ;
   db ' '
   db_ansi_to_utf8 0D3h;Letter O acute, uppercase            ;
   db ' '
   db_ansi_to_utf8 0D4h;Letter O circumflex, uppercase       ;
   db ' '
   db_ansi_to_utf8 0D2h;Letter O grave, uppercase            ;
   db ' '
   db_ansi_to_utf8 0D5h;Letter O tilde, uppercase            ;
   db ' '
   db_ansi_to_utf8 0D6h;Letter O diaresis (umlaut), uppercase;
   db 0                                                                         ;/
   db "  Letter S    ="                                                         ;\
   db ' '
   db_ansi_to_utf8 08Ah;Letter S caron, uppercase            ;
   db ' '
   db_ansi_to_utf8 0DFh;Letter S sharp (SZ), lowercase       ;
   db 0                                                                         ;/
   db "  Space       = + - , . etc.",0
   db "the filelist sort function uses similar rules",0
   db 0
 db ">options controls",0
 db "  A          = prompt option",0
; db '  A+up/down  = quick change option',0              XXX
 db 0
 db ">supported formats",0                              ;\
 db " mp3"                                              ;
   db " mp2 mp1"                                        ;
   db " flac"                                           ;
   db " wav"                                            ;
   db " aiff"                                           ;
   db " au"                                             ;
 db 0    ;end of line                                   ;
 db 0    ;blank like                                    ;/
 db ">homepage",0
 db "  http://problemkaputt.de/mp3.htm",0
 db 0
 db 0ffh
.align 4
