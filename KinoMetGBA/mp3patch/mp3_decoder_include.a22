   ldrne r2,[r6,-01h*4]     ;coeff                ; (with precalculated 1st sum)
   mulne r4,r1,r2           ;sum   ;r4 = (r1*r2)  ;
   bxne  r7    ;--> @@sum32_unrolled_bottom-N*0Ch ;/
   bx   lr
