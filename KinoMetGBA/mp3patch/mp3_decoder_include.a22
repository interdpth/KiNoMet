 ;SORTCODE_GAP
 ;---
 ;0250h...02AFh  IPA Extensions (International Phonetic Alphabet)
 ;02B0h...02FFh  Spacing modifiers
 ;0300h...036Fh  Combining Marks
 ;0370h...03FFh  Greek and Coptic
 ;0400h...04FFh  Cyrillic
 ;0500h...052Fh  Cyrillic Supplement
 ;0530h...058xh  Armenian
 ;059xh...05FFh  Hebrew
 ;0600h...06FFh  Arabic
 ;0700h...074Fh  Syriac
 ;0780h...07Bxh  Thaana (Dhivehi and Arabic in the Maldives)
 ;0800h...083Fh  Samaritian
 ;0840h...085Fh  Mandaic (historic/classical)
 ;10A0h...10FFh  Georgian
 ;1800h...18AFh  Mongolian
 ;1E00h...1EFFh  Latin Extended Additional
 ;---
 ;SORTCODE_GAP
 ;---
 @@code_2000h:
 db sortcode_blank      ;2000h Whitespace, width of one en "en quad"
 db sortcode_blank      ;2001h Whitespace, width of one em "em quad"
 db sortcode_blank      ;2002h Whitespace, width of one en "en space" "nut"
 db sortcode_blank      ;2003h Whitespace, width of one em "em space" "mutton"
 db sortcode_blank      ;2004h Whitespace, width of 1/3 em "thick space"
 db sortcode_blank      ;2005h Whitespace, width of 1/4 em "mid space"
 db sortcode_blank      ;2006h Whitespace, width of 1/6 em
 db sortcode_blank      ;2007h Whitespace, width of one digit "figure space"
 db sortcode_blank      ;2008h Whitespace, width of one dot or comma "punctuation space"
 db sortcode_blank      ;2009h Whitespace, width of 1/5 em "thin space"
 db sortcode_blank      ;200Ah Whitespace, width less than 1/5 em "hair space"
 db sortcode_blank      ;200Bh Whitespace, zero width space
 db sortcode_blank      ;200Ch Whitespace, zero width non-joiner
 db sortcode_blank      ;200Dh Whitespace, zero width joiner
 db sortcode_blank      ;200Eh Control code: Direction Left-to-Right Mark
 db sortcode_blank      ;200Fh Control code: Direction Right-to-Left Mark
 db sortcode_blank      ;2010h Dash Hyphen
