 .macro def_icon_tiles
;SHIM-STUBBED  .hexdat 0000000000000000000000000000000000000000000000001111111121222222
;SHIM-STUBBED  .hexdat 0000000000000000000000000000000000000000000000001111111122222222
;SHIM-STUBBED  .hexdat 0000000000000000000000000000000000000000000000001111111122222222
;SHIM-STUBBED  .hexdat 0000000000000000000000000000000000000000000000001111111122222212
;SHIM-STUBBED  .hexdat 2122222221222222212222222122222221222222212222222122222221222222
;SHIM-STUBBED  .hexdat 2222222222222222222222222222222222222222222222221221222201102222
;SHIM-STUBBED  .hexdat 2222222222222222222222222222222222222222222222222222122122220110
;SHIM-STUBBED  .hexdat 2222221222222212222222122222221222222212222222122222221222222212
;SHIM-STUBBED  .hexdat 2122222221222222212222222122222221222222212222222122221121222221
;SHIM-STUBBED  .hexdat 0110222212212222222222222222222222222222222222221111111122222222
;SHIM-STUBBED  .hexdat 2222011022221221222222222222222222222222222222221111111122222222
;SHIM-STUBBED  .hexdat 2222221222222212222222122222221222222212222222121122221212222212
