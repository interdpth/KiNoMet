.macro mp3mac_upsample_3_point_gauss_nocash_2x
 push r9,r12,lr
 timelog_start rdtsc_upsampler
 ldr  lr,[r11,mp3ctx_samples_output_size]  ;siz
 ldr  r12,=mp3_upsample_buf                ;src
;mov  r9,r9                                ;dst
 ldr  r1,[r11,mp3ctx_upsample_recent]          ;\
 mov  r2,r1,lsr 8                              ; end of recent block
 and  r1,0ffh                                  ;/
 ldr  r10,=80808080h
@@lop:                    ;Gauss PSX
        ;00h
        ;00h
        ;00h
        ;10h x
        ;20h xx
        ;50h xxxxx
        ;80h xxxxxxxx
        ;A0h xxxxxxxxxx
        ;C0h xxxxxxxxxxxx
 ldr  r8,[r12],4        ;new
 xor  r8,r10            ;make unsigned (faster because "r2+steps" won't flip sign, and thus doesn't neeed three AND FFh's)
 and  r3,r8,0ffh        ;new            ;-fetch new
 add  r0,r1,r2                          ;\(A*80h+B*80h+C*00h)/100h
 xor  r4,r10,r0,lsr 1                   ;/
 add  r0,r2,r2,lsl 1  ;r2*3             ;\
 add  r0,r1,r0,lsl 1  ;r2*6+r1          ; (A*20h+B*C0h+C*20h)/100h
 add  r0,r3           ;r2*6+r1+r3       ;
 mov  r0,r0,lsr 3                          ;
 xor  r4,r0,lsl 8                       ;/
 mov  r1,r8,lsr 8       ;new            ;\fetch new
 and  r1,0ffh                           ;/
 add  r0,r2,r3                          ;\
 mov  r0,r0,lsr 1                       ; (A*80h+B*80h+C*00h)/100h
 xor  r4,r0,lsl 16                      ;/
 add  r0,r3,r3,lsl 1                    ;\
 add  r0,r2,r0,lsl 1                    ; (A*20h+B*C0h+C*20h)/100h
 add  r0,r1                             ;
 mov  r0,r0,lsr 3                          ;
 xor  r4,r0,lsl 24                      ;/
 mov  r2,r8,lsr 16      ;new            ;\fetch new
 and  r2,0ffh                           ;/
 add  r0,r3,r1                          ;\(A*80h+B*80h+C*00h)/100h
 xor  r5,r10,r0,lsr 1                   ;/
 add  r0,r1,r1,lsl 1                    ;\
 add  r0,r3,r0,lsl 1                    ; (A*20h+B*C0h+C*20h)/100h
 add  r0,r2                             ;
 mov  r0,r0,lsr 3                          ;
 xor  r5,r0,lsl 8                       ;/
 mov  r3,r8,lsr 24      ;new            ;-fetch new
 add  r0,r1,r2                          ;\
 mov  r0,r0,lsr 1                       ; (A*80h+B*80h+C*00h)/100h
 xor  r5,r0,lsl 16                      ;/
 add  r0,r2,r2,lsl 1  ;r2*3             ;\
 add  r0,r1,r0,lsl 1  ;r2*6+r1          ; (A*20h+B*C0h+C*20h)/100h
 add  r0,r3           ;r2*6+r1+r3       ;
 mov  r0,r0,lsr 3                          ;
 xor  r5,r0,lsl 24                      ;/
 stmia [r9]!,r4,r5                      ;-output
 mov  r1,r2                             ;\shuffle prev values
 mov  r2,r3                             ;/
 subs lr,2*4
 bhi  @@lop
;blo  $        ;oops
 orr  r1,r2,lsl 8                               ;\end of curr block
 str  r1,[r11,mp3ctx_upsample_recent]           ;/
 timelog_end rdtsc_upsampler
 pop  r9,r12,pc
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
.macro mp3mac_upsample_3_point_gauss_small_3x
 push r9,r12,lr
 timelog_start rdtsc_upsampler
 ldr  lr,[r11,mp3ctx_samples_output_size]  ;siz
 ldr  r12,=mp3_upsample_buf                ;src
;mov  r9,r9                                ;dst
 ldr  r1,[r11,mp3ctx_upsample_recent]          ;\
 mov  r2,r1,lsr 8                              ; end of recent block
 and  r1,0ffh                                  ;/
 ldr  r10,=80808080h
@@lop:                    ;Gauss PSX
        ;00h
        ;00h
        ;10h xx
        ;40h xxxxxxxx
        ;80h xxxxxxxxxxxxxxxx
        ;B0h xxxxxxxxxxxxxxxxxxxxxx
 ldrb r3,[r12],1        ;new
 xor  r3,80h            ;make unsigned (faster because "r2+steps" won't flip sign, and thus doesn't neeed three AND FFh's)
 add  r0,r1,r2                          ;\(A*80h+B*80h+C*00h)/100h
 xor  r4,r10,r0,lsr 1                   ;/
 strb r4,[r9],1                         ;-output
 add  r0,r2,r2,lsl 1  ;r2*03h           ;\
 add  r0,r0,r2,lsl 3  ;r2*0Bh           ;
 add  r0,r0,r1,lsl 2  ;r2*0Bh+r1*04h    ; (A*40h+B*B0h+C*10h)/100h
 add  r0,r0,r3        ;r2*0Bh+r1*04h+r3 ;
 xor  r4,r10,r0,lsr 4                   ;/
 strb r4,[r9],1                         ;-output
 add  r0,r2,r2,lsl 1  ;r2*03h           ;\
 add  r0,r0,r2,lsl 3  ;r2*0Bh           ;
 add  r0,r0,r3,lsl 2  ;r2*0Bh+r3*04h    ; (A*10h+B*B0h+C*40h)/100h
 add  r0,r0,r1        ;r2*0Bh+r3*04h+r1 ;
 xor  r4,r10,r0,lsr 4                   ;/
 strb r4,[r9],1                         ;-output
 mov  r1,r2  ;\shuffle prev values (alternately keep them in place, and use opcodes with different registers in each step)
 mov  r2,r3  ;/
 subs lr,3
 bhi  @@lop
;blo  $        ;oops
 orr  r1,r2,lsl 8                               ;\end of curr block
 str  r1,[r11,mp3ctx_upsample_recent]           ;/
 timelog_end rdtsc_upsampler
 pop  r9,r12,pc
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
.macro mp3mac_upsample_3_point_gauss_nocash_3x
 push r9,r12,lr
 timelog_start rdtsc_upsampler
 ldr  lr,[r11,mp3ctx_samples_output_size]  ;siz
 ldr  r12,=mp3_upsample_buf                ;src
;mov  r9,r9                                ;dst
 ldr  r1,[r11,mp3ctx_upsample_recent]          ;\
 mov  r2,r1,lsr 8                              ; end of recent block
 and  r1,0ffh                                  ;/
 ldr  r10,=80808080h
@@lop:                    ;Gauss PSX
        ;00h
        ;00h
        ;10h xx
        ;40h xxxxxxxx
        ;80h xxxxxxxxxxxxxxxx
        ;B0h xxxxxxxxxxxxxxxxxxxxxx
 ldr  r8,[r12],4        ;new
 xor  r8,r10            ;make unsigned (faster because "r2+steps" won't flip sign, and thus doesn't neeed three AND FFh's)
 and  r3,r8,0ffh        ;new            ;-fetch new
 add  r0,r1,r2                          ;\(A*80h+B*80h+C*00h)/100h
 xor  r4,r10,r0,lsr 1                   ;/
 add  r0,r2,r2,lsl 1  ;r2*03h           ;\
 add  r0,r0,r2,lsl 3  ;r2*0Bh           ;
 add  r0,r0,r1,lsl 2  ;r2*0Bh+r1*04h    ; (A*40h+B*B0h+C*10h)/100h
 add  r0,r0,r3        ;r2*0Bh+r1*04h+r3 ;
 mov  r0,r0,lsr 4                       ;
 xor  r4,r0,lsl 8                       ;/
 add  r0,r2,r2,lsl 1  ;r2*03h           ;\
 add  r0,r0,r2,lsl 3  ;r2*0Bh           ;
 add  r0,r0,r3,lsl 2  ;r2*0Bh+r3*04h    ; (A*10h+B*B0h+C*40h)/100h
 add  r0,r0,r1        ;r2*0Bh+r3*04h+r1 ;
 mov  r0,r0,lsr 4                       ;
 xor  r4,r0,lsl 16                      ;/
 mov  r1,r8,lsr 8       ;new            ;\fetch new
 and  r1,0ffh                           ;/
 add  r0,r2,r3                          ;\
 mov  r0,r0,lsr 1                       ; (A*80h+B*80h+C*00h)/100h
 xor  r4,r0,lsl 24                      ;/
 add  r0,r3,r3,lsl 1  ;r3*03h           ;\
 add  r0,r0,r3,lsl 3  ;r3*0Bh           ;
 add  r0,r0,r2,lsl 2  ;r3*0Bh+r2*04h    ; (A*40h+B*B0h+C*10h)/100h
 add  r0,r0,r1        ;r3*0Bh+r2*04h+r1 ;
 xor  r5,r10,r0,lsr 4                   ;/
 add  r0,r3,r3,lsl 1  ;r3*03h           ;\
 add  r0,r0,r3,lsl 3  ;r3*0Bh           ;
 add  r0,r0,r1,lsl 2  ;r3*0Bh+r1*04h    ; (A*10h+B*B0h+C*40h)/100h
 add  r0,r0,r2        ;r3*0Bh+r1*04h+r2 ;
 mov  r0,r0,lsr 4                       ;
 xor  r5,r0,lsl 8                       ;/
 mov  r2,r8,lsr 16      ;new            ;\fetch new
 and  r2,0ffh                           ;/
 add  r0,r3,r1                          ;\
 mov  r0,r0,lsr 1                       ; (A*80h+B*80h+C*00h)/100h
 xor  r5,r0,lsl 16                      ;/
 add  r0,r1,r1,lsl 1  ;r1*03h           ;\
 add  r0,r0,r1,lsl 3  ;r1*0Bh           ;
 add  r0,r0,r3,lsl 2  ;r1*0Bh+r3*04h    ; (A*40h+B*B0h+C*10h)/100h
 add  r0,r0,r2        ;r1*0Bh+r3*04h+r2 ;
 mov  r0,r0,lsr 4                       ;
 xor  r5,r0,lsl 24                      ;/
 add  r0,r1,r1,lsl 1  ;r1*03h           ;\
 add  r0,r0,r1,lsl 3  ;r1*0Bh           ;
 add  r0,r0,r2,lsl 2  ;r1*0Bh+r2*04h    ; (A*10h+B*B0h+C*40h)/100h
 add  r0,r0,r3        ;r1*0Bh+r2*04h+r3 ;
 xor  r6,r10,r0,lsr 4                   ;/
 mov  r3,r8,lsr 24      ;new            ;-fetch new
 add  r0,r1,r2                          ;\
 mov  r0,r0,lsr 1                       ; (A*80h+B*80h+C*00h)/100h
 xor  r6,r0,lsl 8                       ;/
 add  r0,r2,r2,lsl 1  ;r2*03h           ;\
 add  r0,r0,r2,lsl 3  ;r2*0Bh           ;
 add  r0,r0,r1,lsl 2  ;r2*0Bh+r1*04h    ; (A*40h+B*B0h+C*10h)/100h
 add  r0,r0,r3        ;r2*0Bh+r1*04h+r3 ;
 mov  r0,r0,lsr 4                       ;
 xor  r6,r0,lsl 16                      ;/
 add  r0,r2,r2,lsl 1  ;r2*03h           ;\
 add  r0,r0,r2,lsl 3  ;r2*0Bh           ;
 add  r0,r0,r3,lsl 2  ;r2*0Bh+r3*04h    ; (A*10h+B*B0h+C*40h)/100h
 add  r0,r0,r1        ;r2*0Bh+r3*04h+r1 ;
 mov  r0,r0,lsr 4                       ;
 xor  r6,r0,lsl 24                      ;/
 stmia [r9]!,r4,r5,r6                   ;-output
 mov  r1,r2                             ;\shuffle prev values
 mov  r2,r3                             ;/
 subs lr,3*4
 bhi  @@lop
;blo  $        ;oops
 orr  r1,r2,lsl 8                               ;\end of curr block
 str  r1,[r11,mp3ctx_upsample_recent]           ;/
 timelog_end rdtsc_upsampler
