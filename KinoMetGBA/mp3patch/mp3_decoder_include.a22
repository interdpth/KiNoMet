  filelist_start equ 33762368
    ;content:
    ;  list of 32bit pointers for help_info entries
    ;  list of 32bit pointers for options_info entries
    ;  database with files (fdb_cluster, fdb_filesize, fdb_name)
    ;  list of 32bit pointers for playqueue_info entries
    ;  <free space>
    ;  list of 32bit pointers for filelist_info entries
  filelist_end equ MEM_DATA_MAX
.if 33762368>MEM_DATA_MAX

.error "errif failed"
.endif
