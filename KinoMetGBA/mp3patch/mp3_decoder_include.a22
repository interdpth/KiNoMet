 ;--- below 80h..9Fh are defined here because they exist in ANSI (in Unicode 80h..9Fh is special/reserved, and the corresponding chars use OTHER numbers)
 db sortcode_blank      ;80h    ;20ACh Currency Euro (E=) (ANSI=80h)
 db sortcode_unused     ;81h    ; (unused)
