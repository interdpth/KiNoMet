;------------------
;:---kernel-------- Mp3 code kernel misc
;------------------
fatalunexpected:
 b    org()
;------------------
get_32bit_le_unaligned:    ;in: r4=src - out r4:value   ;LITTLE-ENDIAN
 mov  r2,4
@@lop:
 ldrb r1,[r4],1
 mov  r3,r3,lsr 8
 orr  r3,r3,r1,lsl 24
 subs r2,1
 bne  @@lop
 mov  r4,r3
 bx   lr
;------------------
get_16bit_le_unaligned:    ;in: r4=src - out r4:value   ;LITTLE-ENDIAN ;for zip
 ldrb r1,[r4],1
 ldrb r2,[r4],1
 orr  r4,r1,r2,lsl 8
 bx   lr
;------------------
generic_memcopy:        ;in: r4=src, r5=dst, r6=len
 cmp  r6,0                      ;\exit if len=0
 bxeq lr                        ;/
 ;- - -


 push r7,r8,r9,lr
 tst  r5,1                      ;\
 beq  @@dst_align2              ; first 8bit (when unaligned dst)
 ldrb r3,[r4],1                 ;
   ldrb lr,[r5,-1]!             ; ;\
   orr  lr,r3,lsl 8             ; ; put BYTE via HALFWORD write
   strh lr,[r5],1+1             ; ;/
 subs r6,1                      ;
 beq  @@done                    ;
@@dst_align2:                   ;/

 tst  r5,2                      ;\
 beq  @@dst_align4              ;
 cmp  r6,2                      ;
 blo  @@copy_final_byte         ; first 16bit (when unaligned dst)
 tst  r4,1                      ;
 ldreqh r3,[r4],2   ;-even src  ;
 ldrneb r3,[r4],1   ;\          ;
 ldrneb lr,[r4],1   ; odd src   ;
 orrne  r3,lr,lsl 8 ;/          ;
 strh r3,[r5],2     ;-even dst  ;
 subs r6,2                      ;
 beq  @@done                    ;
@@dst_align4:                   ;/

 tst  r4,3                      ;\
 bne  @@different_align         ;/

 movs r7,r6,lsr 2   ;len/4
 beq  @@copy_final_123_bytes
@@copy_lop_32bit:
 ldr  r3,[r4],4                         ;XXX could use 32bit DMA or LDMIA
 str  r3,[r5],4
 subs r7,1
 bne  @@copy_lop_32bit
@@copy_final_123_bytes:
 ands r6,3      ;len and 3
 beq  @@done
 tst  r6,2                      ;\
 ldrneh r3,[r4],2               ; final 16bit
 strneh r3,[r5],2               ;
 subne  r6,2                    ;/
 tst  r6,1                      ;\final 8bit
 bne  @@copy_final_byte         ;/
@@done:
 pop  r7,r8,r9,pc
;---
@@different_align:

             ;XXX when 16bit aligned --> could use 16bit DMA

 and  r8,r4,3           ;odd.bytes
 sub  r4,r8
 mov  r8,r8,lsl 3          ;odd.bits1
 rsb  r9,r8,32          ;odd.bits2

 ldr  r3,[r4],4         ;new
 movs r7,r6,lsr 2   ;len/4
 beq  @@copy_shifted_final_123_bytes

@@copy_shifted_lop:                          ;XXX could use LDMIA + shifting
 mov  lr,r3,lsr r8      ;old = new SHR odd.bits1
 ldr  r3,[r4],4         ;new
 orr  lr,r3,lsl r9      ;old = new SHL odd.bits2 + old
 str  lr,[r5],4         ;put
 subs r7,1
 bne  @@copy_shifted_lop
@@copy_shifted_final_123_bytes:
 mov  lr,r3,lsr r8      ;old = new SHR odd.bits1
 ldr  r3,[r4],4         ;new
 orr  lr,r3,lsl r9      ;old = new SHL odd.bits2 + old

 mov  r8,r8,lsr 3          ;odd.bytes
 sub  r4,4              ;stc stepback last readahead
 add  r4,r8             ;src back to odd position

 ands r6,3      ;len and 3      ;\final any
 beq  @@done                    ;/
 tst  r6,2                      ;\
 strneh lr,[r5],2               ; put final 16bit
 movne  lr,lr,lsr 16               ;/
 tst  r6,1                      ;\
   ldrneb r3,[r5,1]    ;old     ; ;\
   andne  lr,0ffh      ;new     ; ; put BYTE via HALFWORD write
   orrne  lr,r3,lsl 8  ;merge   ; ;
   strneh lr,[r5],1    ;put     ; ;/
 add  r4,r6                     ;-
 b    @@done
;---
@@copy_final_byte:
 ldrb lr,[r4],1                 ;-
 ldrb r3,[r5,1]                 ;\
;and  lr,0ffh                   ; put BYTE via HALFWORD write
 orr  lr,r3,lsl 8               ;
 strh lr,[r5],1                 ;/
;strb lr,[r5],1                 ;-put BYTE as such (won't work in vram)
 subs r6,1                      ;
 beq  @@done                    ;
 b    org()    ;oops, len should have been zero now
;------------------
generic_zerofill:       ;in: r4=dst, r5=len
 mov    r3,0                    ;-fillvalue
;- - - - - - ------
generic_memfill_r3:
 cmp    r5,0                    ;\exit if len=0
 bxeq   lr                      ;/
;- - -


 push   lr
 orr    r3,r3,lsl 8             ;\fillvalue 8bit to 32bit
 orr    r3,r3,lsl 16            ;/
 tst    r4,1                    ;\
   strneb r3,[r4],1             ; ;-put BYTE as such
 subne  r5,1                    ;/
 cmp    r5,2                            ;\
 blo    @@final_byte_to_even_dst_if_any ;/
 tst    r4,2                    ;\
 strneh r3,[r4],2               ; leading 16bit (when non-4-byte aligned)
 subne  r5,2                    ;/
;- - -
@@core_fill_lop32bit:           ;\
 subs   r5,4      ;len          ; core-fill 32bit
 strpl  r3,[r4],4               ;       XXX could use STMIA or DMA (though DMA needs to read src, which is SLOWER than STMIA)
 bgt    @@core_fill_lop32bit    ;/
 beq    @@done      ;len.zero   ;-
 tst    r5,2        ;len.bit1   ;\final 16bir
 strneh r3,[r4],2               ;/
@@final_byte_to_even_dst_if_any:
 tst    r5,1        ;len.bit0   ;\
   strneb r3,[r4],1             ; ;-put BYTE as such (won't work in vram)
@@done:
 pop    pc
;------------------
div_r4_r5:
 push  r2-r3,lr
 mov   r2,32            ;-lopcount 32bits
 cmp   r4,10000h        ;\
 movcc r4,r4,lsl 16     ; quick-skip upper 16bit, if all zero
 subcc r2,16            ;/
 cmp   r4,1000000h      ;\
 movcc r4,r4,lsl 8      ; quick-skip upper 8bit, if all zero
 subcc r2,8             ;/
 cmp   r4,10000000h     ;\
 movcc r4,r4,lsl 4      ; quick-skip upper 4bit, if all zero
 subcc r2,4             ;/
 cmp   r4,40000000h     ;\
 movcc r4,r4,lsl 2      ; quick-skip upper 2bit, if all zero
 subcc r2,2             ;/
 mov   r3,0        ;scratch
@@divlop:
 adds  r4,r4,r4    ;shift left incoming, to carry
 adc   r3,r3,r3    ;r3*2+cy
 cmp   r3,r5       ;compare r3-r5
 subhs r3,r3,r5    ;if GE -> execute r3-r5
 addhs r4,1        ;if GE -> increment result
 subs  r2,1
 bne   @@divlop
 mov   r5,r3       ;remainder
 pop   r2-r3,pc
;------------------
div_r5r4_r6:
 push  r2-r3,lr
 mov   r2,64            ;-lopcount 64bits
 cmp   r5,0             ;\
 moveq r5,r4            ; quick-skip upper 32bit, if all zero
 moveq r4,0             ;
 subeq r2,32            ;/
 cmp   r5,10000h        ;\
 movcc r5,r5,lsl 16     ;
 orrcc r5,r4,lsr 32-16  ; quick-skip upper 16bit, if all zero
 movcc r4,r4,lsl 16     ;
 subcc r2,16            ;/
 cmp   r5,1000000h      ;\
 movcc r5,r5,lsl 8      ;
 orrcc r5,r4,lsr 32-8   ; quick-skip upper 8bit, if all zero
 movcc r4,r4,lsl 8      ;
 subcc r2,8             ;/
 cmp   r5,10000000h     ;\
 movcc r5,r5,lsl 4      ;
 orrcc r5,r4,lsr 32-4   ; quick-skip upper 4bit, if all zero
 movcc r4,r4,lsl 4      ;
 subcc r2,4             ;/
 cmp   r5,40000000h     ;\
 movcc r5,r5,lsl 2      ;
 orrcc r5,r4,lsr 32-2   ; quick-skip upper 2bit, if all zero
 movcc r4,r4,lsl 2      ;
 subcc r2,2             ;/
 mov   r3,0        ;scratch
@@divlop:
 adds  r4,r4,r4    ;\shift left incoming, to carry
 adcs  r5,r5,r5    ;/
 adc   r3,r3,r3    ;r3*2+cy
 cmp   r3,r6       ;compare r3-r6
 subhs r3,r3,r6    ;if GE -> execute r3-r6
 addhs r4,1        ;if GE -> increment result
 subs  r2,1
 bne   @@divlop
 mov   r5,r3       ;remainder
 pop   r2-r3,pc
;------------------
div_unsigned_r5r4_r7r6:
 push  r0-r3,lr
 mov   r2,64                        ;lopcount 64bits
 mov   r0,0
 mov   r1,0;scratch
@@divlop:
 adds  r4,r4,r4
 adcs  r5,r5,r5;shift left incoming, to carry
 adcs  r0,r0,r0
 adc   r1,r1,r1;scratch*2+cy
 cmp   r0,r6
 sbcs  r3,r1,r7;compare scratch-divider
 blo   @@divnext
 subs  r0,r0,r6
 sbc   r1,r1,r7;if GE -> execute scratch-divider
 adds  r4,1
 adc   r5,0;if GE -> increment result
@@divnext:
 subs  r2,1
 bne   @@divlop
 mov   r6,r0
 mov   r7,r1;remainder
 pop   r0-r3,pc
;------------------
;:---kernel-------- Mp3 code hardware file reader
;------------------
MP3_MAX_COMPRESSED_FRAME_SIZE  equ 2000h   ;usually less than 1000h (except, insane free format variants could get close to 2000h)
;---
;Maximum framesize
;  the highest framesize occurs on LARGE bitrate divided by SMALL sample rate,
;  that is, specifically on the 32kHz, 16kHz, 8kHz sample rates.
;  in practice, it would be nonsensical to combine low sample rates with high
;  bitrates, but it COULD occur in nonsense files or corrupted frames.
;---
;Standard bitrates
;  FrameSize = 144/n * BitRate / SampleRate + Padding
;  ---
;  5A1h=1441 = 144/1 * 320 / 32 +1          ;mp3, mpeg1
;  2D1h=721  = 144/2 * 160 / 16 +1          ;mp3, mpeg2
;  5A1h=1441 = 144/2 * 160 / 8  +1          ;mp3, mpeg2.5
;  ---
;  6C1h=1729 = 144/1 * 384 / 32 +1          ;mp2, mpeg1    <-- biggest official
;  5A1h=1441 = 144/1 * 160 / 16 +1          ;mp2, mpeg2
;  B41h=2881 = 144/1 * 160 / 8  +1          ;mp2, mpeg2.5  <-- bigger inofficial
;  ---
;  2A4h=676  = 144/3 * 448 / 32 +4          ;mp1, mpeg1
;  304h=772  = 144/3 * 256 / 16 +4          ;mp1, mpeg2
;  604h=1540 = 144/3 * 256 / 8  +4          ;mp1, mpeg2.5
;Note:
;  The 144/n is derived from the number of samples per frame (1152/n/8)
;  (the /8 is for converting the bitrate-based result from bits to bytes)
;  (the /n is for variants with 1152/1, 1152/2, or 1152/3 samples per frame)
;  144/1 = 1152/8  ;for mp3 with high sample rates, and for mp2 at any rate
;  144/2 = 576/8   ;for mp3 with low sample rates
;  144/3 = 384/8   ;for mp1 at any rate
;Padding byte(s)
;  the above padding SHOULD be ONLY used if the framesize isn't a multiple
;  of 8bits (or 32bits for mp1). that isn't the case in the above examples,
;  so padding SHOULD be 0. nonetheless, it's mathematically possible to
;  set the padding bit (eg. in a malformed file, or perhaps in a VBR file),
;  so it's better to allocate enough memory for padding, even if it occurs
;  in unusual locations.
;---
;Free format (custom bitrate)
;  LAME does reportedly support max 640kbit/s for mp3 (via free format)
;    that would double the max mp3 frame size from 5A1h=1441 to B41h=2881.
;    (assuming that it is ONLY used for mpeg1-style rates, not for mpeg2.5)
;  And, there should be some worst-case limit for free format, computed as so:
;    max 1152 samples per frame per channel (=2304 when stereo)
;    max 19bit per huffman code (or 17bit+linbits) (plus signbits)
;          worst case for a sample-pair would be
;          17bit huffman + 2x13bit linbits + 2x1bit signbits = 45 bits
;          that is 22.5 bits per single sample (17/2 + 13 + 1 bits)
;          that is 25920 bits aka 3240 bytes (CA8h) per 1152 samples (mono)
;          that is 51840 bits aka 6480 bytes (1950h) per 2304 samples (stereo)
;    plus header + crc16 + granule headers + scale factors + padding
;    plus any amount of custom nonstandard "ancillary-data"
;  whatever that sums up to exactly, the size shouldn't exceed 2000h (8Kbyte)
;------------------
file_seek_read_r2:
 ldr  r1,[r11,mp3ctx_stream_pos]  ;src  ;-
;- - - - - --------
file_seek_read_r2_from_r1:
 ;in: r1 = wanted.offset
 ;in: r2 = wanted.size (max cache.size, minus misalignment) (0=want pre-load, but without waiting for data to be loaded)
 ;in: r11 = ctx with info on device and sector/cluster.base for current file
 ;---
 ;out: r1 = mem.addr (with at least the loaded.size mapped to there)
 ;out: r2 = loaded.size (may be LESS than wanted.size near EOF) (may be MORE if more data was already loaded)
 ;---
 ;;;ldr  r0,=sdmmc_curr_drive           ;\
 ;;;ldrb r0,[r0]                        ; check if memory mapped
 ;;;cmp  r0,dev_id_mmap                 ;
 ;;;bne  ...                            ;/

   FILE_CACHE_SIZE equ 0ffffffffh    ;no cache-size limit for direct ROM mapping
   ;---
   ldr  r0,[r11,mp3ctx_file_base]         ;-base sector/cluster or ROM addr
   ldr  r2,[r11,mp3ctx_stream_end]  ;end  ;\
   subs r2,r1   ;remain = end-pos         ;
   movlo r2,0   ;remain = 0 when negative ;/
   add  r1,r0                             ;-add base in ROM
   bx   lr
 ;------------------



;------------------
;:---kernel-------- Mp3 code hardware IRQ
;------------------
gba_irq_handler:       ;in: r0=4000000h=REGBASE_IO, r0-r3,r12=pushed (GBA)
maincpu_irq_handler:   ;in: r0=4000000h=REGBASE_IO, r0-r3,r12=pushed (NDS/DSi)
   ldr  r12,=global_fast_vars
     ldr  r2,[r0,REG_IE_IF]  ;IE,IF
     and  r2,r2,lsr 16       ;IE AND IF
   tst  r2,1 << 0                        ;\vblank (about 60Hz)
   bne  @@irq_vblank                      ;/
     tst  r2,1 << 4                      ;\timer1 (audio sample block)
     bne  @@irq_timer1                    ;/
     tst  r2,1 << 13                     ;\gamepak (cart eject)
     bne  org()   ;@@irq_gamepak              ; (hangup, to avoid sram data loss)
     .if org()>=8000000h;/(irq handler must be in RAM, not ROM)
     .error "errif failed"
     .endif
   b    org()                                 ;-unknown irq source
;---
@@irq_vblank:
 ldr  r1,[r12,frame_counter]                    ;\
 add  r1,1                                      ; raise frame counter
 str  r1,[r12,frame_counter]                    ;/
   ldr  r1,=cpu_stats_index                     ;\
   ldr  r2,[r1]                                 ;
   add  r2,1    ;raise                          ; cpu load raise index
   and  r2,cpu_stats_size-1                     ;
   str  r2,[r1]                                 ;/
   ldr  r1,=cpu_stats_list                      ;\
   add  r1,r2,lsl 2   ;list+index*4             ; cpu load clear val[index]
   mov  r2,0                                    ;
   str  r2,[r1]                                 ;/
   ;- - -
   ldr  r1,=mp3_context_0+mp3ctx_buf_stats_index;\
   ldr  r2,[r1]                                 ;
   add  r2,1    ;raise                          ; buf size raise index
   and  r2,mp3ctx_buf_stats_size-1              ;
   str  r2,[r1]                                 ;/
   ldr  r1,=mp3_context_0+mp3ctx_buf_stats_list ;\
   add  r1,r2,lsl 2   ;list+index*4             ;
   ldr  r2,[r12,snd_dma_wr_ptr]                 ; buf size apply val[index]
   ldr  r3,[r12,snd_dma_rd_ptr]                 ;
   subs r2,r3   ;wr-rd                          ;
   addmi r2,snd_dma_max_size                    ;
   bne  @@buf_this  ;rd<>wr (not full or empty) ;
   test_if_audio_dma_active    ;test empty/full ;   ;XXX goes wrong when paused
   movne r2,snd_dma_max_size  ;buffer full      ;
  @@buf_this:                                   ;
   str  r2,[r1]                                 ;/
   ldr  r2,[r0,REG_JOYPAD]         ;KEYIN       ;\
      ;XXX could do fast.key.irq --> only store STATE in vblank_key_array
   tst   r2,Xkey_up+Xkey_dn  ;\reject BOTH up+dn
   orreq r2,Xkey_up+Xkey_dn  ;/
   tst   r2,Xkey_lt+Xkey_rt  ;\reject BOTH lt+rt
   orreq r2,Xkey_lt+Xkey_rt  ;/
   ldr  r1,=Xkey_all
   eor  r2,r1     ;invert (make 1=pressed)
   ldr  r1,[r12,curr_key]   ;old key            ;-
   tst  r1,Xkey_sleep                           ;\on sleep-wakeup,
  ;beq  @@was_not_sleeping                      ; ignore keystrokes until key
   bicnes r3,r2,(Xkey_sleep+Xkey_close)         ; gets RELEASED (so the key
   bne    @@key_done  ;--> ignore key for now   ; won't trigger GUI actions)
  @@was_not_sleeping:                           ;/
   cmp  r1,r2                                   ;\
  ;beq  @@same_key                              ; check if same/diff key
   bne  @@diff_key                              ;/
  ;- - -
  @@same_key:
   cmp   r2,Xkey_none                   ;\no keyrepeat when NO key pressed
   beq   @@key_done  ;--> no key rept   ;/
   ldr   r1,[r12,keyrep_count]          ;\
   subs  r1,1                           ; decrease keyrep
   strne r1,[r12,keyrep_count]          ;
   bne   @@notyet_keyrep                ;/
   ldr   r3,[r12,key_rdptr]             ;\
   ldr   r1,[r12,key_wrptr]             ; perform keyrep only
   cmp   r3,r1                          ; if keyqueue empty
   bne   @@notyet_keyrep                ;/
   mov  r1,Xkeyrep_2nd                  ;\keyrep = short
   str  r1,[r12,keyrep_count]           ;/
   ldr  r1,[r12,keystep]                ;\
   add  r1,r1,lsr 3                     ; keystep + keystep/8+1
   add  r1,1                            ;
   str  r1,[r12,keystep]                ;/
   b    @@add_to_keyqueue   ;in: r2
  ;---
  @@diff_key:
   ldr   r3,[r12,key_rdptr]             ;\
   ldr   r1,[r12,key_wrptr]             ; accept key only
   sub   r1,r3                          ; if keyqueue nonfull
   cmp   r1,key_maskptr+1               ;
   beq   @@key_done                     ;/
   ldr  r1,[r12,curr_key]   ;old key    ;-
   str  r2,[r12,curr_key]               ;-apply
   tst  r2,Xkey_lt+Xkey_rt+Xkey_up+Xkey_dn   ;\ ;\
   beq  @@no_dpad_keys_pressed               ;  ;
   tst  r1,Xkey_lt+Xkey_rt+Xkey_up+Xkey_dn   ;  ; check if DPAD keys are/were
   beq  @@no_dpad_keys_pressed               ;  ; pressed, and no OTHER keys
   eor  r3,r2,r1   ;new xor old              ;  ; changed
   bics r3,Xkey_lt+Xkey_rt+Xkey_up+Xkey_dn   ;  ;
   bne  @@non_dpad_keys_changed              ;  ;/
   eor  r3,r2,r1   ;new xor old              ;  ;\
   and  r3,r2      ;new AND changed          ;  ; for multiple DPAD keys,
   and  r3,(Xkey_lt+Xkey_rt+Xkey_up+Xkey_dn) ;  ; process NEWLY PRESSED ones,
   bic  r2,(Xkey_lt+Xkey_rt+Xkey_up+Xkey_dn) ;  ; but don't trigger events
   orr  r2,r3                                ;  ; on NEWLY RELEASED ones
   tst  r2,Xkey_lt+Xkey_rt+Xkey_up+Xkey_dn   ;  ; (important for DPAD controlled
   beq  @@notyet_keyrep                      ;  ; on-screen keyboard)
   bne  @@newly_pressed_dpad_key             ;  ;/
  @@newly_pressed_dpad_key:                  ;
  @@non_dpad_keys_changed:                   ;
  @@no_dpad_keys_pressed:                    ;/
   mov  r1,Xkeyrep_1st                  ;\
   str  r1,[r12,keyrep_count]           ;/
   mov  r1,1                            ;\keystep = 1
   str  r1,[r12,keystep]                ;/
  ;b    @@add_to_keyqueue   ;in: r2
  ;- - -
  @@add_to_keyqueue:   ;in: r2
   ldr  r1,[r12,key_wrptr]              ;\
   and  r3,r1,key_maskptr               ;
   add  r3,r12,r3,lsl 2                 ; store in keyboard queue
   str  r2,[r3,key_queue]               ;
   add  r1,1                            ;
   str  r1,[r12,key_wrptr]              ;/
  @@notyet_keyrep:
  @@key_done:
   mov  r2,1 << 0                                ;\ack vblank
   strb r2,[r0,REG_IF]                    ;IF     ;/
 bx   lr
;---
  @@irq_timer1:
   ldr  r1,[r12,snd_dma_rd_ptr]                   ;\
   ldr  r2,[r12,snd_dma_blk_siz]                  ;
   add  r1,r2                         ;next       ;
   ldr  r2,[r12,snd_dma_max_ptr]                  ;
   cmp  r1,r2                         ;check max  ;
   ldrhs r1,=sample_buffer            ;wrap src   ;
   str  r1,[r12,snd_dma_rd_ptr]                   ;/

   ldr   r2,[r0,REG_DMA2_CNT]         ;dma2.ctl   ;\check mono/stereo
   cmp   r2,0                         ;zf         ;/

   str   r1,[r0,REG_DMA1_SAD]         ;dma1.sad   ;\
   addne r2,r1,sample_dst_ch1_disp                ;
   strne r2,[r0,REG_DMA2_SAD]         ;dma2.sad   ;/

   mov   r2,0                                                        ;\
   str   r2,[r0,REG_DMA1_CNT]         ;dma1.ctl (stop)               ;
   strne r2,[r0,REG_DMA2_CNT]         ;dma2.ctl (stop)               ;
   ldr   r2,=0b640h << 16 ;start, sound, 32bit, repeat, dst=fixed   ; stop/start dma (needed to apply new src addr)
   str   r2,[r0,REG_DMA1_CNT]         ;dma1.ctl (start)              ;
   strne r2,[r0,REG_DMA2_CNT]         ;dma2.ctl (start)              ;/

   ldr  r2,[r12,snd_dma_wr_ptr]                   ;\on underrun,
   cmp  r1,r2                                     ; stop timer0 (sample rate)
  ;mov  r0,REGBASE_IO   ;lsb=00h                  ; (on GBA, that will also automatically freeze the audio DMA)
   streqb r0,[r0,REG_TIMER0CNT+2]   ;timer0.ctl=0 ;/
   mov  r2,1 << 4                                ;\ack timer1
   strb r2,[r0,REG_IF]                    ;IF     ;/
   bx   lr
;---
;------------------
;:---kernel-------- Mp3 code hardware 2d gui
;------------------
;------------------
draw_char_1bpp_8pix_dbl_height_if_diff:
 ldrb r2,[r10],1        ;old
 cmp  r2,r3             ;old,new
 addeq r6,8     ;x+8
 bxeq  lr       ;ret
 strb r3,[r10,-1]       ;new
;- - - - - --------
draw_char_1bpp_8pix_dbl_height:
 push lr
 mov  r3,r3,lsl 1  ;char*2
 push r3
 bl   draw_char_1bpp_8pix
 pop  r3
 add  r3,1      ;char*2+1
 sub  r6,8      ;x-8
 add  r5,8      ;y+8            ;XXX FONT_YSIZ
 bl   draw_char_1bpp_8pix
 sub  r5,8      ;y-8            ;XXX FONT_YSIZ
 pop  pc
;------------------
get_char_width_and_src:  ;in: r3=char - out: r0=width, r3=src
 ldr  r2,=charset_gap_list              ;\
 mov  r0,r3     ;tile                   ;
@@gap_lop:                              ;
 ldrh r1,[r2],2 ;first                  ; resolve CHARSET_GAP's
 sub  r0,r1             ;-tile-first    ;
 cmp  r3,r1             ;\              ;
 blo  @@undef           ; char range    ;
 ldrh r1,[r2],2 ;last+1 ;               ;
 cmp  r3,r1             ;               ;
 blo  @@this            ;/              ;
 add  r0,r1     ;tile+last+1            ;
 b    @@gap_lop                         ;
@@undef:                                ;
 mov  r0,7fh-20h  ;tile                 ;
@@this:                                 ;/
;- - -
 ldr  r1,=prop_charset                  ;\src=base+chr*8
 add  r3,r1,r0,lsl 3                    ;/      ;XXX FONT_YSIZ
 ldmia [r3],r0,r1                       ;\
 orr  r0,r1                             ;
 orr  r0,r0,r0,lsr 16                   ;
 orr  r0,r0,r0,lsr 8                    ; calc proportional width
 mov  r1,r0,lsl 24                      ;
 mov  r0,1                              ;
@@calc_width_lop:                       ;
 add  r0,1                              ;
 movs r1,r1,lsl 1                       ;
 bne  @@calc_width_lop                  ;/
 bx   lr
;------------------
draw_char_1bpp_8pix:       ;in: r3=chr, r5=dst.yloc, r6=x1, r7=x2
 push r8,r9,r10,r11,lr
 ldr  r1,=large_digit_charset           ;\src=base+chr*8
 add  r3,r1,r3,lsl 3                    ;/
               ;XXX FONT_YSIZ
 mov  r0,8                              ;-force fixed width
 b    draw_char_1bpp_inj
;--- --- --- ------
draw_char_1bpp_to_4bpp:       ;in: r3=chr, r5=dst.yloc, r6=x1, r7=x2
 push r8,r9,r10,r11,lr
 bl   get_char_width_and_src  ;r0=width, r3=src
;- - - - - - - ----
draw_char_1bpp_inj:
 subs r10,r7,r6     ;max=x2-x1          ;\
 ble  @@done                            ; limit width to x2
 cmp  r10,r0                            ;
 movhi r10,r0                           ;/
   mov  r0,r6,lsr 3   ;x=x1/8             ;\
   mov  r1,r5,lsr 3   ;y=y1/8             ;
   orr  r0,r1,lsl bgs ;x+y*bgw            ; get [bgmap]
   ldr  r1,=mp3_vram_display_bgmap        ;
   add  r0,r1,r0,lsl 1 ;base+index*2      ;
   ldrh r0,[r0]        ;[bgmap]           ;/
   mov  r2,r0,lsr 12                      ;\get palette 0..3
   and  r2,03h         ;pp=pal AND 03h    ;/
   and  r1,r6,07h      ;xx=x1 AND 07h     ;\
   add  r2,r1,lsl 2    ;pp=pp+xx*4        ; get pixelmask
   mov  r11,1                             ; for palette/xloc
   mov  r11,r11,lsl r2     ;mm=1 shl pp       ;/
   bic  r0,0fc00h      ;tile (and 3FFh)   ;\
   ldr  r2,=mp3_vram_display_base         ; get vram addr of tile
   add  r2,r0,lsl 5    ;vv=base+tile*32   ;/
   add  r6,r10                            ;-raise x1,width
  ;- - -
  @@ylop:
   ldr  r9,[r2]        ;old=[vram]
   ldrb r0,[r3],1      ;new=[src]
   mov  r0,r0,lsl 24
   mov  r8,r10         ;width
   mov  r1,r11         ;pixelmask
  @@xlop:                                                 ;\
   movs r0,r0,lsl 1          ;\                              ;
   biccc r9,r1            ; set/clear pix                 ;
   orrcs r9,r1            ;/                              ; xlop
   mov  r1,r1,ror 32-4       ;\                              ;
   tst  r1,0fh            ; next pixelmask                ;
   bne  @@wrap_x          ;/                              ;
  ;movne r1,lsl 1         ;/                              ;
   subs r8,1              ;width-1        ;\next x        ;
   bne  @@xlop                            ;/              ;/
  @@finish_x:
   str  r9,[r2],4         ;[vram]=new     ;-store to vram
   b    @@next_y
  ;---
  @@wrap_x:
   subs r8,1              ;width-1        ;\don't wrap if this was last pixel
   beq  @@finish_x                        ;/
   mov  r1,r1,lsl 1          ;next palette   ;\
   tst  r1,10h                            ; next palette
   beq  @@xlop                            ;/
  ;- - -
   mov  r1,r1,lsr 4
   str  r9,[r2],20h       ;[vram]=new     ;-store to vram
   ldr  r9,[r2]           ;old=[vram+20h] ;-get/wrap to next tile from vram
  @@xlop2:                                                ;\
   movs r0,r0,lsl 1          ;\                              ;
   biccc r9,r1            ; set/clear pix                 ;
   orrcs r9,r1            ;/                              ; xlop'2
   mov  r1,r1,ror 32-4       ;\                              ;
   tst  r1,0fh            ; next pixelmask                ;
   movne r1,r1,lsl 1         ;/                              ;
   subs r8,1              ;width-1        ;\next x        ;
   bne  @@xlop2                           ;/              ;/
   str  r9,[r2],4-20h     ;[vram+20h]=new
  ;- - -
  @@next_y:
   tst  r2,1fh    ;vram                   ;\next y
   bne  @@ylop                            ;/
@@done:
 pop  r8,r9,r10,r11,pc
;------------------
fill_rect_1bpp_to_4bpp:       ;in: r3=color, r4=y1, r5=y2, r6=x1, r7=x2
  @@vertical_part_lop:                    ;\
   add  r1,r4,8                           ;
   bic  r1,7                              ; for large heights,
   cmp  r5,r1                             ; split to several 8pix lines
   bls  @@draw_vertical_part  ;last part  ;
   push r3-r7,lr                          ;
   mov  r5,r1                             ;
   bl   @@draw_vertical_part  ;snippet    ;
   pop  r3-r7,lr                          ;
   add  r4,8                              ;
   bic  r4,7                              ;
   b    @@vertical_part_lop   ;next       ;
  @@draw_vertical_part:                   ;/
  ;- - -
   push r8,r9,r11,lr
   subs r8,r7,r6      ;max=x2-x1          ;\width
   ble  @@done                            ;/
   cmp  r5,r4                             ;\height
   ble  @@done                            ;/
   mov  r0,r6,lsr 3   ;x=x1/8             ;\
   mov  r1,r4,lsr 3   ;y=y1/8             ;
   orr  r0,r1,lsl bgs ;x+y*bgw            ; get [bgmap]
   ldr  r1,=mp3_vram_display_bgmap        ;
   add  r0,r1,r0,lsl 1 ;base+index*2      ;
   ldrh r0,[r0]        ;[bgmap]           ;/
   mov  r2,r0,lsr 12                      ;\get palette 0..3
   and  r2,03h         ;pp=pal AND 03h    ;/
   and  r1,r6,07h      ;xx=x1 AND 07h     ;\
   add  r2,r1,lsl 2    ;pp=pp+xx*4        ; get pixelmask
   mov  r1,1           ;pixelmask         ; for palette/xloc
   mov  r1,r1,lsl r2      ;mm=1 shl pp       ;/
   bic  r0,0fc00h      ;tile (and 3FFh)   ;\
   ldr  r2,=mp3_vram_display_base         ; get vram addr of tile
   add  r2,r0,lsl 5    ;vv=base+tile*32   ;
   and  r0,r4,07h      ;yy=y1 and 7       ;
   add  r2,r0,lsl 2    ;vram + yy*4       ;/
   add  r6,r8                             ;-raise x1,width
  ;- - -
   cmp  r1,1                              ;\draw left part (when pixelmask<>1)
   blne @@draw_part                       ;/
   bl   @@draw_body                       ;-draw middle part (full tiles)
   mov  r1,1           ;pixelmask         ;\
   cmp  r8,0           ;width             ; draw right part (when width<>0)
   blne @@draw_part                       ;/
  @@done:
   pop  r8,r9,r11,pc
  ;--- --- ---
  @@draw_part:
  ;mov  r8,r8          ;width
  ;mov  r1,r1          ;pixelmask
   mov  r9,0           ;pixels
  @@part_xlop:                                            ;\
   orr  r9,r1             ;-set pix                       ;
   mov  r1,r1,ror 32-4       ;\                              ; xlop (precalc mask)
   tst  r1,0fh            ; next pixelmask                ;
   bne  @@part_wrap_x     ;/                              ;  XXX could speedup, without using a loop
   subs r8,1              ;width-1        ;\next x        ;      maybe best lookup table (or two table lookup's ANDed together, for x1,x2)
   bne  @@part_xlop                       ;/              ;/
  @@part_finish_x:
  ;- - -
   sub  r11,r5,r4      ;height = y2-y1                    ;\
   mov  r1,r2          ;vram                              ;
  @@part_ylop:                                            ;
   ldr  r0,[r1]        ;old=[vram]                        ; ylop (draw/modify)
   cmp  r3,0                                              ;
   biceq r0,r9                                            ;
   orrne r0,r9                                            ;
   str  r0,[r1],4      ;[vram]=new        ;-store to vram ;
   subs r11,1          ;height            ;\next y        ;
   bne  @@part_ylop                       ;/              ;/
   add  r2,20h         ;vram+20h
   bx   lr
  ;---
  @@part_wrap_x:
   subs r8,1              ;width-1        ;\don't wrap if this was last pixel
   beq  @@part_finish_x                   ;/
   mov  r1,r1,lsl 1          ;next palette   ;\
   tst  r1,10h                            ; next palette
   beq  @@part_xlop                       ;/
   b    @@part_finish_x
  ;--- --- ---
  @@draw_body:
  ;mov  r8,r8          ;width
   rsb  r9,r3,0        ;color 0/1 --> 0/FFFFFFFFh
  @@body_xlop:                                                    ;\
   cmp  r8,20h         ;width                                     ;
   bxlo lr                ;--> done                               ; xlop
  ;- - -                                                          ;
   subs r11,r5,r4      ;height = y2-y1                    ;\      ;
   mov  r1,r2          ;vram                              ;       ;
  @@body_ylop:                                            ;       ;
   str  r9,[r1],4      ;[vram]=new        ;-store to vram ; ylop  ;
   subs r11,1          ;height            ;\next y        ;       ;
   bne  @@body_ylop                       ;/              ;/      ;
   add  r2,20h         ;vram+20h                                  ;
   sub  r8,20h         ;width                                     ;
   b    @@body_xlop                                               ;/
;------------------
;------------------
;:---kernel-------- Mp3 code bitstream get bitstream/huffman
;------------------
.macro mp3mac_push_bitstream
 push r0,r1,r2  ;save bitstream registers
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
.macro mp3mac_pop_bitstream
 pop  r0,r1,r2  ;restore bitstream registers
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
.align code_align
mp3_recollect_bits:
 tst  r1,1              ;\when r1=odd --> align by fetching one leading extra byte (then fetch 16bit units)
 bne  @@odd             ;/
 ;- - -
 ldrh r0,[r1],2      ;0000bbaa
 mov  r0,r0,ror 8    ;aa0000bb
 orr  r0,r0,lsl 16   ;aabb00bb
 bic  r0,0ffh        ;aabb0000
 mov  r2,0
 bx   lr
;---
@@odd:
 ldrb r3,[r1],1      ;000000nn
 ldrh r0,[r1],2      ;0000bbaa
 mov  r0,r0,ror 8    ;aa0000bb
 orr  r0,r0,lsl 16   ;aabb00bb
 mov  r0,r0,lsr 8    ;00aabb00
 orr  r0,r3,lsl 24   ;nnaabb00
 mov  r2,0+8
 bx   lr
;------------------
.macro mp3mac_bitstream_set_position   ;in: r5
 ldr  r1,[r11,mp3ctx_bitstream_start]
 add  r1,r5,lsr 3  ;base+n/8
 bl   mp3_recollect_bits
 and  r5,07h       ;remainder
 mp3mac_skip_r5_bits            ;skip/discard leading bits (when odd start)
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
.macro mp3mac_get_n_bits, n   
 mov  r4,r0,lsr (32-n)        ;get data
 mov  r0,r0,lsl n             ;shiftout bits
 subs r2,n                    ;numbits
 blmi mp3_collect_more
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
.macro mp3mac_get_r5_bits
 rsb  r3,r5,32      ;(32-r5)
 mov  r4,r0,lsr r3  ;(32-r5)    ;get data
 mov  r0,r0,lsl r5  ;(r5)       ;shiftout bits
 subs r2,r5                     ;numbits
 blmi mp3_collect_more
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
.macro mp3mac_skip_n_bits, n  
 mov  r0,r0,lsl n     ;\discard num bits
 subs r2,n            ;/
 blmi mp3_collect_more
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
.macro mp3mac_skip_r5_bits
 mov  r0,r0,lsl r5      ;\discard num bits
 subs r2,r5             ;/
 blmi mp3_collect_more
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
.macro mp3mac_get_bit_to_cy
 sub  r2,1
 movs r0,r0,lsl 1       ;cy=data
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
.macro mp3mac_bitstream_get_position   ;out: r4=position
 ;this is some unfortunate/slow requirement for the huffman decoder
 ;  (might be faster when storing the bitstream position in memory?)
 ;  (or in a spare cpu register, when having more cpu registers).
 ;however, COARSE_END can avoid needing the exact get_position in most cases
 ldr  r4,[r11,mp3ctx_bitstream_start]
 sub  r4,r1,r4          ;addr-start
 mov  r4,r4,lsl 3       ;mul8
 sub  r4,r2             ;sub collected
 sub  r4,16             ;sub 16
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
.macro mp3mac_collect_more
 ldrh r3,[r1],2      ;0000bbaa
 mov  r3,r3,ror 8    ;aa0000bb
 orr  r3,r3,lsl 16   ;aabb00bb
 mov  r3,r3,lsr 16   ;0000aabb
 orr  r0,r3,ror r2
 add  r2,16          ;num collected
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;---
.align code_align
mp3_collect_more:
 mp3mac_collect_more
 bx   lr
;------------------
;------------------
.macro mp3mac_get_huffcode
   ldr  r3,=huff_tree_buf
     add  r4,r4            ;<-- unfortunately "ldrh" can't use "r4,lsl 1"
     ldrsh r4,[r3,r4]
     mov  r5,r4,asr 12  ;isolate bits   ;(table size) (-7..-1)
     xor  r4,r5,lsl 12  ;isolate data   ;(child table)
    @@get_child_lop:
     add  r5,32            ;-required on ARM
     add  r4,r0,lsr r5     ;-add value peeked from bitstream
     add  r4,r4            ;<-- unfortunately "ldrh" can't use "r4,lsl 1"
     ldrsh r4,[r3,r4]
     movs r5,r4,asr 12  ;isolate bits    ;sf
     xor  r4,r5,lsl 12  ;isolate data
   bmi  @@got_child                      ;sf
  ;- - -
  ;@@got_data:
   mov  r0,r0,lsl r5    ;\discard r5 bits
   subs r2,r5           ;/
   bpl  @@got_done
     mp3mac_collect_more
   b    @@got_done
  ;---
  @@got_child:
   mov  r0,r0,lsl CHILD_BITS  ;\discard 7 bits (assuming that parents are always 7bit wide)
   subs r2,CHILD_BITS      ;/
   bpl  @@get_child_lop
     mp3mac_collect_more
   ldr  r3,=huff_tree_buf       ;restore r3 after collect
   b    @@get_child_lop
  ;---
  @@got_done:
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
.align code_align
mp3_uncollect_bits:
 sub  r1,2              ;sub 2
 sub  r1,r1,r2,asr 3    ;sub (numbits/8)     ;can be -1 when QUICK_SIGN (!)
 bx   lr
;------------------
;:---kernel-------- Mp3 code decode frame
;------------------
bx_r3:
 bx   r3
;------------------
.align code_align
mp3_decode_mpeg_audio_frame: ;in: r6=dst, [mp3ctx_stream_pos]=src
 push lr

 str  r6,[r11,mp3ctx_samples_dst]       ;dst (or 0=none, examine hdr only)
 ldr  r1,[r11,mp3ctx_stream_pos]        ;src
;- - -
 timelog_start rdtsc_total
;- - -
 bl   mp3_search_get_header     ;in: r1=src     ;\header
 bne  @@error                                   ;/
 ldr  r4,[r11,mp3ctx_src_frame_size]            ;\
 cmp  r4,0                                      ;
 ble  @@error   ;oops                           ; check buf size
 ldr  r2,[r11,mp3ctx_stream_pos]          ;src  ;
 ldr  r3,[r11,mp3ctx_stream_end]          ;end  ;
 add  r2,r4   ;pos+framesize                    ;
 cmp  r2,r3   ;pos, end                         ;
 bhi  @@error   ;exceeds EOF                    ;/
;- - -
   ldr  r4,[r11,mp3ctx_layer]
   cmp  r4,fmt_mp3
   beq  @@layer_3
  ;- - -
  @@layer_1_or_2:
   ldr  r4,[r11,mp3ctx_samples_dst]               ;\
   cmp  r4,0                                      ;
   beq  @@skip_decoding                           ;/
  ;- - -
   str  r1,[r11,mp3ctx_bitstream_start]           ;\
   mov  r5,32     ;origin (after 32bit header)    ; start bitstream
   mp3mac_bitstream_set_position                  ;/
  ;- - -
   timelog_start rdtsc_read_header_extra;\
   bl   mp2_xlat_header                           ;
   bl   mp2_read_allocation_information           ;
   bl   mp2_read_scale_factor_selector_information;
   timelog_end rdtsc_read_header_extra;/
   timelog_start rdtsc_read_scalefac;\
   bl   mp2_read_scale_factors                    ;
   timelog_end rdtsc_read_scalefac;/
  ;- - - decode data body...
     bl   mp1_mp2_cut_count_blk_size
        ldr  r4,[r11,mp3ctx_samples_dst]
        push r4
   mov  r3,0                                    ;\
   str  r3,[r11,mp2ctx_part_count]              ; loop 3 parts...
  @@part_lop:                                   ;/
   mov  r3,4                                    ;\
   str  r3,[r11,mp2ctx_granule_count]           ; loop 4 granules...
  @@granule_lop:                                ;/
   timelog_start rdtsc_read_samples;\      ;\
   ldr  r3,[r11,mp2ctx_read_src_samples_proc]   ; src   ;
   bl   bx_r3                                   ;       ;
   timelog_end rdtsc_read_samples;/      ; 1-3 blocks
   ldr  r3,[r11,mp3ctx_synth_filter_proc]       ; dst   ; N channels
   bl   bx_r3                                   ;       ;
   ldr  r3,[r11,mp2ctx_samples_output_step]     ; ;\    ;
   ldr  r4,[r11,mp3ctx_samples_dst]             ; ;     ;
   add  r4,r3                                   ; ;     ;
   str  r4,[r11,mp3ctx_samples_dst]             ; ;/    ;
     ldr  r5,[r11,mp2ctx_cut_blk_ptr]           ; ;\    ;
     ldr  r3,[r11,mp2ctx_cut_blk_size]          ; ;     ;
     add  r5,r3                                 ; ;     ;
     str  r5,[r11,mp2ctx_cut_blk_ptr]           ; ;     ;
     mp3mac_bitstream_set_position              ; ;/    ;
   ldr  r4,[r11,mp2ctx_granule_count]        ;\
   subs r4,1                                 ; next granule (4 granules)
   str  r4,[r11,mp2ctx_granule_count]        ;
   bne  @@granule_lop                        ;/
   ldr  r4,[r11,mp2ctx_part_count]           ;\
   add  r4,32*8                              ;
   str  r4,[r11,mp2ctx_part_count]           ; next part (3 parts)
   cmp  r4,32*8*3                            ;
   blo  @@part_lop                           ;/
        pop  r4
        str  r4,[r11,mp3ctx_samples_dst]


   b    @@layer_done
  ;---
  @@layer_3:
;- - -
 str  r1,[r11,mp3ctx_bitstream_start]           ;\
 mov  r5,32     ;origin (after 32bit header)    ; start bitstream
 mp3mac_bitstream_set_position                  ;/
 bl   mp3_bitstream_read_header_extra           ;-
;- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 bl   mp3_bitstream_read_granules                       ;\
 bne  @@error                                           ;/
 bl   mp3_uncollect_bits   ;out: r1
 str  r1,[r11,mp3ctx_src_data_location]   ;<-- possible location of Xing etc.
 ldr  r4,[r11,mp3ctx_samples_dst]               ;\when dst=0, return only header
 cmp  r4,0                                      ; info, without decoding data
 beq  @@skip_decoding                           ;/
;- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 bl   mp3_bitstream_append_to_main_data_pool            ;-now main data ...
   ldr  r4,[r11,mp3ctx_lead_silence_check_flag]         ; after append to pool
   cmp  r4,0                                            ; (for mp3 frames that
   bne  @@leading_silence_stage_1_check                 ; lookback prev frames)
  @@leading_silence_stage_1_back:                       ;
 ldr  r4,[r11,mp3ctx_samples_output_size]       ;\skip if missing_main_data
 cmp  r4,0                                      ;  (eg. l3-sin1k0db.bit)
 beq  @@skip_decoding                           ;/
;- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
 mov  r3,0                                      ;\
 str  r3,[r11,mp3ctx_curr_granule]              ;
 ldr  r10,=mp3_granules                         ; loop granules
@@body_granule_lop:                             ;
 str  r10,[r11,mp3ctx_granule_addr]             ;/
 mov  r3,0                                      ;\                      ;\
 str  r3,[r11,mp3ctx_curr_channel]              ; loop channels         ;
@@body_channel_lop:                             ;/                      ;
        ;XXX should skip below when mp3gr_part2_3_length = 0 (and then somehow replace all output by zeroes?)
        ;cmp  [r10,mp3gr_part2_3_length],0
        ;beq  @@body_channel_next
 ldr  r5,[r10,mp3gr_part2_3_start]              ;\                      ; read
 mp3mac_bitstream_set_position                  ;/                      ;
 bl   mp3_bitstream_read_scalefacs      ;-->    ;-read scale factors    ;
 bl   mp3_get_exponents_from_scale_factors ;in: r10     ;-exponents     ;
 ;below reads up to mp3gr_part2_3_end           ;\                      ;
 bl   mp3_huffman_decode  ;in: r10      ;-->    ; read huffman coded residue
 bne  @@error                                   ;/                      ;
;- - -                                                                  ;
        @@body_channel_next:
 add  r10,mp3gr_entrysiz*2                      ;\                      ;
 ldr  r4,[r11,mp3ctx_curr_channel]              ;                       ;
 ldr  r5,[r11,mp3ctx_decode_num_channels]       ; next channel          ;
 add  r4,1                                      ; (decoder)             ;
 str  r4,[r11,mp3ctx_curr_channel]              ;                       ;
 cmp  r4,r5                                     ;                       ;
 blo  @@body_channel_lop                        ;/                      ;/
;- - -
 ldr  r10,[r11,mp3ctx_granule_addr]
 mp3mac_push_bitstream                                                  ;\
 bl   mp3_compute_stereo    ;in: r10    ;-->    ;-stereo (if any)       ;
 bl   mp3_compute_mono      ;in: r10    ;-->    ;-mono (if needed(      ;
 mov  r3,0                                      ;\                      ;
 str  r3,[r11,mp3ctx_curr_channel]              ; loop channels         ; maths
@@cast_channel_lop:                             ;/                      ;
   ldr  r4,[r11,mp3ctx_lead_silence_check_flag] ;                       ;
   cmp  r4,0                                    ; lead silence          ;
   bne  @@leading_silence_stage_2_check         ;                       ;
 bl   mp3_reorder_block     ;in: r10    ;-->    ;-reorder               ;
 bl   mp3_compute_antialias ;in: r10    ;-->    ;-antialias             ;
 bl   mp3_compute_imdct     ;in: r10    ;-->    ;-imdct                 ;
@@leading_silence_stage_2_back:                                         ;
 add  r10,mp3gr_entrysiz*2                      ;\                      ;
 ldr  r4,[r11,mp3ctx_curr_channel]              ;                       ;
 ldr  r5,[r11,mp3ctx_output_num_channels]       ; next channel          ;
 add  r4,1                                      ; (output)              ;
 str  r4,[r11,mp3ctx_curr_channel]              ;                       ;
 cmp  r4,r5                                     ;                       ;
 blo  @@cast_channel_lop                        ;/                      ;
 mp3mac_pop_bitstream                                                   ;/
;- - -
 ldr  r10,[r11,mp3ctx_granule_addr]             ;\
 add  r10,mp3gr_entrysiz                        ;
 ldr  r4,[r11,mp3ctx_curr_granule]      ;\      ; next granule
 ldr  r5,[r11,mp3ctx_nb_granules]       ;       ;
 add  r4,1                              ;       ;
 str  r4,[r11,mp3ctx_curr_granule]      ;       ;
 cmp  r4,r5                             ;/      ;
 blo  @@body_granule_lop                        ;/
;- - -
 bl   mp3_uncollect_bits   ;out: r1     ;-->    ;\
 ldr  r3,[r11,mp3ctx_main_data_pool_wr_ptr]     ; check that esi didn't exceed [mp3ctx_main_data_pool_wr_ptr]
 cmp  r1,r3                                     ;
 bhi  @@error                                   ;/
;- - -
   ldr  r4,[r11,mp3ctx_lead_silence_check_flag] ;
   cmp  r4,0                                    ; lead silence result
   bne  @@leading_silence_stage_3_check         ;
 ldr  r3,[r11,mp3ctx_synth_filter_proc]         ;\synth maths           ;-output
 bl   bx_r3                                     ;/
;- - -
@@skip_decoding:
@@skip_leading_silence:
@@layer_done:
;- - -
 ldr  r4,[r11,mp3ctx_src_frame_size]         ;\
 ldr  r3,[r11,mp3ctx_stream_pos]             ; okay, raise stream_pos
 add  r3,r4                                  ;
 str  r3,[r11,mp3ctx_stream_pos]             ;/
 ldr  r5,[r11,mp3ctx_samples_output_size] ;\ ;\
 ldr  r4,[r11,mp3ctx_total_output_size]   ;  ;
 add  r4,r5                               ;  ; for timelog/stats
 str  r4,[r11,mp3ctx_total_output_size]   ;/ ;
 ldr  r4,[r11,mp3ctx_num_frames_decoded]  ;\ ;
 add  r4,1                                ;  ;
 str  r4,[r11,mp3ctx_num_frames_decoded]  ;/ ;/
;- - -
 ;out: [r11,mp3ctx_output_num_channels]  ;num channels (1 or 2)
 ;out: [r11,mp3ctx_src_num_channels]     ;num channels (1 or 2)
 ;out: [r11,mp3ctx_src_frame_size]       ;compressed size (in bytes)
 ;out: [r11,mp3ctx_samples_output_size]  ;decompressed size (in bytes)
 ;out: [r11,mp3ctx_src_sample_rate]      ;sample rate (8000..48000 Hz)
;- - -
 timelog_end rdtsc_total
 movs r4,0    ;okay
 pop  pc
;---
@@found_non_silence:
   ;rewind pool (so that data can be appended AGAIN to same location)
   ;(because the silence check adds data pool, but the first non-silent frame
   ;will be decoded AGAIN upon playback (and so would add the same again))
   ;---
   ldr  r5,[r11,mp3ctx_lead_silence_new_data]   ;\restore memorized ptr
   str  r5,[r11,mp3ctx_main_data_pool_wr_ptr]   ;/(discard new data)
;- - -
@@error:
 timelog_end rdtsc_total
 movs r4,1    ;bad
 pop  pc
;--- --- ---
  @@leading_silence_stage_1_check:   ;check for EMPTY fully-silent frames
   ;---
   ;checking "mp3ctx_main_data_size" does work fine for many songs,
   ;in particular such that have leading silence with EMPTY frames.
   ;in my mp3 collection, such working recordings are:
   ;  4 sec    Crossover - Apples on a Stick
   ;  8 sec    Velvet Underground - Venus in Furs
   ;it does NOT work with NON-EMPTY frames (eg. analog recordings that
   ;have near-silent frames with barely audible noise).
   ;in my mp3 collection, such problematic recordings are:
   ;  4.5 sec  New Days Delay - Stereokatastrophe
   ;  4.5 sec  Torpedo Mahlsdorf - Tim Reefke
   ;other than that, PERFECT recordings simply don't have leading silence
   ;---
   ldr  r4,[r11,mp3ctx_main_data_size]          ;\
   cmp  r4,0                                    ; when EMPTY, treat as silent
   beq  @@skip_leading_silence                  ;/
   ;- - -
   mov  r4,0                                    ;\initially silent (initial value for near-silent hybrids checks)
   str  r4,[r12,mp3_leading_nonsilent_flag]     ;/
   ldrb r4,[r12,option_lead]                    ;\when also checking for
   cmp  r4,0     ;0=Also skip NEAR-silent       ; NEAR-silent --> go back,
   beq  @@leading_silence_stage_1_back          ;/to do more checks
   b    @@found_non_silence                     ;-otherwise, treat as non-silent
  ;--- --- ---
  @@leading_silence_stage_2_check:   ;check for NEAR-silent frames
     ldr  r9,[r10,mp3gr_num_nonzero_hybrids]    ;
     cmp  r9,0     ;bugfix arm v1.4             ;
     beq  @@check_hybrids_none                  ;
     ldr  r4,[r10,mp3gr_sb_hybrid_base]         ;
     mov  r2,const_lead_silence_limit           ;   (based of LEAD_SHR)
   mov  r3,r2,lsl 1   ;N*2                      ;-limit*2
  @@check_hybrids_lop:       ;for i=0 to 576-1  ;\
   ldmia [r4],r1                                ;
  @@limit equ 1000h                             ;   ;<-- XXX whatever ... should be matched to VFRAC_BITS or so?
   add  r1,r2  ;N     ;change -N..+N to 0..+N*2 ;   ;note: NEGATIVE values exist in "Torpedo Mahlsdorf - Tim Reefke" (whilst "New Days Delay - Stereokatastrophe" seems to be POSITIVE only)
   cmp  r1,r3  ;N*2   ;check N*2                ;
   bhs  @@check_hybrids_abort                   ;
   subs r9,1                                    ;
   bhi  @@check_hybrids_lop                     ;/
  @@check_hybrids_none:
   b    @@leading_silence_stage_2_back
  ;---
  @@check_hybrids_abort:
   mov  r4,1                                    ;\mark as nonsilent
   str  r4,[r12,mp3_leading_nonsilent_flag]     ;/(to be handled later)
   b    @@leading_silence_stage_2_back
  ;--- --- ---
  @@leading_silence_stage_3_check:   ;check RESULT from stage_2
   ldr  r4,[r12,mp3_leading_nonsilent_flag]     ;\
   cmp  r4,0                                    ; check nonsilent flag,
   beq  @@skip_leading_silence                  ; and handle it
   b    @@found_non_silence                     ;/
;------------------
.pool
;------------------
;:---kernel-------- Mp3 code extras upsampling
;------------------
;------------------
;upsample low sample rates to higher sample rate,
;this is required because win98 does simply "ignore" rates below 8kHz,
;(it DOES play the song at correct duration, but it does only output SILENCE),
;additionally, SMOOTH upsampling is required to avoid high-pitch artifacts
;------------------
;------------------     ;(but hardware that is capable of 16bit output usually shouldn't require with_upsample anyways)
.align code_align
upsample_none:
 bx   lr
;------------------
upsample_stereo_hook:
 ;hook for STEREO, this may be a bit slow, but that shouldn't matter
 ;because upsampling of low-frequency output is usually only needed on
 ;slow CPUs (and on slow CPUs, one would tend to use MONO anyways), anyways,
 ;even if it isn't too useful, this hook does support STEREO upsampling...
 ;---
 push r9,lr   ;<-- pushing r9 is required for next stereo channels (and specially for some functions like "linear_2x" which don't push it themselves)
 ldr  r3,[r11,mp3ctx_samples_output_size]  ;\
 mov  r3,r3,lsr 1                             ; size per channel (can be safely modified, the IRQ handler has i's own blk size)
 str  r3,[r11,mp3ctx_samples_output_size]  ;/
 ldr  r3,[r11,mp3ctx_upsample_core]        ;\core
 bl   bx_r3                                ;/
 ldr  r1,[r11,mp3ctx_upsample_recent]      ;\
 ldr  r2,[r11,mp3ctx_upsample_recent2]     ; swap
 str  r1,[r11,mp3ctx_upsample_recent2]     ;
 str  r2,[r11,mp3ctx_upsample_recent]      ;/
 ldr  r3,[r11,mp3ctx_samples_output_size]  ;\
 mov  r3,r3,lsl 1                             ; restore total size
 str  r3,[r11,mp3ctx_samples_output_size]  ;/
 pop  r9,pc
;------------------
.macro mp3mac_upsample_1_point_repeat_2x
 timelog_start rdtsc_upsampler
 ldr  r8,[r11,mp3ctx_samples_output_size]  ;siz
 ldr  r7,=mp3_upsample_buf                 ;src
 mov  r6,r9                                ;dst
@@lop:
;SHIM-UNROLLED .rept 4 = 4
   ldrb r1,[r7],1      ;xx
   orr  r1,r1,lsl 8    ;xxxx
   strh r1,[r6],2
   ldrb r1,[r7],1      ;xx
   orr  r1,r1,lsl 8    ;xxxx
   strh r1,[r6],2
   ldrb r1,[r7],1      ;xx
   orr  r1,r1,lsl 8    ;xxxx
   strh r1,[r6],2
   ldrb r1,[r7],1      ;xx
   orr  r1,r1,lsl 8    ;xxxx
   strh r1,[r6],2
 subs r8,4*2
 bhi  @@lop
;blo  $        ;oops
 timelog_end rdtsc_upsampler
 bx   lr
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
.macro mp3mac_upsample_1_point_repeat_3x
 timelog_start rdtsc_upsampler
 ldr  r8,[r11,mp3ctx_samples_output_size]  ;siz
 ldr  r7,=mp3_upsample_buf                 ;src
 mov  r6,r9                                ;dst
@@lop:
;SHIM-UNROLLED .rept 4 = 4
   ldrb r1,[r7],1      ;xx
   strb r1,[r6],1
   strb r1,[r6],1
   strb r1,[r6],1
   ldrb r1,[r7],1      ;xx
   strb r1,[r6],1
   strb r1,[r6],1
   strb r1,[r6],1
   ldrb r1,[r7],1      ;xx
   strb r1,[r6],1
   strb r1,[r6],1
   strb r1,[r6],1
   ldrb r1,[r7],1      ;xx
   strb r1,[r6],1
   strb r1,[r6],1
   strb r1,[r6],1
 subs r8,4*3
 bhi  @@lop
;blo  $        ;oops
 timelog_end rdtsc_upsampler
 bx   lr
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
.macro mp3mac_upsample_1_point_repeat_4x
 timelog_start rdtsc_upsampler
 ldr  r8,[r11,mp3ctx_samples_output_size]  ;siz
 ldr  r7,=mp3_upsample_buf                 ;src
 mov  r6,r9                                ;dst
@@lop:
;SHIM-UNROLLED .rept 4 = 4
   ldrb r1,[r7],1      ;xx
   orr  r1,r1,lsl 8    ;xxxx
   orr  r1,r1,lsl 16   ;xxxxxxxx
   str  r1,[r6],4
   ldrb r1,[r7],1      ;xx
   orr  r1,r1,lsl 8    ;xxxx
   orr  r1,r1,lsl 16   ;xxxxxxxx
   str  r1,[r6],4
   ldrb r1,[r7],1      ;xx
   orr  r1,r1,lsl 8    ;xxxx
   orr  r1,r1,lsl 16   ;xxxxxxxx
   str  r1,[r6],4
   ldrb r1,[r7],1      ;xx
   orr  r1,r1,lsl 8    ;xxxx
   orr  r1,r1,lsl 16   ;xxxxxxxx
   str  r1,[r6],4
 subs r8,4*4
 bhi  @@lop
;blo  $        ;oops
 timelog_end rdtsc_upsampler
 bx   lr
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
.macro mp3mac_upsample_1_point_repeat_8x
 timelog_start rdtsc_upsampler
 ldr  r8,[r11,mp3ctx_samples_output_size]  ;siz
 ldr  r7,=mp3_upsample_buf                 ;src
 mov  r6,r9                                ;dst
@@lop:
;SHIM-UNROLLED .rept 4 = 4
   ldrb r1,[r7],1      ;xx
   orr  r1,r1,lsl 8    ;xxxx
   orr  r1,r1,lsl 16   ;xxxxxxxx
   mov  r2,r1          ;xxxxxxxx,xxxxxxxx
   stmia [r6]!,r1,r2
   ldrb r1,[r7],1      ;xx
   orr  r1,r1,lsl 8    ;xxxx
   orr  r1,r1,lsl 16   ;xxxxxxxx
   mov  r2,r1          ;xxxxxxxx,xxxxxxxx
   stmia [r6]!,r1,r2
   ldrb r1,[r7],1      ;xx
   orr  r1,r1,lsl 8    ;xxxx
   orr  r1,r1,lsl 16   ;xxxxxxxx
   mov  r2,r1          ;xxxxxxxx,xxxxxxxx
   stmia [r6]!,r1,r2
   ldrb r1,[r7],1      ;xx
   orr  r1,r1,lsl 8    ;xxxx
   orr  r1,r1,lsl 16   ;xxxxxxxx
   mov  r2,r1          ;xxxxxxxx,xxxxxxxx
   stmia [r6]!,r1,r2
 subs r8,4*8
 bhi  @@lop
;blo  $        ;oops
 timelog_end rdtsc_upsampler
 bx   lr
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
.macro mp3mac_upsample_1_point_repeat_16x
 timelog_start rdtsc_upsampler
 ldr  r8,[r11,mp3ctx_samples_output_size]  ;siz
 ldr  r7,=mp3_upsample_buf                 ;src
 mov  r6,r9                                ;dst
@@lop:
;SHIM-UNROLLED .rept 4 = 4
   ldrb r1,[r7],1      ;xx
   orr  r1,r1,lsl 8    ;xxxx
   orr  r1,r1,lsl 16   ;xxxxxxxx
   mov  r2,r1          ;xxxxxxxx,xxxxxxxx
   mov  r3,r1          ;xxxxxxxx,xxxxxxxx
   mov  r4,r1          ;xxxxxxxx,xxxxxxxx
   stmia [r6]!,r1,r2,r3,r4
   ldrb r1,[r7],1      ;xx
   orr  r1,r1,lsl 8    ;xxxx
   orr  r1,r1,lsl 16   ;xxxxxxxx
   mov  r2,r1          ;xxxxxxxx,xxxxxxxx
   mov  r3,r1          ;xxxxxxxx,xxxxxxxx
   mov  r4,r1          ;xxxxxxxx,xxxxxxxx
