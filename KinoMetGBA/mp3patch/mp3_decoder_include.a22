.endmacro
 .macro def_icon_palette
  dw 7fffh,0000h,(400h*6)+(20h*12h)+1ch
  defs 13*2
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
.macro def_title
  dw "Nocash Mp3 Player",0ah,"An audio player for NDS",0ah,"Martin Korth",0
 defs 100h-((org()-40h) & 0ffh)  ;padding align to 240h+N*100h
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
;------------------
;:---SubCPU-------- HW code Hardware NDS/DSi/3DS SubCPU
;------------------
;------------------
;:----------------- DSi Footers
;------------------
 ntr_total:              ;-total size of NTR areas
;------------------
;:----------------- End of All
;------------------
  .align 4    ;SHIM-CHANGED: was '.align 20000h' (128KB flashcart-upload-boundary padding from the original standalone Nocash project) -- irrelevant/wasteful when appended into KiNoMet's ROM, so reduced to normal 4-byte alignment
  src_data_start:

    ;note: quoted filenames are supported in no$gba v3.06 and up, 12/2024
