 db sortcode_blank      ;2015h Dash Horizontal bar
 db sortcode_blank      ;2016h Double vertical line
 db sortcode_blank      ;2017h Double low line (double underscore)
 db sortcode_blank      ;2018h Quotation single quote left          (ANSI=91h)
 db sortcode_blank      ;2019h Quotation single quote right         (ANSI=92h)
 db sortcode_blank      ;201Ah Quotation single quote left (low)    (ANSI=82h)
 db sortcode_blank      ;201Bh Quotation single quote right (high)
 db sortcode_blank      ;201Ch Quotation double quote left          (ANSI=93h)
 db sortcode_blank      ;201Dh Quotation double quote right         (ANSI=94h)
 db sortcode_blank      ;201Eh Quotation double quote left (low)    (ANSI=84h)
