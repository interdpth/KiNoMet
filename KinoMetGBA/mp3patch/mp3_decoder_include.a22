;------------------
flac_post_apply_shift_if_any:   ;in: r8=len
 ldr  r5,[r11,flacctx_shift]            ;\apply flac_shift
 cmp  r5,0      ;shift                  ; (if any, usually none such)
 bxeq lr                                ; needed for files with "wasted bits"
;- - -                                  ; needed for 4bit/12bit files (that use "flac_extra_shift" for conversion to 8bit/16bit output)
 rsb  r8,0      ;index = -len           ;
@@post_adjust_lop:                      ;
 ldr  r4,[r9,r8,lsl 2]                  ;                     ;DEST
 mov  r4,r4,lsl r5                         ;
 str  r4,[r9,r8,lsl 2]                  ;                     ;DEST
 adds r8,1                              ;
 bne  @@post_adjust_lop                 ;/
 bx   lr
;------------------
.pool
;------------------
;SHIM-REMOVED.code  ;or .const
 .align data_align
 ;---
 flac_bit_depths:
  db 0              ;00h Bit depth only stored in the streaminfo metadata block
  db 8              ;01h 8 bits per sample
  db 12             ;02h 12 bits per sample
  db -1             ;03h Reserved
  db 16             ;04h 16 bits per sample
  db 20             ;05h 20 bits per sample
  db 24             ;06h 24 bits per sample
  db 32             ;07h 32 bits per sample
 ;---
 flac_sample_rates:
  dd 0     ;filehdr ;00h Sample rate only stored in the streaminfo metadata block
  dd 88200          ;01h 88.2 kHz
  dd 176400         ;02h 176.4 kHz
  dd 192000         ;03h 192 kHz
  dd 8000           ;04h 8 kHz
  dd 16000          ;05h 16 kHz
  dd 22050          ;06h 22.05 kHz
  dd 24000          ;07h 24 kHz
  dd 32000          ;08h 32 kHz
  dd 44100          ;09h 44.1 kHz
  dd 48000          ;0Ah 48 kHz
  dd 96000          ;0Bh 96 kHz
  dd 1000  ;mul N   ;0Ch 8bit*1000 Hz  ;Uncommon sample rate in kHz, stored as an 8-bit number
  dd 1     ;mul N   ;0Dh 16bit*1 Hz    ;Uncommon sample rate in Hz, stored as a 16-bit number
  dd 10    ;mul N   ;0Eh 16bit*10 Hz   ;Uncommon sample rate in Hz divided by 10, stored as a 16-bit number
  dd -1    ;invalid ;0Fh Forbidden
 flac_mode_num_channels: db 1,2,3,4,5,6,7,8,2,2,2,0,0,0,0,0  ;per channel assignment
 ;---
 .align data_align
 flac_fixed_coeffs:
  dd    0,   0,   0,   0   ;0   ;none
  dd    0,   0,   0,+01h   ;1   ;abs.sum = 01h   ;\
  dd    0,   0,-01h,+02h   ;2   ;abs.sum = 03h   ; signed sums are +01h
  dd    0,+01h,-03h,+03h   ;3   ;abs.sum = 07h   ;
  dd -01h,+04h,-06h,+04h   ;4   ;abs.sum = 0Fh   ;/
 ;---
;SHIM-REMOVED.code
;------------------
.pool
 .definelabel flac_decoder_reloc_siz, org()-flac_decoder_reloc_dst
     .definelabel flac_cache, org();use remaining reloc space as prediction cache...
     .definelabel flac_cache_size, (gba_stackbottom-flac_cache) & 0FF00h;currently 3700h on GBA (almost tall enough for common flac blocksize with 1000h samples, aka 4000h bytes)
   .if (flac_decoder_reloc_siz+mp3_reloc_kernel_max)>gba_stackbottom
   .error "errif failed"
   .endif
;SHIM-REMOVED (undef)   .undef OVER_ORG
;SHIM-DEFERRED OVER_ORG=(org() & 0FF0000h)+10000h (not foldable at shim-time; substituted as text, armips resolves it)
   .headersize 08000000h  ;SHIM-FIXED: was .headersize MEM_ROM -- WRONG once MEM_ROM became the (KiNoMet-ROM-relative) blob-append offset instead of the whole file's own base. .headersize restores "virtual = physical + headersize" after an IWRAM-relocation excursion (see the matching .headersize (label)-orga() a few lines above each of these); that restore must use the ROM file's TRUE, fixed physical-to-virtual base (always 0x08000000 for a real GBA ROM -- byte 0 of the file is always virtual 0x08000000, a hardware constant, independent of where our blob happens to be appended). Using MEM_ROM here instead made headersize track our append offset, so virtual addresses computed after each restore silently overshot by roughly (MEM_ROM-0x8000000) -- confirmed by testing: this fix took the assembled blob from a wrong size that grew with FreeSpace (filesize+~0x20000) back to the correct, offset-independent ~0x16D04-byte size.
;------------------
;------------------
;:----------------- Mp3 code extras (id3,tag,xing,free format)
;------------------
rom_get_32bit_be_unaligned:    ;in: r4=src - out r4:value   ;BIG-ENDIAN
 mov  r2,4
@@lop:
 ldrb r1,[r4],1
 orr  r3,r1,r3,lsl 8
 subs r2,1
 bne  @@lop
 mov  r4,r3
 bx   lr
;------------------
rom_get_16bit_be_unaligned:    ;in: r4=src - out r4:value   ;BIG-ENDIAN
 ldrb r1,[r4],1
 ldrb r2,[r4],1
 orr  r4,r2,r1,lsl 8
 bx   lr
;------------------
rom_get_24bit_be_unaligned:    ;in: r4=src - out r4:value   ;BIG-ENDIAN
 ldrb r1,[r4],1
 ldrb r2,[r4],1
 ldrb r3,[r4],1
 orr  r4,r2,r1,lsl 8
 orr  r4,r3,r4,lsl 8
 bx   lr
;------------------
get_4x7bit_to_28bit:   ;big-endian
 mov  r2,28     ;bitnumber (starting at MSB, big-endian)
 mov  r3,0      ;sum
@@lop:
 ldrsb r1,[r4],1
 cmp  r1,0              ;\reject sign (bit7=1)
 bmi  @@error           ;/
 subs r2,7              ;-out: when done: sf=0, zf=1
 orr  r3,r1,lsl r2
 bne  @@lop             ;-out: when done: sf=0, zf=1
@@error:                ;-out: when error: sf=1
 mov  r4,r3
 bx   lr
;------------------
mp3_exclude_id3_headers:   ;io: [mp3ctx_stream_pos],[mp3ctx_stream_end]
;alternately ID3 may be automatically excluded when searching for sync marks,
;but that can fail if ID3 contains binary data.
;for example, the ID3 part in my "Infant Sanchos - Der Kaiser" file contains a
;huge 1.1Mbyte PNG with several sync-like FFh,Fxh byte sequences.
;- - -
 push lr
;- - -
@@header_tag_retry_lop:
 mov  r2,10                             ;\
 bl   rom_file_seek_read_r2             ;
 cmp  r2,10     ;min size               ; try load ID3 min size
 blo  @@no_id3                          ;
 mov  r8,r1     ;addr                   ;/
 mov  r4,r8                             ;\
 bl   rom_get_32bit_le_unaligned        ;
 and  r4,0ffffffh                       ; ID3 identifier
 ldr r1,=0x334449   ;"ID3"                ;
 cmp  r1,r4                             ;
 bne  @@no_id3                          ;/
 add  r4,r8,06h                         ;\
 bl   get_4x7bit_to_28bit               ; get size, big-endian, 4x7bit
 bmi  @@no_id3                          ;
 add  r4,10     ;-add ID3 header size   ;/
 ldr  r1,[r11,mp3ctx_stream_pos]        ;\
 ldr  r2,[r11,mp3ctx_stream_end]        ;
 add  r1,r4     ;raise addr             ; skip ID3 stuff
 cmp  r1,r2     ;check overkill         ; (unless exceeding end)
 bhi  @@no_id3                          ;
 str  r1,[r11,mp3ctx_stream_start]      ;
 str  r1,[r11,mp3ctx_stream_pos]        ;/


      bl   tty_decimal_r4
      bl   tty_wrcrlf
   ldr  r1,[r11,mp3ctx_id3_size]        ;\
   add  r1,r4                           ;
   str  r1,[r11,mp3ctx_id3_size]        ;/
 b    @@header_tag_retry_lop            ;-try more (eg. in case different ID3 versions exist)
;---
@@no_id3:
 pop  pc
;------------------
mp3_exclude_tag_footers:   ;io: [mp3ctx_stream_pos],[mp3ctx_stream_end]
 push lr
 mov  r4,400h                           ;\dummy pre-load (for better cache hits)
 bl   @@try_load_r6_from_end            ;/
;- - -
@@footer_tag_retry_lop:
 mov  r6,80h                          ;\
 bl   @@try_load_r6_from_end          ;
 blo  @@no_tag_or_ext                 ; "TAG" or "EXT"
 sub  r4,r7,r6                        ; (80h bytes each) (128 decimal)
 bl   rom_get_32bit_le_unaligned      ;
 and  r4,0ffffffh                     ;
 ldr r1,=0x474154   ;"TAG"          ;\  ;
 cmp  r1,r4                       ;   ;
 beq  @@got_tag_size_r6           ;/  ;
 ldr r1,=0x545845   ;"EXT"          ;\  ;
 cmp  r1,r4                       ;   ;
 beq  @@got_tag_size_r6           ;/  ;
@@no_tag_or_ext:                      ;/
;- - -
 mov  r6,0e3h                         ;\
 bl   @@try_load_r6_from_end          ;
 blo  @@no_tagplus                    ; "TAG+"
 sub  r4,r7,r6                        ; (E3h bytes) (227 decimal)
 bl   rom_get_32bit_le_unaligned      ;
 ldr r1,=0x2b474154                      ;
 cmp  r1,r4                           ;
 beq  @@got_tag_size_r6               ;
@@no_tagplus:                         ;/
;- - -
 mov  r6,10+10                        ;\
 bl   @@try_load_r6_from_end          ;
 blo  @@no_3di                        ; "3DI",04h
 sub  r4,r7,10                        ;
 bl   rom_get_32bit_le_unaligned      ;
 ldr r1,=0x494433+4000000h              ;
 cmp  r1,r4                           ;
 bne  @@no_3di                        ;
 ldrb r1,[r7,-5]                      ;
 tst  r1,10h         ;bit4            ;
 beq  @@no_3di                        ;
 sub  r4,r7,4                         ;
 bl   get_4x7bit_to_28bit             ;
 bmi  @@no_3di                        ;
 add  r6,r4,10+10    ;hdr+footer siz  ;
 b    @@got_tag_size_r6               ;
@@no_3di:                             ;/
;- - -
 mov  r6,20h                          ;\
 bl   @@try_load_r6_from_end          ;
 blo  @@no_ape                        ;
 add  r4,r7,00h-20h                   ;   ;\
 bl   rom_get_32bit_le_unaligned      ;   ;
 ldr r1,=0x54455041                      ;   ;
 cmp  r1,r4                           ;   ;
 bne  @@no_ape                        ;   ; check "APETAGEX"
 add  r4,r7,04h-20h                   ;   ;
 bl   rom_get_32bit_le_unaligned      ;   ;
 ldr r1,=0x58454741                      ;   ;
 cmp  r1,r4                           ;   ;
 bne  @@no_ape                        ;   ;/
 add  r4,r7,0ch-20h                   ;   ;\
 bl   rom_get_32bit_le_unaligned      ;   ; get size
 mov  r6,r3                           ;   ;/
 add  r4,r7,14h-20h                   ;   ;\
 bl   rom_get_32bit_le_unaligned      ;   ; test has-hdr-flag,
 tst  r4,1 << 31                     ;   ; and add hdrsiz, if any
 addne r6,20h    ;hdr.size            ;   ;/
 b    @@got_tag_size_r6               ;   ;-
@@no_ape:                             ;/
;- - -
 mov  r6,11+9                         ;\
 bl   @@try_load_r6_from_end          ;
 blo  @@no_lyrics                     ; "LYRICSEND" or "LYRICS200"
 add  r4,r7,00h-09h           ;\      ; (11+N+9 bytes each)
 bl   rom_get_32bit_le_unaligned      ;
 ldr r1,=0x4952594c              ;       ;
 cmp  r1,r4                   ;       ;
 bne  @@no_lyrics             ;       ;
 ldrb r4,[r7,04h-09h]         ;       ;
 cmp  r4,'C'                  ;       ;
 bne  @@no_lyrics             ;/      ;
 add  r4,r7,05h-09h           ;\      ;
 bl   rom_get_32bit_le_unaligned      ;
 ldr r1,=0x444e4553              ;       ;
 cmp  r1,r4                   ;       ;
 beq  @@lyrics3_v1            ;       ;
 ldr r1,=0x30303253              ;       ;
 cmp  r1,r4                   ;       ;
 beq  @@lyrics3_v2            ;       ;
 bne  @@no_lyrics             ;/      ;
;---                                  ;
@@lyrics3_v1:                         ;  ;\
 mov  r6,11+9                         ;  ;
@@lyrics3_v1_size_lop:                ;  ;

        ;XXX read SMALL snippet from "END-r6" (small enough to fit into any small cache)
        ;    via "rom_file_seek_read_r2_from_r1"
        ;    rather than reading "r6 bytes" from "END" (where r6 currently increases to 5120)

 bl   @@try_load_r6_from_end          ;  ;
 blo  @@no_lyrics                     ;  ;


 sub  r4,r7,r6                ;\      ;  ;
 bl   rom_get_32bit_le_unaligned      ;  ; lyrics3 v1
 ldr r1,=0x4952594c              ;       ;  ; (with leading "LYRICSBEGIN")
 cmp  r1,r4                   ;       ;  ;
 bne  @@lyrics3_v1_size_next  ;/      ;  ;
 sub  r4,r7,r6                ;\      ;  ;
 add  r4,4                    ;       ;  ;
 bl   rom_get_32bit_le_unaligned      ;  ;
 ldr r1,=0x45425343              ;       ;  ;
 cmp  r1,r4                   ;       ;  ;
 bne  @@lyrics3_v1_size_next  ;/      ;  ;
 sub  r4,r7,r6                ;\      ;  ;
 add  r4,7  ;overlap "E" char ;       ;  ;
 bl   rom_get_32bit_le_unaligned      ;  ;
 ldr r1,=0x4e494745              ;       ;  ;
 cmp  r1,r4                   ;       ;  ;
;bne  @@lyrics3_v1_size_next  ;/      ;  ;
 beq  @@got_tag_size_r6               ;  ;
@@lyrics3_v1_size_next:               ;  ;
 add  r6,1                            ;  ;
 cmp  r6,5120                         ;  ;
 bls  @@lyrics3_v1_size_lop           ;  ;/
 b    @@no_lyrics                     ;
;---                                  ;
@@lyrics3_v2:                         ;  ;\
 sub  r3,r7,6+9       ;src            ;  ;
 mov  r2,6            ;len            ;  ;
 mov  r6,0            ;sum            ;  ; lyrics3 v2
@@lyrics3_v2_size_lop:                ;  ; (with 6-digit size value)
 add  r6,r6,lsl 2     ;sum*5          ;  ;
 add  r6,r6           ;sum*10         ;  ;
 ldrb r1,[r3],1                       ;  ;
 sub  r1,30h                          ;  ;
 add  r6,r1           ;sum            ;  ;
 subs r2,1                            ;  ;
 bne  @@lyrics3_v2_size_lop           ;  ;
 add  r6,6+9          ;sum            ;  ;
 b    @@got_tag_size_r6               ;  ;/
@@no_lyrics:                          ;/
 b    @@footer_tag_all_done
;---
@@got_tag_size_r6:
      mov  r4,r6
      bl   tty_decimal_r4
      bl   tty_wrcrlf
 ldr  r1,[r11,mp3ctx_stream_end]      ;\
 subs r1,r6     ;decrease size        ; exclude TAG stuff
 bllo rom_fatalunexpected             ;
 str  r1,[r11,mp3ctx_stream_end]      ;/
   ldr  r1,[r11,mp3ctx_tag_size]      ;\
   add  r1,r6                         ; raise
   str  r1,[r11,mp3ctx_tag_size]      ;/
 b    @@footer_tag_retry_lop
@@footer_tag_all_done:
 pop  pc
;--- --- ---
@@try_load_r6_from_end:
 push lr
 ldr  r1,[r11,mp3ctx_stream_end]        ;\
 mov  r2,r6    ;wanted.size             ;
 cmp   r2,r1   ;\crop                   ; seek to end
 movhi r2,r1   ;/                       ;
 sub  r1,r2                             ;/
;mov  r2,r2    ;cropped.size            ;\read
 bl   rom_file_seek_read_r2_from_r1     ;/
;- - -
 cmp  r2,r6  ;loaded.size, wanted.size  ;-return flags
 addlo r7,r1,r2   ;\ptr to end of wanted.size (or to stream_end, if stream is smaller)
 addhs r7,r1,r6   ;/
 pop  pc                                ;out: flags, r1, r2, r7=ptr.to.end
;------------------
  mp3_check_xing_info:
   ;http://web.archive.org/web/20210126021629/http://www.mp3-tech.org/programmer/sources/vbrheadersdk.zip - xing specs, source code, and sample .mp3 file
   push lr
   mov  r3,0
   str  r3,[r11,mp3ctx_xing_id]
   str  r3,[r11,mp3ctx_xing_frames]
   str  r3,[r11,mp3ctx_xing_filesize]
     ldr  r1,[r11,mp3ctx_layer]     ;\XXX does mp1/mp2 have such data?
     cmp  r1,fmt_mp3                ;     at which "data location"?
     bne  @@no_data_location        ;/
   ldr  r4,[r11,mp3ctx_src_data_location]
   bl   rom_get_32bit_le_unaligned
   ldr r1,=0x676e6958
   cmp  r1,r4
   beq  @@xing;"Xing" (VBR Variable BitRate info, by Xing and LAME encoders)
  ;ldr r1,=0x49524256 // cmp  r1,r4 // beq  @@vbri    ;"VBRI" (VBR Variable BitRate info, by Fraunhofer encoder) (rarely used)
  ;ldr r1,=0x6f666e49 // cmp  r1,r4 // beq  @@info    ;"Info" (CBR Constant BitRate info) (same format as xing, but unknown what that's good for)
  ;ldr r1,=0x454d414c // cmp  r1,r4 // beq  @@lame    ;"LAME" (version string and/or other stuff)
  ;ldr r1,=0x6376614c // cmp  r1,r4 // beq  @@lavc    ;"Lavc" (version string and/or other stuff)
  ;ldr r1,=0x2e2e2e2e // cmp  r1,r4 // beq  @@....    ;"here are the ancillary-data !",0Dh,0Ah (in 0Eh-byte snippets) (*.bit sample files) (eg. l3-sin1k0db.bit)
  ;reportedly also GOGO,UUUU,MPGE or so ?
  @@no_data_location:
  @@done:
   pop  pc
  ;---
  @@xing:
  @@info:
   ldr  r9,[r11,mp3ctx_src_data_location]               ;-start addr
   str  r4,[r11,mp3ctx_xing_id]    ;"Xing" or "Info"    ;\ID
   add  r9,4    ;skip id                                ;/
   mov  r4,r9                                           ;\
   bl   rom_get_32bit_be_unaligned                      ;
   str  r4,[r11,mp3ctx_xing_flags]                      ; flags
   mov  r8,r4   ;flags                                  ;
   add  r9,4    ;skip flags                             ;/
   tst  r8,1 << 0                                      ;\
   beq  @@no_xing_frames                                ;
   mov  r4,r9                                           ; frames
   bl   rom_get_32bit_be_unaligned                      ;
   str  r4,[r11,mp3ctx_xing_frames]                     ;
   add  r9,4    ;skip frames                            ;
  @@no_xing_frames:                                     ;/
   tst  r8,1 << 1                                      ;\
   beq  @@no_xing_filesize                              ;
   mov  r4,r9                                           ; filesize
   bl   rom_get_32bit_be_unaligned                      ;
   str  r4,[r11,mp3ctx_xing_filesize]                   ;
   add  r9,4    ;skip filesize                          ;
  @@no_xing_filesize:                                   ;/
   tst  r8,1 << 2                                      ;\
   beq  @@no_xing_toc                                   ;
   mov  r4,r9                   ;src                    ; toc
   ldr  r5,=mp3ctx_xing_toc     ;dst ;\                 ;
   add  r5,r11                  ;dst ;/                 ;
   mov  r6,100                  ;len                    ;
   bl   rom_generic_memcopy                             ;
   add  r9,100  ;skip toc                               ;
  @@no_xing_toc:                                        ;/
   tst  r8,1 << 3                                      ;\
   beq  @@no_xing_vbr_scale                             ;
   mov  r4,r9                                           ; vbr scale
   bl   rom_get_32bit_be_unaligned                      ; (unknown purpose, xing stores something there, other encoders tend to set this to 0 or 64h)
   str  r4,[r11,mp3ctx_xing_vbr_scale]                  ;
   add  r9,4    ;skip scale                             ;
  @@no_xing_vbr_scale:                                  ;/
  ;- - -
   mov  r3,0                                            ;\
   str  r3,[r11,mp3ctx_bit_rate]                        ;
   ldr  r4,[r11,mp3ctx_src_sample_rate] ;\              ;
   mov  r4,r4,lsl 3  ;mul8 (bits)          ; calc val      ; calc bits per second
   ldr  r5,[r11,mp3ctx_xing_filesize]   ;               ;
   umull r4,r5,r4,r5                    ;/              ;    ;XXXmul.regs
   ldr  r6,[r11,mp3ctx_xing_frames]     ;\              ; filesize*8*samplerate / (frames*18*32*granules)
   ldr  r1,[r11,mp3ctx_nb_granules]     ; calc divider  ;
   mul  r6,r6,r1                        ;               ;
   mov  r1,18*32                        ;               ;
   mul  r6,r6,r1                        ;/              ;
   cmp  r5,r6                           ;\              ;
   bhs  @@overflow                      ; divide        ;
   bl   rom_div_r5r4_r6                 ;/              ;
   str  r4,[r11,mp3ctx_bit_rate]        ;-apply         ;
  @@overflow:                                           ;/
   b    @@done
;------------------
  mp3_calc_assumed_duration:      ;-calc assumed song duration
   push lr
     ldr  r4,[r11,mp3ctx_layer]
     cmp  r4,fmt_flac
     bne  @@not_flac
     ldr  r1,[r11,flacctx_num_samples+0] ;lsw
     ldr  r2,[r11,flacctx_num_samples+4] ;msw
     mov  r3,1000
     mul  r6,r2,r3      ;r6    = msw*1000
     umull r4,r5,r1,r3  ;r5:r4 = lsw*1000
     add  r5,r6         ;merge msw
     ldr  r6,[r11,mp3ctx_src_sample_rate]
     bl   rom_div_r5r4_r6
     b    @@this
    @@not_flac:
   ldr  r4,[r11,mp3ctx_xing_id]                 ;\
   cmp  r4,0                                    ;
   bne  @@have_xing                             ;/
  ;- - -
   ldr  r1,[r11,mp3ctx_stream_pos]        ;src  ;\
   ldr  r2,[r11,mp3ctx_stream_end]        ;end  ;
   mov  r3,8*1000   ;mul 8bits, mul 1000        ; filesize*8*1000/bitrate
   sub  r2,r1                                   ;
   umull r4,r5,r2,r3                            ;   note: for whatever reason,
   ldr  r6,[r11,mp3ctx_bit_rate]                ;   this appears even longer than xing (when comparing Pisse_VBR with Pisse_320bits)
   bl   rom_div_r5r4_r6                         ;/
   b    @@this
  ;---
  @@have_xing:
   ldr  r1,[r11,mp3ctx_samples_output_size]     ;\
   mov  r2,1000                                 ; compute based on num frames
   mul  r3,r1,r2                                ;
   ldr  r1,[r11,mp3ctx_xing_frames]             ;
   umull r4,r5,r1,r3                            ;
   ldr  r6,[r11,mp3ctx_output_sample_rate]      ;
   bl   rom_div_r5r4_r6                         ;   note: this includes the xing
   ldr  r1,[r11,mp3ctx_output_num_channels]     ;   header frame (so it will appear 1 frame longer than a "raw" file without xing)
   ldr  r2,[r11,mp3ctx_dst_bytes_per_sample]    ;
   mul  r5,r1,r2                                ;
   bl   rom_div_r4_r5                           ;/
  ;- - -
  @@this:
   str  r4,[r11,mp3ctx_src_milliseconds]
   pop  pc
;------------------
;:----------------- Mp3 code extras wav files (non-mp3)
;------------------
;------------------
;http://fileformats.archiveteam.org/wiki/WAV
;https://sembiance.com/fileFormatSamples/audio/wav/
;https://www-mmsp.ece.mcgill.ca/Documents/AudioFormats/WAVE/Samples.html
;------------------
;fmt chunk body:
;  00h   2  format code
;  02h   2  number of interleaved channels
;  04h   4  sampling rate ("blocks" per second)
;  08h   4  data rate (average bytes per sec)
;  0Ch   2  block align (bytes per sample)
;  0Eh   2  bits per sample
;  (10h) 2  size of extension data (N/A or 0 or 22) ;-when size=12h or 28h
;  (12h) 2  number of valid bits                    ;\
;  (14h) 4  speaker position mask                   ; when size=28h
;  (18h) 16 GUID, including the data format code    ;/
;------------------
;formats
;  0001h  WAVE_FORMAT_PCM               PCM
;  0003h  WAVE_FORMAT_IEEE_FLOAT        IEEE float
;  0006h  WAVE_FORMAT_ALAW              8-bit ITU-T G.711 A-law
;  0007h  WAVE_FORMAT_MULAW             8-bit ITU-T G.711 u-law
;  FFFEh  WAVE_FORMAT_EXTENSIBLE        Determined by SubFormat
;  more --> http://www.iana.org/assignments/wave-avi-codec-registry/wave-avi-codec-registry.xml
;------------------
detect_wav_file:
 push lr
 mov  r1,fmt_none                       ;\initially none
 str  r1,[r11,mp3ctx_layer]             ;/
 mov  r2,4+4+4                          ;\
 bl   rom_file_seek_read_r2             ; read RIFF header
 mov  r8,r1      ;addr                  ;
 cmp  r2,4+4+4   ;min size              ;
 blo  @@not_riff_wave                   ;/
 add  r4,r8,0                           ;\
 bl   rom_get_32bit_le_unaligned        ;
 ldr r3,=0x46464952                ;"RIFF" ;
 cmp  r4,r3                             ;
 bne  @@not_riff_wave                   ; check IDs RIFF and WAVE
 add  r4,r8,8                           ;
 bl   rom_get_32bit_le_unaligned        ;
 ldr r3,=0x45564157                ;"WAVE" ;
 cmp  r4,r3                             ;
 bne  @@not_riff_wave                   ;/
 ldr  r1,[r11,mp3ctx_stream_pos]        ;\
 add  r1,4+4+4                          ; skip RIFF header
 str  r1,[r11,mp3ctx_stream_pos]        ;/
@@chunk_lop:
 mov  r2,4+4                            ;\
 bl   rom_file_seek_read_r2             ;
 mov  r8,r1      ;addr                  ;
 cmp  r2,4+4                            ; read chunk header
 blo  @@corrupt_riff_wave               ; (name and size)
 add  r4,r8,0                    ;\     ;
 bl   rom_get_32bit_le_unaligned ; name ;
 mov  r9,r4                      ;/     ;
 add  r4,r8,4                    ;\     ;
 bl   rom_get_32bit_le_unaligned ; size ;
 mov  r7,r4                      ;/     ;/
 ldr  r1,[r11,mp3ctx_stream_pos]        ;\
 add  r1,4+4                            ; skip chunk header
 str  r1,[r11,mp3ctx_stream_pos]        ;/
 ldr r3,=0x20746d66                ;"fmt " ;\
 cmp  r3,r9                             ;
 beq  @@got_fmt_chunk                   ;
;ldr r3,=0x74636166                ;"fact" ; check chunk type
;cmp  r3,r9                             ;
;beq  @@got_fact_chunk                  ;
 ldr r3,=0x61746164                ;"data" ;
 cmp  r3,r9                             ;
 beq  @@got_data_chunk                  ;/
        ;could warn on unknown chunks and/or add them to "id3_size"
@@chunk_next:
 ldr  r1,[r11,mp3ctx_stream_pos]        ;\
 add  r1,r7                             ; skip chunk body
 str  r1,[r11,mp3ctx_stream_pos]        ;/
 b    @@chunk_lop
;---
@@not_riff_wave:
 cmp  sp,0   ;out: NE = not a wav file
 pop  pc
;---
@@corrupt_riff_wave:
 ldr  r3,[r11,mp3ctx_stream_pos]        ;\
 str  r3,[r11,mp3ctx_stream_start]      ; force empty
 str  r3,[r11,mp3ctx_stream_end]        ;/
;- - -
@@done_wav:
 bl   wav_aiff_decide_rate_bits_proc            ;-decide
;- - -
 cmp  r0,r0  ;out: EQ = wav file
 pop  pc
;---
@@got_data_chunk:
 ldr  r3,[r11,mp3ctx_stream_pos]        ;\
 str  r3,[r11,mp3ctx_stream_start]      ;
 add  r3,r7                             ; apply data position and size
 ldr  r2,[r11,mp3ctx_stream_end]        ; as stream start/end
 cmp  r3,r2                             ;
 bhi  @@corrupt_riff_wave               ;
 str  r3,[r11,mp3ctx_stream_end]        ;/
 ldr  r2,[r11,mp3ctx_layer]             ;\
 cmp  r2,fmt_none                       ; error if missing fmt chunk
 beq  @@corrupt_riff_wave               ;/
 b    @@done_wav                        ;-okay (and ignore any further chunks)
;---
@@got_fmt_chunk:
 cmp  r7,16                             ;\
 blo  @@corrupt_riff_wave               ;
 cmp  r7,40                             ; read fmt chunk body
 bhi  @@corrupt_riff_wave               ; (should be size = 16 or 18 or 40)
 mov  r2,r7   ;chunk.size               ;           (aka 10h or 12h or 28h)
 bl   rom_file_seek_read_r2             ;
 mov  r8,r1      ;addr                  ;
 cmp  r2,r7   ;loaded vs chunk.size     ;
 blo  @@corrupt_riff_wave               ;/
;- - -
 add  r4,r8,0                     ;format       ;\
 bl   rom_get_16bit_le_unaligned                ;
 ldr  r3,=0fffeh                                ;
 cmp  r4,r3                                     ;
 bne  @@not_extensible_format                   ;
 cmp  r7,40   ;chunk.size                       ; format
 blo  @@corrupt_riff_wave                       ; (usually PCM,
   ;XXX verify constants in guid[2..0Fh]        ; or some others)
   ;bne  @@corrupt_riff_wave                    ;
 add  r4,r8,18h               ;guid[0..1]       ;
 bl   rom_get_16bit_le_unaligned                ; (or myriads of weird stuff,
@@not_extensible_format:                        ; like custom ADPCM variants)
 cmp  r4,0001h                  ;\              ;
 mov  r5,fmt_wav_pcm            ; PCM           ;
 beq  @@accept_format           ;/              ;
 cmp  r4,0003h                  ;\              ;
 mov  r5,fmt_wav_float          ; IEEE_FLOAT    ;
 beq  @@accept_format           ;/              ;
 cmp  r4,0006h                  ;\              ;
 mov  r5,fmt_wav_alaw           ; 8bit A-law    ;
 beq  @@accept_format           ;/              ;
 cmp  r4,0007h                  ;\              ;
 mov  r5,fmt_wav_ulaw           ; 8bit u-law    ;
 beq  @@accept_format           ;/              ;
 b    @@corrupt_riff_wave                       ;
@@accept_format:                                ;
 str  r5,[r11,mp3ctx_layer]                     ;/
 add  r4,r8,2                 ;num channels     ;\
 bl   rom_get_16bit_le_unaligned                ;
 str  r4,[r11,mp3ctx_src_num_channels]          ; num channels
 str  r4,[r11,mp3ctx_decode_num_channels]       ;
 str  r4,[r11,mp3ctx_output_num_channels]       ;/
 add  r4,r8,4                 ;sample rate      ;\
 bl   rom_get_32bit_le_unaligned                ; sample rate
 str  r4,[r11,mp3ctx_src_sample_rate]           ;/
 add  r4,r8,8                 ;data rate        ;\
 bl   rom_get_32bit_le_unaligned                ; average bytes/sec
 mov  r4,r4,lsl 3   ;bytes/sec --> bits/sec        ;
 str  r4,[r11,mp3ctx_bit_rate]                  ;/
         ;XXX above is "average" byte-rate for compressed files ?
         ;    (but it seems to be valid in uncompressed files, too)
         ;XXX otherwise, one could compute that as "blk_size*sample_rate"
 add  r4,r8,0ch               ;align            ;\
 bl   rom_get_16bit_le_unaligned                ; (BitsPerSample*Num_Channels/8)
 str  r4,[r11,mp3ctx_wav_src_blk_size]          ;/
 add  r4,r8,0eh               ;bits/samples     ;\
 bl   rom_get_16bit_le_unaligned                ;
 str  r4,[r11,mp3ctx_src_bits_per_sample]       ; bits per sample
 add  r4,7       ;roundup                       ;
 mov  r4,r4,lsr 3                                  ;
 str  r4,[r11,mp3ctx_src_bytes_per_sample]      ;/
 b    @@chunk_next
;------------------
.pool
;------------------
;------------------
;:----------------- Mp3 code extras aiff files (non-mp3)
;------------------
;------------------
;for AIFF/AIFC specs, see no$ami help
;------------------
;AIFC formats --> https://en.wikipedia.org/wiki/Audio_Interchange_File_Format
;  ID      Name                      Description
;  "NONE"  "not compressed"          Uncompressed PCM, big-endian, same as AIFF
;  "sowt"  ""                        Uncompressed PCM, little-endian (OS-X)
;  "fl32"  "IEEE 32-bit float"       IEEE 32bit float (Apple)
;  "fl64"  "IEEE 64-bit float"       IEEE 64bit float (Apple)
;  "FL32"  "Float 32"                IEEE 32bit float (SoundHack & Csound)
;  "alaw"  "ALaw 2:1"                8bit ITU-T G.711 A-law (Apple)
;  "ulaw"  B5h,"Law 2:1"             8bit ITU-T G.711 u-law (Apple)
;  "ALAW"  "SGI CCITT G.711 A-law"   8bit ITU-T G.711 A-law (SGI)
;  "ULAW"  "SGI CCITT G.711 u-law"   8bit ITU-T G.711 u-law (SGI)
;  "ADP4"  "4:1 Intel/DVI ADPCM"     4bit ADPCM (Stephane Tavenard, AmigaOS)
;  "ima4"  "IMA 4:1"                 4bit ADPCM (?)
;  "ACE2"  "ACE 2-to-1"              Apple IIGS Audio Compression/Expansion
;  "ACE8"  "ACE 8-to-3"              Apple IIGS Audio Compression/Expansion
;  "MAC3"  "MACE 3-to-1"             Macintosh Audio Compression/Expansion
;  "MAC6"  "MACE 6-to-1"             Macintosh Audio Compression/Expansion
;  "DWVW"  "Delta with variable word width"  (TX16W Typhoon)
;  "Qclp"  "Qualcomm PureVoice"      (Qualcomm)
;  "QDMC"  "QDesign Music"           (QDesign)
;  "rt24"  "RT24 50:1"               (Voxware)
;  "rt29"  "RT29 50:1"               (Voxware)
;  "SDX2"  "Square-Root-Delta"       Big-endian, 3DO (Panasonic) / Mac (Apple)
;  "G722"  "SGI CCITT G.722"         (?)
;  "G726"  "CCITT G.726"             (?)
;  "G728"  "CCITT G.728"             (?)
;  "GSM "  "GSM 06-10"               (?)
;------------------
detect_aiff_file:
 push lr
 mov  r1,fmt_none                       ;\initially none
 str  r1,[r11,mp3ctx_layer]             ;/
 mov  r2,4+4+4                          ;\
 bl   rom_file_seek_read_r2             ; read AIFF header
 mov  r8,r1      ;addr                  ;
 cmp  r2,4+4+4   ;min size              ;
 blo  @@not_aiff                        ;/
 add  r4,r8,0                           ;\
 bl   rom_get_32bit_le_unaligned        ;
 ldr r3,=0x4d524f46        ;\      ;"FORM" ;
 cmp  r4,r3             ;               ;
 bne  @@not_aiff        ;/              ; check IDs FORM and AIFF/AIFC
 add  r4,r8,8                           ;
 bl   rom_get_32bit_le_unaligned        ;
 ldr r3,=0x46464941       ;\      ;"AIFF" ;
 cmp   r4,r3            ;               ;
 ldrne r3,=0x43464941       ;       ;"AIFC" ;
 cmpne r4,r3            ;               ;
 bne   @@not_aiff       ;/              ;/
 ldr  r1,[r11,mp3ctx_stream_pos]        ;\
 add  r1,4+4+4                          ; skip AIFF header
 str  r1,[r11,mp3ctx_stream_pos]        ;/
@@chunk_lop:
 mov  r2,4+4                            ;\
 bl   rom_file_seek_read_r2             ;
 mov  r8,r1      ;addr                  ;
 cmp  r2,4+4                            ; read chunk header
 blo  @@corrupt_aiff                    ; (name and size)
 add  r4,r8,0                    ;\     ;
 bl   rom_get_32bit_le_unaligned ; name ;
 mov  r9,r4                      ;/     ;
 add  r4,r8,4                    ;\     ;
 bl   rom_get_32bit_be_unaligned ; size ;
 mov  r7,r4                      ;/     ;/
        ;XXX verify that (stream_pos + chunk.size) <= stream_end
 ldr  r1,[r11,mp3ctx_stream_pos]        ;\
 add  r1,4+4                            ; skip chunk header
 str  r1,[r11,mp3ctx_stream_pos]        ;/
 ldr r3,=0x4d4d4f43        ;\      ;"COMM" ;\
 cmp  r9,r3             ;               ;
 beq  @@got_common_chunk;/              ; check chunk type
 ldr r3,=0x444e5353        ;\      ;"SSND" ;
 cmp  r9,r3             ;               ;
 beq  @@got_ssnd_chunk  ;/              ;/
        ;could warn on unknown chunks and/or add them to "id3_size"
@@chunk_next:
 ldr  r1,[r11,mp3ctx_stream_pos]        ;\
 add  r7,1          ;\align 2           ;
 bic  r7,1          ;/                  ; skip chunk body
 add  r1,r7                             ;
 str  r1,[r11,mp3ctx_stream_pos]        ;/
 b    @@chunk_lop
;---
@@not_aiff:
 cmp  sp,0   ;out: NE = not an aiff file
 pop  pc
;---
@@corrupt_aiff:
 ldr  r3,[r11,mp3ctx_stream_pos]        ;\
 str  r3,[r11,mp3ctx_stream_start]      ; force empty
 str  r3,[r11,mp3ctx_stream_end]        ;/
;- - -
@@done_aiff:
 bl   wav_aiff_decide_rate_bits_proc            ;-decide
 ldr  r1,[r11,mp3ctx_src_bytes_per_sample]      ;\
 ldr  r2,[r11,mp3ctx_src_num_channels]          ; (BytesPerSample*Num_Channels) (after decide; because ulaw/alaw proc can force SRC bits=8)
 mul  r3,r1,r2                                  ;
 str  r3,[r11,mp3ctx_wav_src_blk_size]          ;/
 ldr  r1,[r11,mp3ctx_src_sample_rate]           ;\
 ldr  r2,[r11,mp3ctx_wav_src_blk_size]          ; bits/sec (after decide; because ulaw/alaw proc can force SRC bits=8)
 mul  r3,r1,r2                                  ;
 mov  r3,r3,lsl 3   ;bytes --> bits                ;
 str  r3,[r11,mp3ctx_bit_rate]                  ;/
;- - -
 cmp  r0,r0  ;out: EQ = aiff file
 pop  pc
;---
@@got_ssnd_chunk:
 mov  r2,4+4                            ;\
 bl   rom_file_seek_read_r2             ; read SSND header
 cmp  r2,4+4    ;min size               ; (alignment.offset, alignment.size)
 blo  @@corrupt_aiff                    ;/
 add  r4,r1,0                           ;\
 bl   rom_get_32bit_be_unaligned        ; get SSND[0] alignment.offset (usually 0=none)
 add  r4,(4+4)  ;plus SSND hdr size     ;/
 subs r7,r4     ;chunk.size             ;\
 blo  @@corrupt_aiff                    ;
 ldr  r1,[r11,mp3ctx_stream_pos]        ; skip SSND header & alignment.offset
 add  r1,r4                             ; and
 str  r1,[r11,mp3ctx_stream_pos]        ; apply data position and size
 str  r1,[r11,mp3ctx_stream_start]      ; as stream start/end
 add  r1,r7  ;remaining chunk.size      ;
 str  r1,[r11,mp3ctx_stream_end]        ;/
 ldr  r1,[r11,mp3ctx_layer]             ;\
 cmp  r1,fmt_none                       ; error if missing COMM chunk
 beq  @@corrupt_aiff                    ;/
 b    @@done_aiff                       ;-okay (and ignore any further chunks)
;---
@@got_common_chunk:
 cmp  r7,12h    ;chunk.size             ;\
 blo  @@corrupt_aiff                    ; read fmt chunk body
 mov  r2,r7     ;chunk.size             ; (should be size = 12h for AIFF)
 bl   rom_file_seek_read_r2             ; (XXX or 17h+N for AIFC)
 mov  r8,r1     ;addr                   ;
 cmp  r2,r7     ;loaded vs wanted.size  ;
 blo  @@corrupt_aiff                    ;/
 mov  r5,fmt_aiff                 ;\            ;\
 ldr r4,=0x454e4f4e  ;"NONE"         ; default     ;
 cmp  r7,12h    ;chunk.size       ; for AIFF    ;
 beq  @@this_method               ;/            ; format/method
 add  r4,r8,12h                   ;\ID for AIFC ;
 bl   rom_get_32bit_le_unaligned  ;/            ; (for AIFF or AIFC_xxx)
 mov  r5,fmt_aifc_none      ;\                  ;
 ldr r6,=0x454e4f4e  ;"NONE"   ; uncompressed      ;
 cmp  r6,r4                 ;                   ;
 beq  @@this_method         ;/                  ;
 mov  r5,fmt_aifc_sowt      ;\                  ;
 ldr r6,=0x74776f73  ;"sowt"   ; uncompressed      ;
 cmp  r6,r4                 ; little-endian     ;
 beq  @@this_method         ;/                  ;
 mov  r5,fmt_aifc_alaw      ;\                  ;
 ldr r6,=0x77616c61  ;"alaw"   ;                   ;
 cmp  r6,r4                 ; A-law             ;
 beq  @@this_method         ;                   ;
 ldr r6,=0x57414c41  ;"ALAW"   ;                   ;
 cmp  r6,r4                 ;                   ;
 beq  @@this_method         ;/                  ;
 mov  r5,fmt_aifc_ulaw      ;\                  ;
 ldr r6,=0x77616c75  ;"ulaw"   ;                   ;
 cmp  r6,r4                 ; u-law             ;
 beq  @@this_method         ;                   ;
 ldr r6,=0x57414c55  ;"ULAW"   ;                   ;
 cmp  r6,r4                 ;                   ;
 beq  @@this_method         ;/                  ;
 mov  r5,fmt_aifc_float     ;\                  ;
 ldr r6,=0x32336c66  ;"fl32"   ;                   ;
 cmp  r6,r4                 ;                   ;
 beq  @@this_method         ;                   ;
 ldr r6,=0x34366c66  ;"fl64"   ; float             ;
 cmp  r6,r4                 ;                   ;
 beq  @@this_method         ;                   ;
 ldr r6,=0x32334c46  ;"FL32"   ;                   ;
 cmp  r6,r4                 ;                   ;
 beq  @@this_method         ;/                  ;
 b    @@corrupt_aiff        ;-bad/other         ;
;---                                            ;
@@this_method:                                  ;
;str  r4,[r11,mp3ctx_aiff_method]               ;
 str  r5,[r11,mp3ctx_layer]                     ;/
 add  r4,r8,0                                   ;\
 bl   rom_get_16bit_be_unaligned                ;
 str  r4,[r11,mp3ctx_src_num_channels]          ; num channels
 str  r4,[r11,mp3ctx_decode_num_channels]       ;
 str  r4,[r11,mp3ctx_output_num_channels]       ;/
;add  r4,r8,2                                   ;\num samples (blah, implied in chunk size)
;bl   rom_get_32bit_be_unaligned                ;/
 add  r4,r8,6                                   ;\
 bl   rom_get_16bit_be_unaligned                ;
 str  r4,[r11,mp3ctx_src_bits_per_sample]       ; bits per sample
 add  r4,7       ;roundup (always done so)      ;
 mov  r4,r4,lsr 3                                  ;
 str  r4,[r11,mp3ctx_src_bytes_per_sample]      ;/
 add  r4,r8,08h+0                               ;\
 bl   rom_get_16bit_be_unaligned ;sign.exponent ;
 rsb  r5,r4,4000h ;\401Eh-N                     ; sample rate
 add  r5,1eh      ;/                            ; (80bit float, 1+15+1+63 bits)
 ;- - -                                         ;
 ;sign.exponent examples:                       ;
 ;  3FFFh --> need SHR 31                       ;
 ;  4000h --> need SHR 30                       ;
 ;  400Fh --> need SHR 15                       ;
 ;  401Eh --> need SHR 0                        ;
 ;- - -                                         ;
 ;full value examples:                          ;
 ;  3F FF 80 00 00 00 00 00 00 00  =  1.0       ;
 ;  40 0D AD DC 00 00 00 00 00 00  =  22254.0   ;  ;<-- 4orgasm.aif
 ;  40 0F BB 80 00 00 00 00 00 00  =  96000.0   ;  ;<-- Pisse - Fliegerbombe.aiff
 ;- - -                                         ;
 add  r4,r8,08h+2                               ;
 bl   rom_get_32bit_be_unaligned ;mantissa msbs ;
 movs r4,r4,lsr r5                                 ;
 beq  @@corrupt_aiff                            ;
 str  r4,[r11,mp3ctx_src_sample_rate]           ;/
;- - -
 b    @@chunk_next
;------------------
;------------------
;:----------------- Mp3 code extras au files (non-mp3)
;------------------
;------------------
;AU is some old Sun/NeXT audio format, it's really not popular anywhere else,
;it's only implemented here because the data formats are same as for AIFF
;------------------
;https://en.wikipedia.org/wiki/Au_file_format
;https://www.mmsp.ece.mcgill.ca/Documents/AudioFormats/AU/Samples.html
;------------------
;  00h 4    File ID (".snd")
;  04h 4    Data offset     The offset to the data in bytes. (In the older Sun version, this had to be a multiple of 8.) The minimum valid number is 28 (decimal), since this is the header length (six 32-bit words) plus a minimal annotation size (4 bytes, another 32-bit word).
;  08h 4    Data size       Data size in bytes, not including the header. If unknown, the value 0xffffffff should be used.
;  0Ch 4    Encoding Method
;  10h 4    Sample rate     The number of samples/second, e.g., 8000, 11025, 22050, 44100, and 48000.[4] NeXT may use 8013.[5]
;  14h 4    Channels        The number of interleaved channels, e.g., 1 for mono, 2 for stereo; more channels possible, but may not be supported by all readers.
;  18h ..   Description (ASCII, usually 00h terminated) (minimum 4 bytes)
;  ... (..) Padding to 4-byte boundary (or 8-byte boundary in older Sun files)
;  ... ..   Sample Data, interleaved, signed, big-endian
;---
;Encoding Methods:
;  00h   0.  Unspecified                                 ;-invalid?
;  01h   1.  8-bit G.711 u-law                           ;\
;  02h   2.  8-bit linear PCM                            ;
;  03h   3.  16-bit linear PCM                           ;
;  04h   4.  24-bit linear PCM                           ; normal
;  05h   5.  32-bit linear PCM                           ;
;  06h   6.  32-bit IEEE floating point                  ;
;  07h   7.  64-bit IEEE floating point                  ;/
;  08h   8.  Fragmented sample data                      ;\
;  09h   9.  Nested (unclear format)                     ;
;  0Ah  10.  DSP program                                 ;
;  0Bh  11.  8-bit fixed point                           ; uncommon stuff
;  0Ch  12.  16-bit fixed point                          ;
;  0Dh  13.  24-bit fixed point                          ;
;  0Eh  14.  32-bit fixed point                          ;
;  0Fh  15.  (Unassigned)                                ;
;  10h  16.  non-audio display data                      ;
;  11h  17.  u-law Squelch format                        ;
;  12h  18.  16-bit linear with emphasis                 ;
;  13h  19.  16-bit linear compressed                    ;
;  14h  20.  16-bit linear with emphasis and compression ;
;  15h  21.  Music kit DSP commands                      ;
;  16h  22.  Music kit DSP commands samples              ;/
;  17h  23.  ITU-T G.721 4-bit ADPCM                     ;\
;  18h  24.  ITU-T G.722 SB-ADPCM                        ; adpcm stuff
;  19h  25.  ITU-T G.723 3-bit ADPCM                     ;
;  1Ah  26.  ITU-T G.723 5-bit ADPCM                     ;/
;  1Bh  27.  8-bit G.711 A-law                           ;-normal
;  1Ch..FFh  Reserved for use by NeXT/Oracle             ;\
;  100h..FFFFFFFFh  Allowed to be used in custom formats ;/
;------------------
;SHIM-REMOVED.code  ;or .const
au_method_list:
 db 01h, 8  ,fmt_au_ulaw   ;8-bit G.711 u-law
 db 02h, 8  ,fmt_au_pcm    ;8-bit linear PCM
 db 03h, 16 ,fmt_au_pcm    ;16-bit linear PCM
 db 04h, 24 ,fmt_au_pcm    ;24-bit linear PCM
 db 05h, 32 ,fmt_au_pcm    ;32-bit linear PCM
 db 06h, 32 ,fmt_au_float  ;32-bit IEEE floating point
 db 07h, 64 ,fmt_au_float  ;64-bit IEEE floating point
 db 1Bh, 8  ,fmt_au_alaw   ;8-bit G.711 A-law
 db 00h   ;end of list
.align 4
;SHIM-REMOVED.code
;------------------
detect_au_file:
 push lr
 mov  r1,fmt_none                       ;\initially none
 str  r1,[r11,mp3ctx_layer]             ;/
 mov  r2,18h                            ;\
 bl   rom_file_seek_read_r2             ; read AU header
 mov  r8,r1      ;addr                  ;
 cmp  r2,18h     ;min size              ;
 blo  @@not_au                          ;/
 add  r4,r8,00h                                 ;\
 bl   rom_get_32bit_le_unaligned                ;
 ldr r3,=0x646e732e                                ; hdr[00h] File ID (".snd")
 cmp  r3,r4                                     ;
 bne  @@not_au                                  ;/
 add  r4,r8,04h                                 ;\
 bl   rom_get_32bit_be_unaligned                ; hdr[04h] Data Offset (HdrSize)
 cmp  r4,100000h   ;1Mbyte                      ; reject ridiculous large values
 bhi  @@not_au                                  ;
 mov  r6,r4             ;hdrsiz                 ;/
 add  r4,r8,08h                                 ;\
 bl   rom_get_32bit_be_unaligned                ; hdr[08h] Data Size
 mov  r7,r4             ;dtasiz                 ;/
 add  r4,r8,0ch                                 ;\
 bl   rom_get_32bit_be_unaligned                ;
 ldr  r5,=au_method_list                        ; hdr[0Ch] Encoding Method
@@method_lop:                                   ;
 ldrb r1,[r5],1              ;file id           ;
 cmp  r1,0      ;end of list                    ;
 beq  @@not_au               ;UNKNOWN method    ;
 ldrb r2,[r5],1              ;bits (8,16,24,32) ;
 ldrb r3,[r5],1              ;fmt_xxx           ;
 cmp  r1,r4     ;file id                        ;
 bne  @@method_lop                              ;
 str  r2,[r11,mp3ctx_src_bits_per_sample]       ;
 mov  r2,r2,lsr 3                                  ;
 str  r2,[r11,mp3ctx_src_bytes_per_sample]      ;
 str  r3,[r11,mp3ctx_layer]                     ;/
 add  r4,r8,10h                                 ;\
 bl   rom_get_32bit_be_unaligned                ; hdr[10h] Sample Rate
 str  r3,[r11,mp3ctx_src_sample_rate]           ;/
 add  r4,r8,14h                                 ;\
 bl   rom_get_32bit_be_unaligned                ;
 cmp  r4,16            ;reject absurd values    ; hdr[14h] Number of Channels
 bhi  @@not_au                                  ;
 str  r4,[r11,mp3ctx_src_num_channels]          ;
 str  r4,[r11,mp3ctx_decode_num_channels]       ;
 str  r4,[r11,mp3ctx_output_num_channels]       ;/
;- - -
 ldr  r1,[r11,mp3ctx_stream_pos]                ;\
 add  r1,r6   ;add hdrsiz                       ; skip AU header (hdrsiz)
 str  r1,[r11,mp3ctx_stream_pos]                ;/
     ;XXX could set [r11,mp3ctx_stream_end] to "r6+r7" (hdrsiz+dtasiz)
     ;XXX should then also verify that it doesn't exceed actual filesize
 bl   wav_aiff_decide_rate_bits_proc            ;-decide
 ldr  r1,[r11,mp3ctx_src_bytes_per_sample]      ;\
 ldr  r2,[r11,mp3ctx_src_num_channels]          ; (BytesPerSample*Num_Channels) (after decide; because ulaw/alaw proc can force SRC bits=8)
 mul  r3,r1,r2                                  ;
 str  r3,[r11,mp3ctx_wav_src_blk_size]          ;/
 ldr  r1,[r11,mp3ctx_src_sample_rate]           ;\
 ldr  r2,[r11,mp3ctx_wav_src_blk_size]          ; bits/sec (after decide; because ulaw/alaw proc can force SRC bits=8)
 mul  r3,r1,r2                                  ;
 mov  r3,r3,lsl 3   ;bytes --> bits                ;
 str  r3,[r11,mp3ctx_bit_rate]                  ;/
;- - -
 cmp  r0,r0  ;out: EQ = au file
 pop  pc
;---
@@not_au:
 cmp  sp,0   ;out: NE = not an au file
 pop  pc
;------------------
;------------------
;:----------------- Mp3 code extras wav/aiff/au files (non-mp3)
;------------------
;------------------
decoder_select_wav_pcm:
 ldr   r3,[r11,mp3ctx_dst_bytes_per_sample]
 cmp   r3,1
 ldreq r4,=wav_aiff_read_le_src_s16_dst_s8    ;for 16..32bit WAV little-endian
 ldrne r4,=wav_aiff_read_le_src_s16_dst_s16   ;for 16..32bit WAV little-endian
 ;- - -
 ldr   r3,[r11,mp3ctx_src_bytes_per_sample]
 cmp   r3,1
 ldreq r4,=wav_aiff_read_le_src_u8_dst_s8     ;for 8bit WAV (unsigned)
 str   r4,[r11,mp3ctx_decode_proc]
 bx    lr
;------------------
decoder_select_aiff:       ;=pcm, big-endian
decoder_select_aifc_none:  ;=pcm, big-endian
decoder_select_au_pcm:     ;=pcm, big-endian
 ldr   r3,[r11,mp3ctx_dst_bytes_per_sample]
 cmp   r3,1
 ldreq r4,=wav_aiff_read_be_src_s8_dst_s8     ;for 8..32bit AIFF big-endian   (and AIFC.sowt)
 ldrne r4,=wav_aiff_read_be_src_s16_dst_s16   ;for 16..32bit AIFF big-endian
 str   r4,[r11,mp3ctx_decode_proc]
 bx    lr
;------------------
decoder_select_aifc_sowt:
 ldr  r3,[r11,mp3ctx_src_bytes_per_sample]
 cmp  r3,1
 beq  decoder_select_aiff     ;src=8bit   --> like AIFF (SIGNED 8bit)
 b    decoder_select_wav_pcm  ;src>=16bit --> like WAV  (LITTLE-ENDIAN 16..32bit)
;------------------
decoder_select_wav_float:   ;little-endian
 ldr   r3,[r11,mp3ctx_src_bits_per_sample]
 cmp   r3,64
 beq   @@double_precision
;- - -
 ldr   r3,[r11,mp3ctx_dst_bytes_per_sample]
 cmp   r3,1
 ldreq r4,=wav_aiff_read_le_src_f32_dst_s8    ;for WAV.fl32
 ldrne r4,=wav_aiff_read_le_src_f32_dst_s16   ;for WAV.fl32
 b     @@this_dst_size
;---
@@double_precision:
 ldr   r3,[r11,mp3ctx_dst_bytes_per_sample]
 cmp   r3,1
 ldreq r4,=wav_aiff_read_le_src_f64_dst_s8    ;for WAV.fl64
 ldrne r4,=wav_aiff_read_le_src_f64_dst_s16   ;for WAV.fl64
@@this_dst_size:
 str   r4,[r11,mp3ctx_decode_proc]
 bx    lr
;------------------
decoder_select_aifc_float:   ;big-endian
decoder_select_au_float:     ;big-endian
 ldr   r3,[r11,mp3ctx_src_bits_per_sample]
 cmp   r3,64
 beq   @@double_precision
;- - -
 ldr   r3,[r11,mp3ctx_dst_bytes_per_sample]
 cmp   r3,1
 ldreq r4,=wav_aiff_read_be_src_f32_dst_s8    ;for AIFC.fl32
 ldrne r4,=wav_aiff_read_be_src_f32_dst_s16   ;for AIFC.fl32
 b    @@this_dst_size
;---
@@double_precision:
 ldr   r3,[r11,mp3ctx_dst_bytes_per_sample]
 cmp   r3,1
 ldreq r4,=wav_aiff_read_be_src_f64_dst_s8    ;for AIFC.fl64
 ldrne r4,=wav_aiff_read_be_src_f64_dst_s16   ;for AIFC.fl64
@@this_dst_size:
 str   r4,[r11,mp3ctx_decode_proc]
 bx    lr
;------------------
decoder_select_wav_alaw:
decoder_select_wav_ulaw:
decoder_select_aifc_alaw:
decoder_select_aifc_ulaw:
decoder_select_au_alaw:
decoder_select_au_ulaw:
 ;https://en.wikipedia.org/wiki/G.711
 ;---
 ;A-law decoding:
 ;XOR input by 55h, decode as shown in below table, then apply sign
 ;  s000abcd  -->  s0000000abcd1000  ;<-- special (highbit=0, smaller shift)
 ;  s001abcd  -->  s0000001abcd1000  ;\
 ;  s010abcd  -->  s000001abcd10000  ;
 ;  s011abcd  -->  s00001abcd100000  ; like uLaw
 ;  s100abcd  -->  s0001abcd1000000  ;
 ;  s101abcd  -->  s001abcd10000000  ;
 ;  s110abcd  -->  s01abcd100000000  ;
 ;  s111abcd  -->  s1abcd1000000000  ;/
 ;---
 ;u-law decoding:
 ;XOR input by FFh, decode as shown in below table, subtract 84h, then apply sign
 ;  s000abcd  -->  s00000001abcd100  ;<-- unlike aLaw
 ;  s001abcd  -->  s0000001abcd1000  ;\
 ;  s010abcd  -->  s000001abcd10000  ;
 ;  s011abcd  -->  s00001abcd100000  ; like aLaw
 ;  s100abcd  -->  s0001abcd1000000  ;
 ;  s101abcd  -->  s001abcd10000000  ;
 ;  s110abcd  -->  s01abcd100000000  ;
 ;  s111abcd  -->  s1abcd1000000000  ;/
;- - -
 mov  r4,1                                      ;\
 str  r4,[r11,mp3ctx_src_bytes_per_sample]      ; force src=8bit (AIFC.COMM chunk often declares 16bit)
 mov  r4,8                                      ;
 str  r4,[r11,mp3ctx_src_bits_per_sample]       ;/
 mov  r4,2 >> force_8bit                       ;\use dst=16bit (unless forced 8bit)
 str  r4,[r11,mp3ctx_dst_bytes_per_sample]      ;/
;- - -
 ldr   r3,[r11,mp3ctx_dst_bytes_per_sample]
 cmp   r3,1
 ldreq r4,=wav_aiff_read_law_src_law8_dst_s8  ;for aLaw/uLaw
 ldrne r4,=wav_aiff_read_law_src_law8_dst_s16 ;for aLaw/uLaw
 str   r4,[r11,mp3ctx_decode_proc]
;- - -
   ldr  r10,[r11,mp3ctx_alaw_ulaw_table_base]   ;
 mov  r4,0        ;index
 mov  r5,r10      ;dst = law table
;- - -
 ldr   r3,[r11,mp3ctx_layer]                    ;\
 cmp   r3,fmt_wav_alaw                          ;
 cmpne r3,fmt_aifc_alaw                         ; select alaw or ulaw table
 cmpne r3,fmt_au_alaw                           ;
 beq   @@make_alaw                              ;
 b     @@make_ulaw      ;otherwise ulaw         ;/
;---
@@make_alaw:
@@make_alaw_lop:
 xor  r1,r4,55h   ;transfer encoding            ;\
 mov  r2,r1,lsr 4 ;shift amount                 ;
 and  r2,7h       ;shift amount                 ; decode
 mov  r1,r1,lsl 4    ;value                        ;
 and  r1,0f0h     ;value                        ;
 orr  r1,08h      ;value                        ;
 subs r2,1                                      ;
;bmi  @@alaw_no_shift                           ;
 orrpl r1,100h    ;value                        ;
 movpl r1,r1,lsl r2  ;shift                        ;
@@alaw_no_shift:                                ;/
 tst  r4,80h      ;index.sign                   ;\sign
 rsbne r1,0       ;negate                       ;/
 strh r1,[r5],2   ;dst                          ;-cast 16bit
 add  r4,1        ;index
 cmp  r4,100h     ;index
 bne  @@make_alaw_lop
 b    @@finish_law
;---
@@make_ulaw:
@@make_ulaw_lop:
 xor  r1,r4,0ffh  ;transfer encoding            ;\
 mov  r2,r1,lsr 4 ;shift amount                 ;
 and  r2,7h       ;shift amount                 ; decode
 mov  r1,r1,lsl 3    ;value                        ;
 and  r1,078h     ;value                        ;
 add  r1,84h      ;value+84h                    ;
 mov  r1,r1,lsl r2   ;shift                        ;
 sub  r1,84h      ;value-84h                    ;/
 tst  r4,80h      ;index.sign                   ;\sign
 rsbne r1,0       ;negate                       ;/
 strh r1,[r5],2   ;dst                          ;-cast 16bit
 add  r4,1        ;index
 cmp  r4,100h     ;index
 bne  @@make_ulaw_lop
 b    @@finish_law
;---
@@finish_law:
 ldr  r3,[r11,mp3ctx_dst_bytes_per_sample]      ;\
 cmp  r3,1                                      ;
 bhi  @@keep_16bit_law                          ;/
 add  r4,r10,1  ;src = law table, msb           ;\
 mov  r5,r10    ;dst = law table                ;
 mov  r2,100h   ;len                            ;
@@make_8bit_law_lop:                            ; when dst=8bit,
 ldrb r1,[r4],2      ;msb of 16bit              ; collapse to 8bit
 strb r1,[r5],1                                 ;
 subs r2,1                                      ;
 bne  @@make_8bit_law_lop                       ;/
@@keep_16bit_law:
 bx   lr
;------------------
wav_aiff_decide_rate_bits_proc:
 push lr
 bl   force_output_8bit_or_16bit                ;-limit to 8bit or 16bit
 bl   force_rate_max_48khz                      ;-limit to max 48kHz for windows
 bl   force_mono_option                         ;-limit output to mono (optional)
 ldr  r3,[r11,mp3ctx_layer]                     ;\
 ldr  r4,=fmt_layer_proc_names+0                ; init proc
 ldr  r3,[r4,r3,lsl 4]                          ;
 bl   rom_bx_r3                                 ;/
 mov  r1,WAV_SNIPPET_SIZE                       ;\
 ldr  r2,[r11,mp3ctx_src_bytes_per_sample]      ; ;\
 ldr  r3,[r11,mp3ctx_dst_bytes_per_sample]      ; ; when src smaller than dst,
 cmp  r2,r3                                     ; ; force src with HALF blocksize
;bhs  @@this_blk_size                           ; ; (eg. for decoding 8bit alaw/ulaw to 16bit)
 movlo r1,r1,lsr 1   ;blk_size ;half for alaw/ulaw ; ;
@@this_blk_size:                                ; ;/
 ldr  r2,[r11,mp3ctx_dst_bytes_per_sample] ;\   ;
 mul  r4,r1,r2                             ;/   ; const (needed for DMA init)
 ldr  r5,[r11,mp3ctx_src_bytes_per_sample] ;\   ;
 bl   rom_div_r4_r5                        ;/   ;
        ;XXXwav rate_shift
 ldr  r1,[r11,mp3ctx_output_num_channels]       ; ;\
 ldr  r5,[r11,mp3ctx_src_num_channels]          ; ; divide when
 mul  r4,r1,r4                                  ; ; post_convert_to_mono
 bl   rom_div_r4_r5                             ; ;/
 str  r4,[r11,mp3ctx_samples_output_size]       ;/
 pop  pc
;------------------
force_mono_option:
 ldrb  r3,[r12,option_quality]
 cmp  r3,0    ;0=HQ, stereo
 movne r3,1
 strne r3,[r11,mp3ctx_output_num_channels]
 bx   lr
;------------------
force_output_8bit_or_16bit:
   mov  r3,1                                    ;
 str  r3,[r11,mp3ctx_dst_bytes_per_sample]      ;/
 bx   lr
;------------------
force_rate_max_48khz:  ;for WAV/AIFF/FLAC
 ldr  r1,[r11,mp3ctx_src_sample_rate]           ;-get src rate
   str  r1,[r11,mp3ctx_output_sample_rate]      ;-just apply as output rate
 bx   lr
;------------------
.pool
;------------------
;------------------
;:----------------- Mp3 code extras flac files (non-mp3)
;------------------
;------------------
;http://web.archive.org/web/2/https://xiph.org/flac/format.html
;http://web.archive.org/web/2/https://xiph.org/flac/old_format.html
;https://www.rfc-editor.org/rfc/rfc9639.html
;https://github.com/ietf-wg-cellar/flac-test-files/archive/refs/heads/main.zip  ;test files
;------------------
;ok flac speedup: mono: (when M/S, use mid channel only)
;ok flac speedup: use [flac_coeff_sum] to decide using SUM32 or slower SUM64
;XXXflac speedup: fixed_predict: optimize with hardcoded LEA opcodes (would work for non-SUM64 only) (ie. only if src_bits is FAR ENOUGH below 32bit)
;XXXflac speedup: bitstream reader: directly support cl>16 (automatically collect more, and keep reading) (maybe max cl=31) (or max cl=32, if posssible on x86)
;XXXflac speedup: rate_shift... somehow READ-and-IGNORE samples ?    -- probably NOT possible, because it would DERAIL prediction
;XXXflac speedup: cripple... maybe ONLY if the "subframe_depth" or "[flac_max_rice]" was tall (that was so far attempted the opposite way: if it's SMALL then SUM32 may work directly -- but the other way around: if it's TALL then CRIPPLE may permit SUM32 ?)
;------------------
;FLAC decompression is surprisingly SLOW,
;using some bandcamp files for testing on a Pentium III:
;  10,639,284 clks/s   DDR - In Line.flac        ;48000 Hz, stereo, 24 bit
;  11,273,993 clks/s   DDR - In Line.mp3         ;44100 Hz, stereo, 277 kbits/s
;  that's only slightly faster than mp3
;and it can get even WORSE because FLAC supports insane sample rates:
;  15,291,560 clks/s   Pisse - Fliegerbombe.flac ;96000 Hz, stereo, 24 bit
;  11,491,456 clks/s   Pisse - Fliegerbombe.mp3  ;44100 Hz, stereo, 320 kbits/s
;and WORSE, there isn't much room to speed up FLAC with reduced output quality:
;   6,680,378 clks/s   DDR - In Line.flac        ;/mono
;   2,257,952 clks/s   DDR - In Line.mp3         ;/mono /fast /div4 /cut
;more WORSE for high sample rates:
;  12,963,799 clks/s   Pisse - Fliegerbombe.flac ;/mono
;   2,305,638 clks/s   Pisse - Fliegerbombe.mp3  ;/mono /fast /div4 /cut
;---
;MONO speedup works ONLY for MID/SIDE encoded FLAC frames (whilst mp3 can
;always skip the MDCT/SYNTH for 2nd channel, regardless of MID/SIDE encoding,
;if it's MID/SIDE then MP3 can additionally skip huffman codes for 2nd channel)
;  DDR - In Line.flac            83% mid/side (good)
;  Pisse - Fliegerbombe.flac     36% mid/side (bad)
;---
;PREDICTION with SUM32 is faster than SUM64,
;  SUM32 can be used for most or all 8bit/16bit files
;  SUM32 can be used for frames with fixed_predict in 24bit files (eg. Pisse - Fliegerbombe has some such)
;  SUM32 might also work for some frames with custom_predict in 24bit files (if the custom "coeff_sum" is small... unknown if such files exist)
;---
;FIXED COEFFICIENTS (with SUM32) could be implemented via hardcoded
;ADD/SUB/SHIFT/LEA opcodes to avoid MULTIPLY opcodes
;  XXX implement that (but do that only if result fits into SUM32)
;---
;RATE_SHIFT speedup does (probably) not work: the prediction relies on ALL
;preceeding samples, and there's (probably) no way to get it working when
;skipping samples.
;---
;CRIPPLING the sample depth SEEMS to produce unreliable results.
;DDR - In Line does MOSTLY work even when stripping the lower 10bit each sample
;Pisse - Fliegerbombe does COMPLETLY DERAIL even when stripping only 1bit
;(unknown if there's a way determine when it does work, and when it doesn't)
;------------------
detect_flac_file:
 push lr
 mov  r1,fmt_none                       ;\initially none
 str  r1,[r11,mp3ctx_layer]             ;/
 mov  r2,4                              ;\
 bl   rom_file_seek_read_r2             ; read FLAC header
 cmp  r2,4       ;min size              ;
 blo  @@not_flac                        ;/
 add  r4,r1,0                           ;\
 bl   rom_get_32bit_le_unaligned        ;
 ldr r3,=0x43614c66 ;"fLaC"                ; check ID "fLaC"
 cmp  r3,r4                             ;
 bne  @@not_flac                        ;/
 ldr  r1,[r11,mp3ctx_stream_pos]        ;\
 add  r1,4                              ; skip FLAC header
 str  r1,[r11,mp3ctx_stream_pos]        ;/
@@chunk_lop:
 mov  r2,4                              ;\
 bl   rom_file_seek_read_r2             ;
 cmp  r2,4                              ; read chunk header
 blo  @@not_flac                        ; (flag+ID+size)
 add  r4,r1,0                           ;
 bl   rom_get_32bit_be_unaligned        ;
 mov  r10,r4                            ;/
 ldr  r1,[r11,mp3ctx_stream_pos]        ;\
 add  r1,4                              ; skip chunk header
 str  r1,[r11,mp3ctx_stream_pos]        ;/
 mov  r1,r10,lsr 24                     ;\
 ands r1,7Fh                            ;
 beq  @@got_stream_info_chunk           ; check chunk type
;cmp  r1,xxx                            ;
;beq  @@got_xxx_chunk                   ;/
        ;could warn on unknown chunks and/or add them to "id3_size"
@@chunk_next:
 ldr  r1,[r11,mp3ctx_stream_pos]        ;\
 and  r3,r10,00ffffffh          ;size   ; skip chunk body
 add  r1,r3                             ;
 str  r1,[r11,mp3ctx_stream_pos]        ;/
 cmp  r10,0                             ;\sign=flag=1 when LAST chunk
 bpl  @@chunk_lop                       ;/
;- - -
 ldr  r1,[r11,mp3ctx_layer]             ;\
 cmp  r1,fmt_flac                       ; check if stream info chunk did exist
 bne  @@not_flac                        ;/
 cmp  r0,r0  ;out: EQ = flac file
 pop  pc
;---
@@not_flac:
 cmp  sp,0   ;out: NE = not a flac file
 pop  pc
;--- --- ---
@@got_stream_info_chunk:
 and  r2,r10,00ffffffh          ;size           ;\
 cmp  r2,22h                                    ; read stream info chunk body
 bne  @@not_flac                                ; (must be size = 22h)
 bl   rom_file_seek_read_r2                     ;
 mov  r8,r1                     ;addr           ;
 cmp  r2,22h   ;loaded vs wanted.size           ;
 blo  @@not_flac                                ;/
 add  r4,r8,0                                   ;\
 bl   rom_get_16bit_be_unaligned                ; min blocksize  (16bit)
 cmp  r4,10h                                    ; (10h or more)
 blo  @@not_flac                                ;
 str  r4,[r11,flacctx_hdr_min_blksize]          ;
 mov  r5,r4             ;memorize min           ;/
 add  r4,r8,2                                   ;\
 bl   rom_get_16bit_be_unaligned                ; max blocksize  (16bit)
 str  r4,[r11,flacctx_hdr_max_blksize]          ; (min or more)
 cmp  r4,r5             ;cmp max,bin            ; (min=max when fixed blksize)
 blo   @@not_flac                               ;
 ldreq r2,=0f8ffh ;sync mark when fixed size    ;
;beq   @@fixed_blocksize                        ;
 movne r1,1                                     ;
 strne r1,[r11,flacctx_variable_blksize_flag]   ;
 ldrne r2,=0f9ffh ;sync mark when variable size ;
@@fixed_blocksize:                              ;
 str  r2,[r11,flacctx_hdr_sync_mark_be]         ;/
 add  r4,r8,4                                   ;\
 bl   rom_get_24bit_be_unaligned                ; min frame size (24bit)
 str  r4,[r11,flacctx_hdr_min_framesize]        ;/
 add  r4,r8,7                                   ;\
 bl   rom_get_24bit_be_unaligned                ; max frame size (24bit)
 str  r4,[r11,flacctx_hdr_max_framesize]        ;/
 add  r4,r8,0ah                                 ;\
 bl   rom_get_32bit_be_unaligned                ;
 mov  r1,r4,lsr 12                              ; ;\sample rate  (20bit)
 str  r1,[r11,mp3ctx_src_sample_rate]           ; ;/
 mov  r1,r4,lsr 9                               ; ;\
 and  r1,07h                                    ; ;
 add  r1,1                                      ; ; num channels (3bit)
 str  r1,[r11,mp3ctx_src_num_channels]          ; ;
 str  r1,[r11,mp3ctx_decode_num_channels]       ; ;
 str  r1,[r11,mp3ctx_output_num_channels]       ; ;/
 mov  r1,r4,lsr 4                               ; ;\
 and  r1,1fh                                    ; ; bits/sample  (5bit)
 add  r1,1                                      ; ;
 str  r1,[r11,mp3ctx_src_bits_per_sample]       ; ;
 add  r1,7       ;roundup (always done so)      ; ;  ;\that is, src accuracy
 mov  r1,r1,lsr 3                                  ; ;  ; (after decompression)
 str  r1,[r11,mp3ctx_src_bytes_per_sample]      ; ;/ ;/
 and  r1,r4,000fh                               ; ;\MSW of num samples (4bit)
 str  r1,[r11,flacctx_num_samples+4]      ;MSW  ;/;/
 add  r4,r8,0eh                                 ;\;\
 bl   rom_get_32bit_be_unaligned                ; ; LSW of num samples (32bit)
 str  r4,[r11,flacctx_num_samples+0]      ;LSW  ;/;/
;add  r4,r8,12h           ;src                  ;\
;add  r5,r11,flacctx_md5  ;dst                  ; MD5 checksum (16 bytes/128bit)
;mov  r6,10h              ;len                  ;
;bl   rom_generic_memcopy                       ;/
 mov  r0,0                                      ;\
 str  r0,[r11,flacctx_blocksize]                ; initially empty
 str  r0,[r11,flacctx_rd_ptr]                   ;/
 bl   force_output_8bit_or_16bit                ;-limit to 8bit or 16bit
 bl   force_rate_max_48khz                      ;-limit to max 48kHz for windows
 bl   force_mono_option                         ;-limit output to mono (optional)
 ldr  r1,[r11,mp3ctx_dst_bytes_per_sample]      ;\
 mov  r1,r1,lsl 3    ;dst_bits (bytes*8)           ; if src.bits is LESS than
 ldr  r2,[r11,mp3ctx_src_bits_per_sample]       ; dst.bits, apply difference
 subs r1,r2                                     ; as extra shift
;bhi   @@with_extra_left_shift                  ;
 movlo r1,0    ;zero (normal case)              ; (to convert src=4bit/12bit
@@with_extra_left_shift:                        ; to dst=8bit/16bit)
 str  r1,[r11,flacctx_extra_shift]              ;/
 ldr  r1,[r11,mp3ctx_stream_pos] ;pos           ;\
 ldr  r2,[r11,mp3ctx_stream_end] ;end           ;
 ldr  r3,[r11,mp3ctx_src_sample_rate]           ; calc bitrate
 sub  r2,r1                      ;siz           ; as
 mov  r2,r2,lsr (4-3) ;mul 8bit, div 10h ;siz*8/10h; filesize*8/duration
 umull r4,r5,r2,r3                              ; aka
 ldr  r6,[r11,flacctx_num_samples+0]      ;LSW  ; filesize*8*sample_rate/num_samples
 ldr  r7,[r11,flacctx_num_samples+4]      ;MSW  ;
 mov  r6,r6,lsr 4       ;\num samples div 10h      ; (with div 10h for 32bit maths)
 orr  r6,r7,lsl 32-4 ;/(convert 36bit to 32bit) ;
 bl   rom_div_r5r4_r6                           ;
 str  r4,[r11,mp3ctx_bit_rate]                  ;/
;- - -
 mov  r4,FLAC_SNIPPET_SIZE                      ;\
 ldr  r2,[r11,mp3ctx_dst_bytes_per_sample]      ;
 ldr  r3,[r11,mp3ctx_output_num_channels]       ; const (needed for DMA init)
 mul  r4,r2,r4                                  ;
 mul  r4,r3,r4                                  ;
 str  r4,[r11,mp3ctx_samples_output_size]       ;/
;- - -
 mov  r1,fmt_flac                               ;\okay, is flac
 str  r1,[r11,mp3ctx_layer]                     ;/
 ldr  r1,=flac_read_audio_frame                 ;\proc
 str  r1,[r11,mp3ctx_decode_proc]               ;/
;- - -
 b    @@chunk_next
;------------------
.pool
;------------------
;------------------
;:----------------- Keypad
;------------------
;------------------
process_user_input:   ;in: r11
 push lr
 ldr  r12,=global_fast_vars           ;-


 ldr  r1,[r12,key_rdptr]              ;\
 ldr  r2,[r12,key_wrptr]              ;
 cmp  r1,r2                           ;
 beq  @@keybuf_empty                  ;/
;- - -
 ldr  r1,[r12,key_rdptr]              ;\
 and  r4,r1,key_maskptr               ;
 add  r4,r12,r4,lsl 2                 ; fetch from keyboard queue
 ldr  r7,[r4,key_queue]      ;new     ;
 add  r1,1                            ;
 str  r1,[r12,key_rdptr]              ;/
 ldr  r6,[r12,key_rd_prev]   ;old     ;\and get/update prev key
 str  r7,[r12,key_rd_prev]   ;new     ;/
 ldr  r1,[r12,frame_counter]          ;\
 ldr  r2,[r12,random_value]           ;
 adds r2,r7,ror r1                    ; scatter random by button/time
 adc  r2,r1,ror r2                    ;
 str  r2,[r12,random_value]           ;
 bl   save_scatter_random             ;/
;- - -
;mov  r7,r7      ;current key
;mov  r6,r6      ;previous key
 ldr  r1,=current_window                ;\
 ldr  r9,[r1]                           ; window
 ldr  r10,[r9,win_tab_id]               ;/
;bl   redraw_req_none                   ;-redraw flags (initially none)
     ldr  r1,[r12,keyboard_active]        ;\
     cmp  r1,0                            ; DPAD controlled onscreen keyboard
     bne  @@handle_dpad_keyboard          ;/
 cmp  r7,Xkey_lt                        ;\                ;\
 moveq r4,-1                            ; tab bar, left   ; change window tab
 bleq  @@tab_left_right                 ;/                ; on left/right
 cmp  r7,Xkey_rt                        ;\                ; (but not when any
 moveq r4,+1                            ; tab bar, right  ; other keys pressed)
 bleq  @@tab_left_right                 ;/                ;/
;- - -
 cmp  r10,tab_id_help                   ;\
 beq  @@help_controls                   ;/
;- - -
 tst   r7,Xkey_a                        ;\
 tstne r7,Xkey_up+Xkey_dn               ; when A + up/down pressed,
 ldrne r1,[r12,key_dragflag]            ; and not already dragged,
 cmpne r1,1                             ; then
 ldrne r1,[r9,win_curr_file]    ;\      ; always mark dragged
 strne r1,[r9,win_org_file]     ;/      ; (even if up/down rejected because
 movne r1,1                     ;\      ; already being at begin/end of queue) (that, to avoid triggering play/pause on button A + rejected up/down)
 strne r1,[r12,key_dragflag]    ;/      ;/
;- - -
 tst   r7,Xkey_lt                       ;\
 tstne r7,Xkey_a                        ; when A + left pressed,
 beq   @@no_remove                      ; and playqueue, and not dragged,
 cmp   r10,tab_id_playqueue     ;\      ; then
 bne   @@no_remove              ;/      ; remove song from playqueue
 ldr   r1,[r12,key_dragflag]    ;\      ;
 cmp   r1,0                     ;       ;
 bne   @@no_remove              ;/      ;
 b     @@remove_from_playqueue          ;
@@no_remove:                            ;/
;- - -
 tst  r7,Xkey_dn                        ;\
 beq  @@not_down                        ;
 ldr  r1,[r9,win_curr_file]             ; key down
 ldr  r3,[r9,win_num_files]             ;
 ldr   r4,[r12,keystep] ;\              ;
 movs  r4,r4,lsr 4         ; fast step     ;
 moveq r4,1             ;/              ;
 add   r2,r1,r4 ;new=old+step           ;
 cmp  r3,0      ;cmp max,0         ;\   ;
 beq  @@not_down                   ;/   ;
 cmp  r2,r3     ;check max         ;\   ;
 subhs r2,r3,1  ;limit max         ;/   ;
 cmp  r2,r1     ;cmp new,old       ;\   ;
 beq  @@not_down                   ;/   ;
 str  r2,[r9,win_curr_file]        ;\   ;
 bl   redraw_req_list_cursor       ;/   ;
 ldr  r3,[r9,win_screen_cy]        ;\   ;
 subs r3,r2,r3        ;curr-cy     ;    ;
 add  r3,1            ;curr+1      ;    ;
 movmi r3,0                        ;    ;
 ldr   r0,[r9,win_scroll_pos]      ;    ;
 cmp   r3,r0                       ;    ;
 strhi r3,[r9,win_scroll_pos]      ;    ;
 blhi  redraw_req_list_sym_txt     ;/   ;
 tst  r7,Xkey_a                    ;\   ;
 movne r3,+4    ;step              ;    ;
 blne  @@drag_up_down              ;/   ;
 cmp   r10,tab_id_curr_option      ;\   ;
 bleq  @@apply_option              ;/   ;
@@not_down:                             ;/
 tst  r7,Xkey_up                        ;\
 beq  @@not_up                          ;
 ldr  r1,[r9,win_curr_file]             ; key up
 ldr   r4,[r12,keystep] ;\              ;
 movs  r4,r4,lsr 4         ; fast step     ;
 moveq r4,1             ;/              ;
 subs  r2,r1,r4 ;new=old-step           ;
 movmi r2,0     ;limit min              ;
 cmp  r2,r1     ;cmp new,old       ;\   ;
 beq  @@not_up                     ;/   ;
 str  r2,[r9,win_curr_file]        ;\   ;
 bl   redraw_req_list_cursor       ;/   ;
 ldr   r3,[r9,win_scroll_pos]      ;\   ;
 cmp   r2,r3                       ;    ;
 strlo r2,[r9,win_scroll_pos]      ;    ;
 bllo  redraw_req_list_sym_txt     ;/   ;
 tst  r7,Xkey_a                    ;\   ;
 movne r3,-4    ;step              ;    ;
 blne  @@drag_up_down              ;/   ;
 cmp   r10,tab_id_curr_option      ;\   ;
 bleq  @@apply_option              ;/   ;
@@not_up:                               ;/
 tst  r7,Xkey_a  ;curr  ;\              ;\
 bne  @@not_a           ; check if      ;
 tst  r6,Xkey_a  ;prev  ; key release   ; key A (on key release transition)
 beq  @@not_a           ;/              ;
 cmp  r10,tab_id_filelist       ;\      ;
 beq  @@add_to_playqueue        ;/      ;
   cmp  r10,tab_id_search         ;\    ;
   beq  @@add_search_to_playqueue ;/    ;
 cmp  r10,tab_id_options        ;\      ;
 beq  @@trigger_option          ;/      ;
 cmp  r10,tab_id_curr_option    ;\      ;
 beq  @@quit_curr_option        ;/      ;
;cmp  r10,tab_id_playqueue      ;\      ;
;beq  @@finish_drag_wipe        ;/      ;
;- - -                                  ;
;@@finish_drag_wipe:                    ;
 ldr  r1,[r12,key_dragflag]     ;\      ; ;\
 ldr  r2,[r12,key_wipeflag]     ;       ; ; when dragged/wiped, terminate drag
 orrs r1,r2                     ;       ; ; (but don't play/pause anything)
 bne  @@drag_done               ;/      ; ;/
 ldr  r1,[r9,win_curr_file]             ; ;\
 ldr  r2,[r9,win_active_file]           ; ; when newly selected,
 cmp  r1,r2                             ; ; play new song
 bne  @@play_newly_selected_song        ; ;/
 bl   toggle_play_pause_dma  ;in: r11   ; ;\when same as already active file,
 bl   redraw_req_list_sym               ; ; toggle play/pause
 b    @@done_a                          ; ;/
;---                                    ;
@@add_to_playqueue:        ;filelist    ;
@@add_search_to_playqueue: ;search      ;
 ldr  r1,[r9,win_curr_file]   ;index    ; ;\
 ldr  r2,[r9,win_num_files]   ;max      ; ; reject if curr>=num_files
 cmp  r1,r2                             ; ; (eg. if filelist empty)
 bhs  @@done_a                          ; ;/
 ldr  r1,[r12,key_dragflag]     ;\      ; ;\
 cmp  r1,0                      ;       ; ;
 moveq r4,1  ;num=1             ;       ; ;
 beq   @@add_single_file        ;/      ; ;/
@@retry_ordering:                       ; ;\
 ldr  r1,[r9,win_curr_file]     ;\      ; ; arrange as 1st=curr, last=org
 ldr  r2,[r9,win_org_file]      ;/      ; ; (otherwise swap curr/org)
 subs r4,r2,r1                          ; ;
 strlo r2,[r9,win_curr_file]            ; ;
 strlo r1,[r9,win_org_file]             ; ;
 blo   @@retry_ordering                 ; ;/
 add  r4,1   ;num = from curr to org+1  ; ;\
@@add_single_file:                      ; ;/add to playqueue...
   cmp  r10,tab_id_search         ;\    ; ;\check if search window
   bne  @@not_search_kick         ;/    ; ;/
     ldr  r1,[r9,win_curr_file]         ; ;
     cmp  r1,0   ;curr (0=new search)   ; ;
     bne  @@not_new_search              ; ;
     mov  r1,keytile_enter           ;\ ; ;
     str  r1,[r12,qwerty_curr_key]   ;/ ; ;
     bl   init_keyboard_oam_tiles    ;\ ; ;
     bl   freshen_keyboard_obj_keys  ;/ ; ;
     mov  r1,1                       ;\ ; ;
     str  r1,[r12,keyboard_active]   ;/ ; ;
     b    @@drag_done                   ; ;
    ;---                                ; ;
    @@not_new_search:                   ; ;
   bl   move_search_items_to_playqueue  ; ;\move from filelist to queue
   bl   redraw_req_list_sym             ; ; (or within queue if it was already in there)
   b    @@drag_done                     ; ;/and redraw "queued" symbols
  ;---                                  ;
  @@not_search_kick:                    ;
 bl   move_selected_files_to_playqueue  ; ;-add to playqueue & remove from filelist
 ldr  r1,[r9,win_scroll_pos]            ; ;\if scroll pos is higher than the
 ldr  r2,[r9,win_curr_file]             ; ; removed first file, adjust scroll
 cmp  r1,r2                             ; ; pos to the removed location
 strhi r2,[r9,win_scroll_pos]           ; ;/
 bl   redraw_req_list_full              ; ;-and redraw filelist (with removed item)
 b    @@drag_done                       ; ;-
;---                                    ;
@@drag_done:                            ;
 mov  r1,0                              ; ;\
 str  r1,[r12,key_dragflag]             ; ;
 str  r1,[r12,key_wipeflag]             ; ;
 b    @@done_a                          ; ;/
;---                                    ;
@@play_newly_selected_song:             ;
 str  r1,[r9,win_active_file]           ; ;\mark selected song as "next" song
 bl   set_play_this_flag                ; ; and terminate current song
 bl   abort_stop_playback_dma  ;in: r11 ; ;/
 b    @@done_a
;---
@@remove_from_playqueue:
 ldr  r1,[r9,win_curr_file]   ;index    ; ;\
 ldr  r2,[r9,win_num_files]   ;max      ; ; reject if curr>=num_files
 cmp  r1,r2                             ; ; (eg. if playqueue empty)
 bhs  @@done_a                          ; ;/
 ldr  r2,[r9,win_active_file]           ; ;\
 cmp  r1,r2                             ; ;
 blo  @@active_is_after_removed         ; ;
 bne  @@removed_isnt_active             ; ;
 bl   set_play_this_flag                ; ; ;\if curr=activ, then abort playback
 bl   abort_stop_playback_dma           ; ; ;/and mark the following as "next"
 b    @@finish_remove                   ; ;
@@active_is_after_removed:              ; ; ;\if active>curr then
 sub  r2,1    ;active-1                 ; ; ; decrease active-1
 str  r2,[r9,win_active_file]           ; ; ; and redraw up next
 bl   display_up_next_filename          ; ; ;/
@@removed_isnt_active:                  ; ;/
@@finish_remove:                        ;
 mov  r4,1  ;num = 1 (single file)      ; ;\add to filelist,
 bl   move_selected_files_to_filelist   ; ; and remove from playqueue
 bl   redraw_req_list_full              ; ; and redraw filelist (with removed item)
 mov  r1,1                      ;\      ; ; and set wipeflag (ignore following key A release transition)
 str  r1,[r12,key_wipeflag]     ;/      ; ;
 b    @@done_a                          ; ;/
;---
@@trigger_option:
 ldr  r1,[r9,win_curr_file]   ;index    ;\
 ldr  r4,[r9,win_addr_start]  ;base     ;
 ldr  r4,[r4,r1,lsl 2]  ;[base+index*4] ;
 ldr  r3,[r4,cfg_proc]                  ; ;\
 ldr  r2,[r4,cfg_sett]                  ; ;
 cmp  r2,0                              ; ; check if function or option
 beq  @@special_function_r3             ; ;/
 str  r3,[r12,current_option_proc]      ; ;\
 str  r2,[r12,current_option_sett]      ; ;
 bl   init_curr_option                  ; ; (WITHOUT changing "curr_tab_index")
 ldr  r9,=curr_option_info              ; ; curr_option subscreen
;- - -                                  ; ;/
@@switch_to_window_r9:                  ;
 ldr  r1,=current_window                ; ;\
 str  r9,[r1]                           ; ;
 ldr  r10,[r9,win_tab_id]               ; ;/
 bl   redraw_req_list_full              ; ;-
 b    @@drag_done                       ; ;-and discard drag (if any)
;---
@@quit_curr_option:
 ldr  r9,=options_info                  ;\go back to main options screen
 b    @@switch_to_window_r9             ;/
;---
@@special_function_r3:                  ; ;\
;ldr  r3,[r4,cfg_proc]    ;\apply proc  ; ; special function, direct exec
 bl   rom_bx_r3           ;/            ; ;/
 b    @@done_a                          ;/
;---
@@help_controls:  ;scroll directly, without moving cursor, and without button A
 tst  r7,Xkey_a                         ;\help, reject button A
 bne  @@done_a                          ;/
 tst  r7,Xkey_dn                        ;\
 beq  @@help_not_down                   ;
 ldr  r1,[r9,win_scroll_pos]       ;\   ;
 ldr  r2,[r9,win_num_files]        ;    ;
 ldr  r3,[r9,win_screen_cy]        ;    ; help, key down
 add  r1,1           ;y+1          ;    ;
 add  r3,r1,r3       ;y+cy         ;    ;
 cmp  r3,r2          ;y+cy, num    ;    ;
 strls r1,[r9,win_scroll_pos]      ;    ;
 blls  redraw_req_list_full        ;/   ;
@@help_not_down:                        ;/
 tst  r7,Xkey_up                        ;\
 beq  @@help_not_up                     ;
 ldr   r1,[r9,win_scroll_pos]      ;\   ;
 subs  r1,1                        ;    ; help, key up
 strpl r1,[r9,win_scroll_pos]      ;    ;
 blpl  redraw_req_list_full        ;/   ;
@@help_not_up:                          ;/
 b    @@done_a
;---
@@keybuf_empty:
;b    @@done_a
;- - -
@@done_a:                               ;
@@not_a:                                ;/
;- - -
 bl   handle_redraw_flags       ;--> redraw (if any)
 pop  pc        ;<-- this is MAIN return
;--- --- ---
    @@handle_dpad_keyboard:
     tst   r7,Xkey_lt+Xkey_rt+Xkey_up+Xkey_dn
     beq   @@no_dpad_key
     ldr   r1,[r12,qwerty_curr_key]   ;\
     bl    get_qwerty_key_map_r4      ;
     mov   r3,0                       ;
    @@find_key_ylop:                  ; find OLD key
     add   r3,0fh  ;\align 16         ; in array
     bic   r3,0fh  ;/                 ;
     add   r3,1        ;skip indent   ;
    @@find_key_xlop:                  ;
     ldrb  r2,[r4,r3]  ;get keytile   ;
     cmp   r2,0                       ;
     beq   @@find_key_ylop            ;
     cmp   r2,r1                      ;
     addne r3,1                       ;
     bne   @@find_key_xlop            ;/
     tst   r7,Xkey_up                 ;\
     beq   @@keyb_not_up              ;
     add   r1,r3,1                    ; up
     ldrb  r1,[r4,r1]                 ; (when in rightmost column,
     sub   r3,10h      ;up            ; steer up+right to stay in
     cmp   r1,00h                     ; rightmost column)
     addeq r3,1        ;right         ; (unless later trunc right)
    @@keyb_not_up:                    ;
     cmp   r3,0                       ;
     addmi r3,10h      ;undo          ;/
     tst   r7,Xkey_dn                 ;\
     addne r3,10h      ;add           ; down
     cmp   r3,4*10h                   ;
     subhs r3,10h      ;undo          ;/
     tst   r7,Xkey_lt                 ;\
     subne r3,1        ;sub           ; left
     tst   r3,0fh                     ;
     addeq r3,1        ;undo          ;/
     tst   r7,Xkey_rt                 ;\right
     addne r3,1        ;add           ;/
    @@trunc_right_lop:                ;\
     ldrb  r1,[r4,r3]                 ;
     cmp   r1,0                       ; trunc right
     subeq r3,1        ;stepback      ;
     beq   @@trunc_right_lop          ;/
    ;@@trunc_left_lop:                ;\
    ;ldrb  r1,[r4,r3]                 ;
    ;cmp   r1,keytile_deadskip        ; trunc left
    ;addeq r3,1        ;stepback      ;
    ;beq   @@trunc_left_lop           ;/
     ldrb  r1,[r4,r3]                 ;\
     str   r1,[r12,qwerty_curr_key]   ; apply
     push  r6,r7  ;--> key prev,curr  ; and
     bl    draw_touchscr_obj          ; redraw
     pop   r6,r7  ;<-- key prev,curr  ;/
    @@no_dpad_key:
    ;- - -
     ldr  r1,[r12,qwerty_curr_key]      ;\key A
     tst   r7,Xkey_a  ;curr             ; ;\key A pressed
     cmpne r1,keytile_enter             ; ; (trigger chars, BS, LT/RT, etc.)
     bne   @@process_text_input   ;-->  ; ;/(with key_repeat)
    ;- - -                              ;
     tst  r7,Xkey_a  ;curr ;\           ; ;\
     bne  @@done_a         ; check if   ; ;
     tst  r6,Xkey_a  ;prev ; key release; ; key A released
     beq  @@done_a         ;/           ; ; (handle ENTER key)
     cmp  r1,keytile_enter              ; ; (without key_repeat, and without
     bne  @@done_a                      ; ; further key_release action in
     bl   hide_keyboard                 ; ; parent window)
     mov  r1,0                       ;\ ; ;
     str  r1,[r12,keyboard_active]   ;/ ; ;/
     b    @@done_a                      ;/
  ;- - -
  @@process_text_input:
   push r1
   ldr  r2,[r12,curr_tab_index]         ;\
   mov  r1,tab_id_search                ;
   cmp  r1,r2   ;check if already       ;
   blne @@select_tab_r1                 ;/
   pop  r1
   bl   process_input_character_r1      ;-add char, and search
   bl   redraw_req_list_full            ;-display search results
   b    @@done_a
;--- --- ---
@@tab_left_right:
 cmp   r10,tab_id_curr_option           ;\on curr_option, force step=0
 moveq r4,0  ;step=0                    ;/(go back from curr_option to options)
 ldr  r1,[r12,curr_tab_index]           ;\
 add  r1,r4  ;add +/- step              ;
 cmp  r1,gui_num_tabs                   ;
 bxhs lr     ;tab_reject                ;/
;- - - - ---
@@select_tab_r1:
 push lr
 str  r1,[r12,curr_tab_index]       ;\  ;-
 ldr  r2,=gui_tab_list              ;   ;\
 ldr  r9,[r2,r1,lsl 2]              ;   ;
 ldr  r10,[r9,win_tab_id]           ;/  ;
 ldr  r1,=current_window                ;
 str  r9,[r1]                           ;/
 cmp  r10,tab_id_options                ;\for NDS, save changes (if any)
 blne save_config_options_on_tab_change ;/when leaving the options tab
 bl   redraw_req_list_full              ;-
     bl   gui_freshen_tab_bar_cursor    ;
 pop  pc     ;<-- this is a SUBFUNC return
;--- --- ---
@@apply_option:
 push r7-r10,lr
 ldr  r1,[r9,win_curr_file]             ;\
 ldr  r2,[r12,current_option_sett]      ; apply setting
 strb r1,[r12,r2]    ;option_xxx        ;/
 ldr  r3,[r12,current_option_proc]      ;\apply proc
 bl   rom_bx_r3                         ;/
 mov  r1,1                              ;\mark changed (need saving)
 str  r1,[r12,options_changed]          ;/
 bl   save_config_options_immediately   ;-save to SRAM
 pop  r7-r10,pc     ;<-- this is a SUBFUNC return
;--- --- ---
@@drag_up_down:     ;in: r1=old, r2=new, r3=step
 push lr
 cmp  r10,tab_id_playqueue              ;\allow drag only in playqueue
 bne  @@drag_ignore                     ;/
 ldr  r4,[r9,win_num_files]             ;\when EMPTY list,
 cmp  r4,0                              ; cursor may be at index 0,
 beq  @@drag_ignore                     ;/but there's no valid file there

 ldr  r4,[r9,win_active_file]           ;\
 cmp  r1,r4                             ;  ;\
 streq r2,[r9,win_active_file]          ;  ; if active=old, change active=new
 beq   @@this_active                    ;  ;/
 cmp   r4,r1                            ;  ;\
 cmplo r4,r2                            ;  ;
 blo   @@this_active                    ;  ; if active=moved entries, change that, too
 cmp   r4,r1                            ;  ;
 cmphi r4,r2                            ;  ;
 bhi   @@this_active                    ;  ;
 sub   r4,r3,asr 2                      ;  ;
 str  r4,[r9,win_active_file]           ;  ;/
@@this_active:                          ;/
 ldr  r4,[r9,win_addr_start]  ;base     ;\
 add  r1,r4,r1,lsl 2  ;old.addr         ;
 add  r2,r4,r2,lsl 2  ;new.addr         ;
 ldr  r0,[r1]         ;memorize old     ;
@@drag_lop:                             ;
 ldr  r4,[r1,r3]      ;\copy new        ;
 str  r4,[r1],r3      ;/to old          ;
 cmp  r1,r2                             ;
 bne  @@drag_lop                        ;
 str  r0,[r2]         ;new=old          ;/
 mov  r1,1                              ;\mark dragged
 str  r1,[r12,key_dragflag]             ; and need redraw
 bl   redraw_req_list_sym_txt           ;/
@@drag_ignore:
 pop  pc     ;<-- this is a SUBFUNC return
;------------------
;------------------
handle_redraw_flags:
;XXX if needed, this could use frameskip...
;        draw MAX once per frame
;        draw MIN once every 10 frames or so (or more often when CPU is IDLE)
;- - -
 push lr
 ldr  r10,[r12,redraw_flags]            ;\
 cmp  r10,0                             ; get redraw flags (if any)
 beq  @@redraw_done                     ;/
 tst  r10,drwflg_list_symbols+drwflg_list_cursor  ;\list symbols (play/pause/etc)
 blne gui_freshen_play_symbol                     ;/  (also redraw when cursor was moved, because filelist has a moving cursor symbol)
 tst  r10,drwflg_list_cursor                      ;\selection/cursor colors (palette)
 blne gui_freshen_selection_colors                ;/
 tst  r10,drwflg_list_text+(drwflg_list_cursor*target_3ds)  ;\list text (on 3DS: also redraw text if above palette has changed)
 blne display_file_window                                   ;/
 tst  r10,drwflg_rtc_vol_bat                      ;\RTC and volume/battery
 blne display_rtc_vol_bat                         ;/
 tst  r10,drwflg_cpu_load                         ;\
 blne display_cpu_load                            ;/
 tst  r10,drwflg_nn_nn_n                          ;\
 blne lcd_display_time_nn_nn_n                    ;/
         ldr  r1,[r12,redraw_flags]
         cmp  r1,r10   ;ensure r10 wasn't destroyed
         bne  org()

 mov  r1,0                              ;\ack
 str  r1,[r12,redraw_flags]             ;/
@@redraw_done:
 pop  pc
;------------------
redraw_req_list_cursor:
 push r1,lr
 ldr  r1,[r12,redraw_flags]
 orr  r1,drwflg_list_cursor
 str  r1,[r12,redraw_flags]
 pop  r1,pc
;---
redraw_req_list_sym:
 push r1,lr
 ldr  r1,[r12,redraw_flags]
 orr  r1,drwflg_list_symbols
 str  r1,[r12,redraw_flags]
 pop  r1,pc
;---
redraw_req_list_sym_txt:
 push r1,lr
 ldr  r1,[r12,redraw_flags]
 orr  r1,drwflg_list_symbols+drwflg_list_text
 str  r1,[r12,redraw_flags]
 pop  r1,pc
;---
redraw_req_list_full:
 push r1,lr
 ldr  r1,[r12,redraw_flags]
 orr  r1,drwflg_list_cursor+drwflg_list_symbols+drwflg_list_text
 str  r1,[r12,redraw_flags]
 pop  r1,pc
;---
redraw_req_r4:
 push r1,lr
 ldr  r1,[r12,redraw_flags]
 orr  r1,r4   ;drwflg_xxx
 str  r1,[r12,redraw_flags]
 pop  r1,pc
;------------------
;------------------
;------------------
gui_freshen_selection_colors:
 push lr
 ldr  r4,=current_window                ;\window
 ldr  r9,[r4]                           ;/
 ldr  r8,[r9,win_scroll_pos]            ;-topmost line number
 ldr  r4,[r9,win_screen_y1]             ;-topmost pixel yloc
 ldr  r5,[r12,screen_font_ysiz]         ;\topmost bgmap y
 bl   rom_div_r4_r5  ;y=y1/font_ysiz    ;/
 ldr  r6,[r9,win_screen_x1]
 ldr  r7,[r9,win_screen_x2]
 ldr  r2,[r9,win_screen_cy]             ;-window height (in characters)
 sub  r7,r6             ;width=x2-x1
 mov  r0,r6,lsr 3   ;x=x1/8             ;\
 orr  r0,r4,lsl bgs ;x+y*bgw            ; get bgmap addr
 ldr  r1,=mp3_vram_display_bgmap        ;
 add  r6,r1,r0,lsl 1 ;base+index*2      ;/
 ldr  r4,[r9,win_curr_file]

 ldr  r1,[r9,win_tab_id]                ;-
 cmp  r1,tab_id_help                    ;\special for help headlines
 beq  @@draw_help_colors                ;/
;- - -
 cmp  r1,tab_id_filelist                ;\
   cmpne r1,tab_id_search               ;
 ldreq r1,[r12,key_dragflag]            ; selection range
 cmpeq r1,1                             ; (can be multiple files
 ldreq r5,[r9,win_org_file]             ; in filelist & search window)
 movne r5,r4                            ;
 cmp   r4,r5    ;\                      ;
 movhi r1,r4    ; swap                  ;
 movhi r4,r5    ; if r5<r4              ;
 movhi r5,r1    ;/                      ;/
@@ylop:
 mov   r3,palette_1bpp_selected_0 << 12;\
 cmp   r8,r4                            ;
 movlo r3,palette_1bpp_text_0 << 12    ; wanted color for this line
 cmp   r8,r5                            ;
 movhi r3,palette_1bpp_text_0 << 12    ;/
 bl   @@want_line_color_r3              ;-draw (if needed)
 add  r6,bgw*2  ;bgmap                  ;\
 add  r8,1      ;line.no                ; next y
 subs r2,1                              ;
 bne  @@ylop                            ;/
@@done:
 pop  pc
;---
@@draw_help_colors:
 ldr  r1,[r9,win_addr_start]  ;base     ;\
 add  r8,r1,r8,lsl 2   ;base+scroll
@@help_ylop:
 ldr  r1,[r8]                           ;\
 ldrb r1,[r1,hlp_name]                  ;
 cmp  r1,'>'  ;headline marker          ; wanted color for this line
 moveq r3,palette_1bpp_selected_0 << 12;
 movne r3,palette_1bpp_text_0 << 12    ;/
 bl   @@want_line_color_r3              ;-draw (if needed)
 add  r6,bgw*2  ;bgmap                  ;\
 add  r8,4      ;list.addr              ; next y
 subs r2,1                              ;
 bne  @@help_ylop                       ;/
 b    @@done
;--- --- ---
@@want_line_color_r3:
 ldrh r0,[r6]        ;[bgmap]           ;-current color of this line
 eor  r0,r3                             ;\
 ands r0,0ch << 12  ;palette.msbs      ; check color diff
 beq  @@same_palette                    ;/
 mov  r3,r7,lsr 3    ;width/8           ;\
@@xlop:                                 ;
 ldrh r1,[r6]                           ; draw changed color
 eor  r1,r0          ;palette.msbs      ;
 strh r1,[r6],2                         ;
 subs r3,1                              ;
 bne  @@xlop                            ;
 sub  r6,r7,lsr 2  ;stepback width*2/8  ;/
@@same_palette:
 bx   lr
;------------------
;------------------
;:----------------- Mp3 code main
;------------------
.align code_align
mp3_decode_frame:       ;in: r6=dst, [mp3ctx_stream_pos]=src
   ldr  pc,[r11,mp3ctx_decode_proc]
;------------------
mp3_clear_context:
 push lr
 mov  r4,r11  ;mp3_context_x                    ;\
 ldr  r5,=mp3ctx_context_size                   ; clear context
 bl   rom_generic_zerofill                      ;/
 ldr  r4,=mp3_sb_samples                        ;\clear samples
 mov  r5,(MP3_MAX_CHANNELS*36*SBLIMIT)*4        ; bugfix 4/2025 needed for with_cut_off combined with .zip file that contains .mp3's with different sample rates
 bl   rom_generic_zerofill                      ;/    XXX alternately, could maybe force "mp3gr_num_nonzero_hybrids" to max or so?

   ldr  r3,=mp3_context_0
   cmp  r3,r11
   bne  org()       ;oops, not ctx0
   ldr  r4,=mp3ctx0_synth_buf
   ldr  r5,=mp3ctx0_mdct_buf
   ldr  r6,=mp3ctx0_main_data_pool_buf
   str  r4,[r11,mp3ctx_synth_base]
   str  r5,[r11,mp3ctx_mdct_base]
   str  r6,[r11,mp3ctx_main_data_pool_base]
   ldr  r4,=mp3ctx0_start                       ;\
   mov  r5,mp3ctx0_siz                          ; clear
   bl   rom_generic_zerofill                    ;/
    ldr  r4,=mp3gr0_sb_hybrid_buf
    ldr  r5,=mp3gr1_sb_hybrid_buf
    ldr  r6,=mp3gr2_sb_hybrid_buf
    ldr  r7,=mp3gr3_sb_hybrid_buf
    ldr  r10,=mp3_granules
    str  r4,[r10,mp3gr_sb_hybrid_base]
    str  r5,[r10,mp3gr_sb_hybrid_base+mp3gr_entrysiz*1]
    str  r6,[r10,mp3gr_sb_hybrid_base+mp3gr_entrysiz*2]
    str  r7,[r10,mp3gr_sb_hybrid_base+mp3gr_entrysiz*3]
        ;;; ldr  r4,=mp3gr0_sb_hybrid_buf
        ;;; mov  r5,SBLIMIT*18*4 * 4
        ;;; bl   rom_generic_zerofill

   ldr  r4,[r11,mp3ctx_main_data_pool_base]
 str  r4,[r11,mp3ctx_main_data_pool_wr_ptr]     ;/

          mov  r3,2 >> force_8bit
          str  r3,[r11,mp3ctx_dst_bytes_per_sample]


          mov  r3,1
          str  r3,[r11,mp3ctx_option_mono]

 pop  pc
;------------------
mp3_init:
 push lr
;- - -
 ldr  r4,=mp3_initialized                       ;\
 ldr  r4,[r4]                                   ;
 cmp  r4,0                                      ;
 bne  @@already_initialized                     ;/
 timelog_start rdtsc_init
   ldr  r4,=mp3_kernel_reloc_src                ;\
   ldr  r5,=mp3_kernel_reloc_dst                ; reloc kernel
   ldr  r6,=mp3_kernel_reloc_siz                ;
   bl   rom_dma3_memcopy                        ;/
   ldr  r4,=init_reloc_src                      ;\
   ldr  r5,=init_reloc_dst                      ; reloc init functions
   ldr  r6,=init_reloc_siz                      ;
   bl   rom_dma3_memcopy                        ;/
 bl   get_default_options  ;before load options ;\get defaults or saved options
 bl   load_config_options  ;before init_gui     ;/
 bl   save_scatter_random  ;after load_options  ;/
 ldr  r12,=global_fast_vars             ;\
 mov  r1,tab_id_playqueue           ;\  ;
 str  r1,[r12,curr_tab_index]       ;   ; initial window focus
 ldr  r2,=gui_tab_list              ;   ;
 ldr  r2,[r2,r1,lsl 2]              ;/  ;
 ldr  r1,=current_window                ;
 str  r2,[r1]                           ;/
 bl   init_gui                                  ;-init video gui
 ldr  r3,=mp3_init_core                         ;\init mp3
 bl   rom_bx_r3                                 ;/


 ldr  r4,=mp3_initialized                       ;\
 mov  r5,1                                      ; done
 str  r5,[r4]                                   ;/
 timelog_end rdtsc_init;\
   ldr  r5,=txt_time_init                               ;
   bl   tty_wrstr_r5                                    ; display
   ldr  r4,=rdtsc_init                                  ; inititialization time
   ldr  r4,[r4]                                         ;
   scale_clks_r5r4                                      ;
   bl   tty_decimal_r4_with_thousands_separator         ;
   bl   tty_wrcrlf                                      ;
@@already_initialized:
 bl   mp3_clear_context
 pop  pc
;------------------
mp3_check_1st_frame:    ;io: [mp3ctx_stream_pos],[mp3ctx_stream_end]
 push lr
  ;mov  r3,0                                    ;\initially no upsampling
  ;str  r3,[r11,mp3ctx_upsample_shift]          ;/
   mov  r3,1                                    ;\initially no upsampling
   str  r3,[r11,mp3ctx_upsample_fac]            ;/
 bl   mp3_exclude_tag_footers                   ;-strip TAG footer(s)
 bl   mp3_exclude_id3_headers                   ;-strip ID3 header(s) (after footer, so bitstream reading can continously resume after header)
   bl   detect_wav_file                         ; alternate WAV format
   beq  @@this_file                             ;
   bl   detect_aiff_file                        ; alternate AIFF format
   beq  @@this_file                             ;
   bl   detect_au_file                          ; alternate AU format
   beq  @@this_file                             ;
   bl   detect_flac_file                        ; alternate FLAC format
   beq  @@this_file                             ;
 ldr  r1,=mp3_decode_mpeg_audio_frame           ;\
 str  r1,[r11,mp3ctx_decode_proc]               ;/
;- - -
 mov  r4,0  ;THIS_RATE_SHIFT                    ;\XXX somehow needed BEFORE checking 1st frame
 str  r4,[r11,mp3ctx_option_mono]               ;
 str  r4,[r11,mp3ctx_option_rate_shift]         ;/    (but in future, it should be auto-selected AFTER 1st frame)
;- - -
@@retry_1st_frame:
   mov  r5,0                                    ; force none (to retrigger hdr even if next is same)
   str  r5,[r11,mp3ctx_hdr_32bit_header]        ;

 ldr  r3,[r11,mp3ctx_stream_pos]   ;\memorize   ;\
 push r3                           ;/1st        ;
 mov  r6,0                              ;dst=0  ; decode frame header, get sample rate
 bl   mp3_decode_frame                          ; (no data decode since dst=0)
 pop  r3                           ;\restore    ;
 str  r3,[r11,mp3ctx_stream_pos]   ;/1st        ;
 bne  @@error                                   ;/
 bl   decide_rate_shift_and_mono                ;\
 bne  @@retry_1st_frame                         ;/
;- - -
@@this_file:
   bl   mp3_decide_upsampling                   ;-
   ldr  r3,[r11,mp3ctx_layer]                   ;
   ldr  r4,=mp3_decoder_reloc_src       ;\      ;
   ldr  r5,=mp3_decoder_reloc_dst       ;       ; decoder (mp1mp2 or mp3)
   ldr  r6,=mp3_decoder_reloc_siz       ; mp3   ;
   cmp  r3,fmt_mp3                      ;       ;
   beq  @@reloc_this                    ;/      ;
     ldr  r4,=mp1mp2_decoder_reloc_src  ;\      ;
     ldr  r5,=mp1mp2_decoder_reloc_dst  ;       ;
     ldr  r6,=mp1mp2_decoder_reloc_siz  ; mp1   ;
     cmp   r3,fmt_mp1                   ; mp2   ;
     cmpne r3,fmt_mp2                   ;       ;
     beq   @@reloc_this                 ;/      ;
     ldr  r4,=flac_decoder_reloc_src    ;\      ;
     ldr  r5,=flac_decoder_reloc_dst    ;       ;
     ldr  r6,=flac_decoder_reloc_siz    ; flac  ;
     cmp  r3,fmt_flac                   ;       ;
     beq  @@reloc_this                  ;/      ;
     ldr  r4,=misc_decoder_reloc_src    ;\wav   ;
     ldr  r5,=misc_decoder_reloc_dst    ; aiff  ;
     ldr  r6,=misc_decoder_reloc_siz    ; au    ;
    ;cmp  r3,<various variants>         ;/      ;
  @@reloc_this:                                 ;
   bl   rom_dma3_memcopy                        ;
 ldr  r4,[r11,mp3ctx_option_rate_shift]         ;\
 ldr  r9,=synth_proc_list                       ;
 add  r9,r4,lsl 4                               ; synth proc (vs rate_shift)
 ldr  r3,[r9,00h]       ;proc                   ;
 str  r3,[r11,mp3ctx_synth_filter_proc]         ;
   ldr  r4,[r9,04h]       ;src                  ;        (not wav/aiff/au/flac)
   ldr  r5,[r9,08h]       ;dst                  ;
   ldr  r6,[r9,0ch]       ;siz                  ;
   bl   rom_dma3_memcopy                        ;

  bl   mp3_check_xing_info             ;-check variable bitrate xing info
  bl   mp3_calc_assumed_duration       ;-calc assumed song duration
   bl   tty_wrcrlf                              ;-      ;\
   ldr  r5,=txt_file_name                       ;\      ;
   bl   tty_wrstr_r5                            ;/      ; file name
   ldr  r5,[r11,mp3ctx_src_fname]               ;\      ;
   bl   tty_wrstr_r5                            ;/      ;
   bl   tty_wrcrlf                              ;-      ;/
   ldr  r5,=txt_file_size                       ;\      ;\
   bl   tty_wrstr_r5                            ;/      ;
   ldr  r4,[r11,mp3ctx_file_size]               ;\      ;
   bl   tty_decimal_r4_with_thousands_separator ;/      ; file and ID3/TAG sizes
   ldr  r5,=txt_id3_size                        ;\      ;
   bl   tty_wrstr_r5                            ;/      ;
   ldr  r4,[r11,mp3ctx_id3_size]                ;\      ; ;<-- this may be up to 1.46 Mbyte in vandalized mp3 files (with hires lossless png bitmaps)
   bl   tty_decimal_r4_with_thousands_separator ;/      ;
   ldr  r5,=txt_tag_size                        ;\      ;
   bl   tty_wrstr_r5                            ;/      ;
   ldr  r4,[r11,mp3ctx_tag_size]                ;\      ;
   bl   tty_decimal_r4_with_thousands_separator ;/      ;
   bl   tty_wrcrlf                                      ;/
   ldr  r5,=txt_input                           ;\      ;\
   bl   tty_wrstr_r5                            ;/      ;
   ldr  r4,[r11,mp3ctx_src_sample_rate]         ;\      ;
   bl   tty_decimal_r4                          ; hz    ; input
   ldr  r5,=txt_hz                              ;       ;
   bl   tty_wrstr_r5                            ;/      ;
   ldr  r4,[r11,mp3ctx_src_num_channels]        ;\      ;
   bl   tty_decimal_r4                          ; ch    ;
   ldr  r5,=txt_channels                        ;       ;
   bl   tty_wrstr_r5                            ;/      ;
   ldr  r4,[r11,mp3ctx_src_bits_per_sample]     ;\      ;
   cmp  r4,0                                    ;       ;
   beq  @@compressed_dont_show_bits             ; bits  ;
   bl   tty_decimal_r4                          ; (for  ;
   ldr  r5,=txt_bit                             ; wav   ;
   bl   tty_wrstr_r5                            ; or    ;
   bl   tty_wrcomma                             ; aiff) ;
   bl   tty_wrspc                               ;       ;
  @@compressed_dont_show_bits:                  ;/      ;
   ldr  r4,[r11,mp3ctx_bit_rate]                ;\      ;
   mov  r5,1000                                 ;       ;
   bl   rom_div_r4_r5                           ; kbits ;
   bl   tty_decimal_r4                          ;       ;
   ldr  r5,=txt_kbit_s                          ;       ;
   bl   tty_wrstr_r5                            ;/      ;
     bl   tty_wrcomma                           ;\      ;
     bl   tty_wrspc                             ;       ;
     ldr  r4,[r11,mp3ctx_layer]                 ;       ;
     ldr  r5,=fmt_layer_proc_names+4            ; layer ;
     add  r5,r4,lsl 4                           ;       ;
     bl   tty_wrstr_r5                          ;/      ;
   ldr  r5,=txt_src_ms1                         ;\      ;
   bl   tty_wrstr_r5                            ;       ;
   ldr  r4,[r11,mp3ctx_src_milliseconds]        ; ms    ;
   bl   tty_decimal_r4_with_thousands_separator ;       ;
   ldr  r5,=txt_src_ms2                         ;       ;
   bl   tty_wrstr_r5                            ;/      ;
   bl   tty_wrcrlf                                      ;/
   ldr  r5,=txt_output                          ;\      ;\
   bl   tty_wrstr_r5                            ;/      ;
   ldr  r4,[r11,mp3ctx_output_sample_rate]      ;\      ;
    ;ldr  r3,[r11,mp3ctx_upsample_shift]        ;       ;
    ;mov  r4,r4,lsr r3                          ;       ;
     ldr  r5,[r11,mp3ctx_upsample_fac]          ;       ;
     bl   rom_div_r4_r5                         ;       ;
   bl   tty_decimal_r4                          ;       ; output
   ldr  r5,=txt_hz                              ;       ;
   bl   tty_wrstr_r5                            ;/      ;
   ldr  r4,[r11,mp3ctx_output_num_channels]     ;\      ;
   bl   tty_decimal_r4                          ;       ;
   ldr  r5,=txt_channels                        ;       ;
   bl   tty_wrstr_r5                            ;/      ;
   ldr  r4,[r11,mp3ctx_dst_bytes_per_sample]    ;\      ;
   mov  r4,r4,lsl 3   ;mul8                     ;       ;
   bl   tty_decimal_r4                          ;       ;
   ldr  r5,=txt_bit                             ;       ;
   bl   tty_wrstr_r5                            ;/      ;
    ;ldr  r3,[r11,mp3ctx_upsample_shift]        ;\      ;
    ;cmp  r3,0                                  ;       ;
     ldr  r3,[r11,mp3ctx_upsample_fac]          ;\      ;
     cmp  r3,1                                  ;       ;
     beq  @@no_upsample                         ;       ;
     ldr  r5,=txt_upsampled                     ;       ;
     bl   tty_wrstr_r5                          ;       ;
     ldr  r4,[r11,mp3ctx_output_sample_rate]    ;       ;
     bl   tty_decimal_r4                        ;       ;
     bl   tty_wrstr_r5                          ;       ;
    @@no_upsample:                              ;/      ;
   bl   tty_wrcrlf                                      ;/
     ldr  r4,[r11,mp3ctx_layer]
     cmp  r4,fmt_flac
     bne  @@not_flac
     ldr  r5,=txt_flac_block_size                 ;\      ;\
     bl   tty_wrstr_r5                            ;       ;
     ldr  r4,[r11,flacctx_hdr_min_blksize]        ; block ;
     bl   tty_decimal_r4_with_thousands_separator ; size  ; flac
     ldr  r5,=txt_flac_thru                       ; min   ; min/max sizes,
     bl   tty_wrstr_r5                            ; -     ; as declared in hdr
     ldr  r4,[r11,flacctx_hdr_max_blksize]        ; max   ;
     bl   tty_decimal_r4_with_thousands_separator ;/      ; (NOTE: the LAST
     ldr  r5,=txt_flac_frame_size                 ;\      ; block may be
     bl   tty_wrstr_r5                            ;       ; SMALLER than MIN)
     ldr  r4,[r11,flacctx_hdr_min_framesize]      ; frame ;
     bl   tty_decimal_r4_with_thousands_separator ; size  ;
     ldr  r5,=txt_flac_thru                       ; min   ;
     bl   tty_wrstr_r5                            ; -     ;
     ldr  r4,[r11,flacctx_hdr_max_framesize]      ; max   ;
     bl   tty_decimal_r4_with_thousands_separator ;/      ;
     bl   tty_wrcrlf                                      ;/
    @@not_flac:
 ldr  r1,[r11,mp3ctx_bit_rate]          ;\average bitrate
 str  r1,[r11,mp3ctx_avg_bit_rate]      ;/(for vbr xing info)
 movs r4,0    ;okay
 pop  pc
;---
@@error:
 movs r4,1    ;bad
 pop  pc
;------------------
decide_rate_shift_and_mono:
        ;XXX could also recurse following (minor) things:
        ;      layer (mp1/mp2 is a good bit faster than mp3)
        ;      bitrate (can have some small effect)
        ;      src_sample_rate (can have some small effect, even when output_sample_rate is lower)
        ;      decode_num_channels (which MAY envolve L/R which can slowdown STEREO-to-MONO decoding)
        ;    that, versus the actual (or estimated) CPU speed
        ;- - -
 mov   r4,0     ;initially no retry needed
 ldr   r5,[r11,mp3ctx_output_sample_rate]       ;\
 ldr   r6,[r11,mp3ctx_output_num_channels]      ;/
   ldr   r12,=global_fast_vars
   ldrb  r7,[r12,option_quality]
     mov   r1,32000  ;-maxrate (when mono)                          ;\
     subs  r2,r7,1   ;\reduce maxrate                               ; maxrate
     movhi r1,r1,lsr r2 ;/                                             ;/
     cmp   r6,1                                                     ;\
     beq   @@is_mono                                                ;
     cmp   r7,1                                                     ;
     blo   @@keep_stereo    ;HQ.stereo --> always stereo            ; decide
     bhi   @@force_mono     ;lowpower --> always mono               ; mono
     cmp   r5,r1,lsr 1      ;cmp maxrate/2                          ;
     bls   @@keep_stereo    ;HQ.mono --> allow lowfreq stereo       ;
    @@force_mono:                                                   ;
     mov   r4,1     ;need retry                                     ;
     str   r4,[r11,mp3ctx_option_mono]                              ;
     b     @@is_mono                                                ;
    ;---                                                            ;
    @@keep_stereo:                                                  ;
     mov   r1,r1,lsr 1         ;limit maxrate/2 for stereo             ;
    @@is_mono:                                                      ;/
  @@rate_lop:                                                     ;\
   cmp   r5,r1    ;rate,maxrate                                   ;
   ldrhi r7,[r11,mp3ctx_option_rate_shift]                        ; decide
   addhi r7,1     ;raise                                          ; rate shift
   strhi r7,[r11,mp3ctx_option_rate_shift]                        ;
   movhi r4,1     ;need retry                                     ;
   movhi r5,r5,lsr 1 ;rate halved                                    ;
   bhi   @@rate_lop                                               ;/
 cmp   r4,0     ;out: nz=need retry             ;-return zf
 bx    lr
;------------------
mp3_decide_upsampling:
 ldr  r9,=@@upsample_fac_proc_list                    ;\
@@upsample_lop:                                       ; win98 can play 8000Hz,
 ldr  r4,[r11,mp3ctx_src_sample_rate]                 ; but ignores lower rates
 ldmia [r9]!,r7,r8      ;fac,proc                     ; like 5kHz, as workaround,
 mul  r4,r7,r4                                        ; mul2 until it's 8000h
   ldr  r3,[r11,mp3ctx_option_rate_shift]             ;
   mov  r4,r4,lsr r3                                     ; gba/nds/dsi/etc. can
 cmp  r4,8000                                         ; interpolated upsampling
 bhs  @@upsample_this                                 ; sounds better, so do
;ldr  r3,[option_upsample]            ;\              ; it there, too.
;cmp  r3,0                            ;               ;
;beq  @@upsample_this                 ;/              ;
 cmp  r7,8              ;max                          ;
 blo  @@upsample_lop                                  ;
@@upsample_this:                                      ;
 str  r4,[r11,mp3ctx_output_sample_rate]              ;
   ldr  r4,[r11,mp3ctx_samples_output_size]
   mul  r4,r7,r4    ;XXX assuming old size did have fac=1
   str  r4,[r11,mp3ctx_samples_output_size]
 str  r7,[r11,mp3ctx_upsample_fac]                    ;
 str  r8,[r11,mp3ctx_upsample_core]        ;<--       ;/
          ldr  r3,=upsample_none           ;\
          cmp  r3,r8                       ;
          beq  @@no_stereo_hook  ;none     ;
          ldr  r3,[r11,mp3ctx_output_num_channels]
          cmp  r3,1                        ;
         ;beq  @@no_stereo_hook  ;mono     ;
          ldrne r8,=upsample_stereo_hook   ;
         @@no_stereo_hook:                 ;/
 str  r8,[r11,mp3ctx_upsample_proc]        ;<--       ;/

 ldr  r0,=808080h                                     ;\
 str  r0,[r11,mp3ctx_upsample_recent]                 ;/

 bx   lr
;---
 ;.code   ;or .const
  .align 4
  @@upsample_fac_proc_list:
   dd 1 ,upsample_none
   dd 2 ,upsample_2x
  ;dd 3 ,upsample_3x     ;XXX 3x (conflicts with GBA 16-byte DMA size)
   dd 4 ,upsample_4x
  ;dd 6 ,upsample_6x     ;XXX 6x (conflicts with GBA 16-byte DMA size)
   dd 8 ,upsample_8x
  ;dd 16,upsample_16x  ;\none such (could be needed for 8kHz files further divided by div16 or div32, but that would leave most of the song inaudible, and the 8x uplsampling is good enough for the few remaining sunnds, in particular, 8x is enough to remove noisy sharp edges)
  ;dd 32,upsample_32x  ;/          (XXX or is that still NEEDED for GBA 16-byte DMA size?)
 ;.code
;------------------
;note: the main public functons are:
;  mp3_init            ;to be called once
;  mp3_check_1st_frame ;to be called before playback
;  mp3_decode_frame    ;to be called each frame
;------------------
;:----------------- End of Main
;------------------
.align 4
.pool
lastline:
rom_code_data_end:
.definelabel rom_code_data_siz, org()-rom_code_data_start
;------------------

