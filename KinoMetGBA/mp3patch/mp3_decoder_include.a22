@@lop:                    ;Gauss PSX
        ;00h
        ;08h x
        ;20h xxxx
        ;60h xxxxxxxxxxxx
        ;98h xxxxxxxxxxxxxxxxxxx
        ;C0h xxxxxxxxxxxxxxxxxxxxxxxx
 ldrb r3,[r12],1        ;new
 xor  r3,80h            ;make unsigned (faster because "r2+steps" won't flip sign, and thus doesn't neeed three AND FFh's)
 add  r0,r2,r1,lsl 2  ;r2*01h+r1*04h    ;\
 add  r0,r0,r0,lsl 1  ;r2*03h+r1*0Ch    ;
 add  r0,r0,r2,lsl 4  ;r2*13h+r1*0Ch    ; (A*60h+B*98h+C*08h)/100h
 add  r0,r0,r3        ;r2*13h+r1*0Ch+r3 ;
 xor  r4,r10,r0,lsr 5                   ;/
 strb r4,[r9],1                         ;-output
 add  r0,r2,r2,lsl 1  ;r2*3             ;\
 add  r0,r1,r0,lsl 1  ;r2*6+r1          ; (A*20h+B*C0h+C*20h)/100h
 add  r0,r3           ;r2*6+r1+r3       ;
 xor  r4,r10,r0,lsr 3                   ;/
 strb r4,[r9],1                         ;-output
 add  r0,r2,r3,lsl 2  ;r2*01h+r3*04h    ;\
 add  r0,r0,r0,lsl 1  ;r2*03h+r3*0Ch    ;
 add  r0,r0,r2,lsl 4  ;r2*13h+r3*0Ch    ; (A*08h+B*98h+C*60h)/100h
 add  r0,r0,r1        ;r2*13h+r3*0Ch+r1 ;
 xor  r4,r10,r0,lsr 5                   ;/
 strb r4,[r9],1                         ;-output
 mov  r1,r2  ;\shuffle prev values (alternately keep them in place, and use opcodes with different registers in each step)
 mov  r2,r3  ;/
 subs lr,3
 bhi  @@lop
;blo  $        ;oops
 orr  r1,r2,lsl 8                               ;\end of curr block
 str  r1,[r11,mp3ctx_upsample_recent]           ;/
 timelog_end rdtsc_upsampler
 pop  r9,r12,pc
