;------------------
.align data_align
mp3_huff_data:  ;byte[32]    ;LSBs=table,MSBs=linbits
 db 0      ;<-- zero
 db 1
 db 2
 db 3
 db 0      ;<-- zero, not used
 db 4
 db 5
 db 6
 db 7
 db 8
 db 9
 db 10
 db 11
 db 12
 db 0      ;<-- zero, not used
 db 13
 db 14+10h*1       ;\
 db 14+10h*2       ;
 db 14+10h*3       ; tree 14, with 1..13 linbits
 db 14+10h*4       ;
 db 14+10h*6       ;
 db 14+10h*8       ;
 db 14+10h*10      ;
 db 14+10h*13      ;/
 db 15+10h*4       ;\
 db 15+10h*5       ;
 db 15+10h*6       ; tree 15, with 4..13 linbits
 db 15+10h*7       ;
 db 15+10h*8       ;
 db 15+10h*9       ;
 db 15+10h*11      ;
 db 15+10h*13      ;/
