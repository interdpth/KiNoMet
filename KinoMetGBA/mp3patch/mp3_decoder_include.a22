   xor  r3,r2,r10         ;make signed
   stmia [r6]!,r1,r3
   ldrb r4,[r7],1         ;new
   xor  r4,80h            ;make unsigned (faster because "sub new,diff" won't flip sign, and thus doesn't neeed seven AND FFh's)
   sub  r5,r4,r2,lsr 24   ;diff=new-old
   mov  r3,r2,lsr 24      ;old
   add  r1,r3,r5,asr 3    ;old+(1/8)
   add  r2,r1,r5,asr 2    ;old+(3/8)
   add  r3,r1,r5,asr 1    ;old+(5/8)
   orr  r1,r1,lsl 8
   orr  r1,r2,lsl 16
   orr  r1,r3,lsl 24
   sub  r2,r4,r5,asr 3    ;new-(7/8)
   orr  r2,r2,lsl 8
   orr  r2,r4,lsl 16
   orr  r2,r4,lsl 24
