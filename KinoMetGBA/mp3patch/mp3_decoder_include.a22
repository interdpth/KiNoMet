 ;3040h..309Fh    Japanese Hiragana
 ;30A0h..30FFh    Japanese/Ainu Katakana
 ;3100h..312Fh    Chinese phonetic Bopomofo
 ;A720h..A7FFh    Latin Extended-D
 ;AB30h..AB6Fh    Latin Extended-E
 ;10780h..107BFh  Latin Extended-F
 ;1D2C0h..1D2Dxh  Kaktovik Numerals (base 20)
 ;1DF00h..1DFFFh  Latin Extended-G
 ;---
 ;SORTCODE_GAP
 ;---
.align 4
