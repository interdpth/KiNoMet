;------------------
gui_palette_list:
 dd gui_palette_data_blue
 dd gui_palette_data_gray
 dd gui_palette_data_green
 dd gui_palette_data_orange
 dd gui_palette_data_fruit
 dd gui_palette_data_white
;------------------
gui_palette_data_blue:
 ;--blue     green   red
 dw 00h*400h+00h*20h+00h
 color_text_black   equ 00h;text/background (must be color 0 backdrop)
 dw 12h*400h+0ch*20h+0ch
 color_border_dark  equ 01h;border
 dw 16h*400h+10h*20h+10h
 color_border_med   equ 02h;border
 dw 1ah*400h+14h*20h+14h
 color_border_light equ 03h;border
 dw 1fh*400h+1ch*20h+1ch
 color_border_white equ 04h;border
 dw 00h*400h+00h*20h+00h
 color_border_black equ 05h;border
 dw 1fh*400h+00h*20h+1fh
 color_06h          equ 06h;  (unused)
 dw 00h*400h+10h*20h+1ch
 color_orange       equ 07h;  (unused)
 dw 00h*400h+18h*20h+18h
 color_yellow       equ 08h;  (unused)
 dw 00h*400h+1ch*20h+10h
 color_greenish     equ 09h;  (unused)
 dw 0ch*400h+0ch*20h+1fh
 color_red          equ 0ah;symbol/playqueue (tile_left_border_play and tile_left_border_pause)
 dw 00h*400h+1fh*20h+00h
 color_green        equ 0bh;symbol/filelist
 dw 1fh*400h+10h*20h+0ch
 color_blue         equ 0ch;symbol/options
 dw 1fh*400h+1fh*20h+1fh
 color_text_bright  equ 0dh;text/bright (for selection)
 dw 1fh*400h+18h*20h+10h
 color_text_normal  equ 0eh;text/normal (for normal text) (and for progress bar and NN:NN.n digits) (tile_left_border_progress and tile_right_border_progress)
 dw 1fh*400h+10h*20h+0ch
 color_text_dark    equ 0fh;text/dark   (for tech info)
                             color_obj_caret equ 0fh  ;<-- in OBJ palette
;------------------
gui_palette_data_gray:
 ;--blue     green   red
 dw 00h*400h+00h*20h+00h   ; color_text_black   equ 00h  ;text/background (must be color 0 backdrop)
 dw 0ch*400h+0ch*20h+0ch ;*; color_border_dark  equ 01h  ;border
 dw 10h*400h+10h*20h+10h ;*; color_border_med   equ 02h  ;border
 dw 14h*400h+14h*20h+14h ;*; color_border_light equ 03h  ;border
 dw 1ch*400h+1ch*20h+1ch ;*; color_border_white equ 04h  ;border
 dw 00h*400h+00h*20h+00h   ; color_border_black equ 05h  ;border
 dw 1fh*400h+00h*20h+1fh   ; color_06h          equ 06h  ;  (unused)
 dw 00h*400h+10h*20h+1ch   ; color_orange       equ 07h  ;  (unused)
 dw 00h*400h+18h*20h+18h   ; color_yellow       equ 08h  ;  (unused)
 dw 00h*400h+1ch*20h+10h   ; color_greenish     equ 09h  ;  (unused)
 dw 0ch*400h+0ch*20h+1fh   ; color_red          equ 0ah  ;symbol/playqueue (tile_left_border_play and tile_left_border_pause)
 dw 00h*400h+1fh*20h+00h   ; color_green        equ 0bh  ;symbol/filelist
 dw 1fh*400h+10h*20h+0ch   ; color_blue         equ 0ch  ;symbol/options
 dw 1fh*400h+1fh*20h+1fh ;*; color_text_bright  equ 0dh  ;text/bright (for selection)
 dw 18h*400h+18h*20h+18h ;*; color_text_normal  equ 0eh  ;text/normal (for normal text) (and for progress bar and NN:NN.n digits) (tile_left_border_progress and tile_right_border_progress)
 dw 10h*400h+10h*20h+10h ;*; color_text_dark    equ 0fh  ;text/dark   (for tech info)
;------------------
gui_palette_data_green:
 ;--blue     green   red
 dw 00h*400h+00h*20h+00h   ; color_text_black   equ 00h  ;text/background (must be color 0 backdrop)
 dw 00h*400h+0ch*20h+00h ;*; color_border_dark  equ 01h  ;border
 dw 00h*400h+10h*20h+00h ;*; color_border_med   equ 02h  ;border
 dw 00h*400h+14h*20h+00h ;*; color_border_light equ 03h  ;border
 dw 00h*400h+1ch*20h+00h ;*; color_border_white equ 04h  ;border
 dw 00h*400h+00h*20h+00h   ; color_border_black equ 05h  ;border
 dw 00h*400h+00h*20h+1fh   ; color_06h          equ 06h  ;  (unused)
 dw 00h*400h+10h*20h+1ch   ; color_orange       equ 07h  ;  (unused)
 dw 00h*400h+18h*20h+18h   ; color_yellow       equ 08h  ;  (unused)
 dw 00h*400h+1ch*20h+10h   ; color_greenish     equ 09h  ;  (unused)
 dw 0ch*400h+0ch*20h+1fh   ; color_red          equ 0ah  ;symbol/playqueue (tile_left_border_play and tile_left_border_pause)
 dw 00h*400h+1fh*20h+00h   ; color_green        equ 0bh  ;symbol/filelist
 dw 00h*400h+10h*20h+0ch   ; color_blue         equ 0ch  ;symbol/options
 dw 00h*400h+1fh*20h+00h ;*; color_text_bright  equ 0dh  ;text/bright (for selection)
 dw 00h*400h+18h*20h+00h ;*; color_text_normal  equ 0eh  ;text/normal (for normal text) (and for progress bar and NN:NN.n digits) (tile_left_border_progress and tile_right_border_progress)
 dw 00h*400h+10h*20h+00h ;*; color_text_dark    equ 0fh  ;text/dark   (for tech info)
;------------------
gui_palette_data_orange:
 ;--blue     green   red
 dw 00h*400h+00h*20h+00h   ; color_text_black   equ 00h  ;text/background (must be color 0 backdrop)
 dw 06h*400h+0ch*20h+12h ;*; color_border_dark  equ 01h  ;border
 dw 08h*400h+10h*20h+16h ;*; color_border_med   equ 02h  ;border
 dw 0ch*400h+14h*20h+1ah ;*; color_border_light equ 03h  ;border
 dw 10h*400h+1ch*20h+1fh ;*; color_border_white equ 04h  ;border
 dw 00h*400h+00h*20h+00h   ; color_border_black equ 05h  ;border
 dw 1fh*400h+00h*20h+1fh   ; color_06h          equ 06h  ;  (unused)
 dw 00h*400h+10h*20h+1ch   ; color_orange       equ 07h  ;  (unused)
 dw 00h*400h+18h*20h+18h   ; color_yellow       equ 08h  ;  (unused)
 dw 00h*400h+1ch*20h+10h   ; color_greenish     equ 09h  ;  (unused)
 dw 0ch*400h+0ch*20h+1fh   ; color_red          equ 0ah  ;symbol/playqueue (tile_left_border_play and tile_left_border_pause)
 dw 00h*400h+1fh*20h+00h   ; color_green        equ 0bh  ;symbol/filelist
 dw 1fh*400h+10h*20h+0ch   ; color_blue         equ 0ch  ;symbol/options
 dw 1ch*400h+1fh*20h+1fh ;*; color_text_bright  equ 0dh  ;text/bright (for selection)
 dw 04h*400h+12h*20h+1ch ;*; color_text_normal  equ 0eh  ;text/normal (for normal text) (and for progress bar and NN:NN.n digits) (tile_left_border_progress and tile_right_border_progress)
 dw 02h*400h+0ch*20h+18h ;*; color_text_dark    equ 0fh  ;text/dark   (for tech info)
;------------------
gui_palette_data_fruit:
 ;--blue     green   red
 dw 04h*400h+08h*20h+10h   ; color_text_black   equ 00h  ;text/background (must be color 0 backdrop)
 dw 06h*400h+0ch*20h+12h ;*; color_border_dark  equ 01h  ;border
 dw 08h*400h+10h*20h+16h ;*; color_border_med   equ 02h  ;border
 dw 0ch*400h+14h*20h+1ah ;*; color_border_light equ 03h  ;border
 dw 10h*400h+1ch*20h+1fh ;*; color_border_white equ 04h  ;border
 dw 00h*400h+00h*20h+00h   ; color_border_black equ 05h  ;border
 dw 1fh*400h+00h*20h+1fh   ; color_06h          equ 06h  ;  (unused)
 dw 00h*400h+10h*20h+1ch   ; color_orange       equ 07h  ;  (unused)
 dw 00h*400h+18h*20h+18h   ; color_yellow       equ 08h  ;  (unused)
 dw 00h*400h+1ch*20h+10h   ; color_greenish     equ 09h  ;  (unused)
 dw 0ch*400h+0ch*20h+1fh   ; color_red          equ 0ah  ;symbol/playqueue (tile_left_border_play and tile_left_border_pause)
 dw 00h*400h+1fh*20h+00h   ; color_green        equ 0bh  ;symbol/filelist
 dw 1fh*400h+10h*20h+0ch   ; color_blue         equ 0ch  ;symbol/options
 dw 1ch*400h+1fh*20h+1fh ;*; color_text_bright  equ 0dh  ;text/bright (for selection)
 dw 04h*400h+18h*20h+1ch ;*; color_text_normal  equ 0eh  ;text/normal (for normal text) (and for progress bar and NN:NN.n digits) (tile_left_border_progress and tile_right_border_progress)
 dw 02h*400h+1ch*20h+18h ;*; color_text_dark    equ 0fh  ;text/dark   (for tech info)
;------------------
gui_palette_data_white:
 ;--blue     green   red
 dw 1fh*400h+1fh*20h+1fh   ; color_text_black   equ 00h  ;text/background (must be color 0 backdrop)
 dw 0ch*400h+0ch*20h+0ch ;*; color_border_dark  equ 01h  ;border
 dw 10h*400h+10h*20h+10h ;*; color_border_med   equ 02h  ;border
 dw 14h*400h+14h*20h+14h ;*; color_border_light equ 03h  ;border
 dw 1ch*400h+1ch*20h+1ch ;*; color_border_white equ 04h  ;border
 dw 00h*400h+00h*20h+00h   ; color_border_black equ 05h  ;border
 dw 1fh*400h+00h*20h+1fh   ; color_06h          equ 06h  ;  (unused)
 dw 00h*400h+10h*20h+1ch   ; color_orange       equ 07h  ;  (unused)
 dw 00h*400h+18h*20h+18h   ; color_yellow       equ 08h  ;  (unused)
 dw 00h*400h+1ch*20h+10h   ; color_greenish     equ 09h  ;  (unused)
 dw 0ch*400h+0ch*20h+1fh   ; color_red          equ 0ah  ;symbol/playqueue (tile_left_border_play and tile_left_border_pause)
 dw 00h*400h+1fh*20h+00h   ; color_green        equ 0bh  ;symbol/filelist
 dw 1fh*400h+10h*20h+0ch   ; color_blue         equ 0ch  ;symbol/options
 dw 00h*400h+00h*20h+1fh ;*; color_text_bright  equ 0dh  ;text/bright (for selection)
 dw 00h*400h+00h*20h+00h ;*; color_text_normal  equ 0eh  ;text/normal (for normal text) (and for progress bar and NN:NN.n digits) (tile_left_border_progress and tile_right_border_progress)
 dw 1fh*400h+00h*20h+00h ;*; color_text_dark    equ 0fh  ;text/dark   (for tech info)
;------------------
palette_4bpp_generic     equ 0
palette_1bpp_dark_0      equ 04h
palette_1bpp_dark_1      equ 05h
palette_1bpp_dark_2      equ 06h
palette_1bpp_dark_3      equ 07h
palette_1bpp_text_0      equ 08h
palette_1bpp_text_1      equ 09h
palette_1bpp_text_2      equ 0ah
palette_1bpp_text_3      equ 0bh
palette_1bpp_selected_0  equ 0ch
palette_1bpp_selected_1  equ 0dh
palette_1bpp_selected_2  equ 0eh
palette_1bpp_selected_3  equ 0fh
