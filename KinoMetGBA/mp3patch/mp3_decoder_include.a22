   str  r2,[r6],4
   ldrb r4,[r7],1         ;new
   xor  r4,80h            ;make unsigned (faster because "sub new,diff" won't flip sign, and thus doesn't neeed three AND FFh's)
   sub  r5,r4,r1,lsr 24   ;diff=new-old
   sub  r1,r4,r5,asr 1    ;new-(4/8)
   add  r2,r1,r5,asr 3    ;new-(3/8)
   sub  r1,r1,r5,asr 3    ;new-(5/8)
   orr  r1,r2,lsl 8
   orr  r1,r4,lsl 16
   orr  r1,r4,lsl 24
   xor  r2,r1,r10         ;make signed
   str  r2,[r6],4
   ldrb r4,[r7],1         ;new
   xor  r4,80h            ;make unsigned (faster because "sub new,diff" won't flip sign, and thus doesn't neeed three AND FFh's)
   sub  r5,r4,r1,lsr 24   ;diff=new-old
   sub  r1,r4,r5,asr 1    ;new-(4/8)
   add  r2,r1,r5,asr 3    ;new-(3/8)
   sub  r1,r1,r5,asr 3    ;new-(5/8)
   orr  r1,r2,lsl 8
   orr  r1,r4,lsl 16
   orr  r1,r4,lsl 24
   xor  r2,r1,r10         ;make signed
   str  r2,[r6],4
   ldrb r4,[r7],1         ;new
   xor  r4,80h            ;make unsigned (faster because "sub new,diff" won't flip sign, and thus doesn't neeed three AND FFh's)
   sub  r5,r4,r1,lsr 24   ;diff=new-old
   sub  r1,r4,r5,asr 1    ;new-(4/8)
   add  r2,r1,r5,asr 3    ;new-(3/8)
   sub  r1,r1,r5,asr 3    ;new-(5/8)
   orr  r1,r2,lsl 8
   orr  r1,r4,lsl 16
   orr  r1,r4,lsl 24
