.macro mp3mac_upsample_4_point_watte_4x
 push r9,r12,lr
 timelog_start rdtsc_upsampler
 ldr  lr,[r11,mp3ctx_samples_output_size]  ;siz
 ldr  r12,=mp3_upsample_buf                ;src
;mov  r9,r9                                ;dst
 ldr  r1,[r11,mp3ctx_upsample_recent]          ;\
 mov  r3,r1,lsr 16                             ;
 mov  r2,r1,lsr 8                              ; end of recent block
 and  r1,0ffh                                  ;
 and  r2,0ffh                                  ;/
 ldr  r10,=80808080h
@@lop:                    ;Watte
 ldrb r4,[r12],1        ;new
 xor  r4,80h            ;make unsigned (faster because "r2+steps" won't flip sign, and thus doesn't neeed three AND FFh's)
 add  r1,r4             ;-tt = (r1+r4)
;mov  r2,r2             ;-r2 = r2
 add  r5,r3,r3,lsl 1    ;\
 sub  r5,r1             ; r5 = (r3*3) - tt - r2
 sub  r5,r2             ;/
 sub  r6,r1,r2          ;\r6 = tt - r2 - r3
 sub  r6,r3             ;/
 ;- - - return (r6*x+r5)*x/2+r2;
 add  r0,r6,r5,lsl 2          ;step(1) for t=(1/4)
 add  r1,r6,r5,lsl 1          ;step(2) for t=(2/4)
 add  r5,r2,r0,asr (2+2)+1    ;base+steps(1)      ;t=(1/4)
 add  r6,r2,r1,asr (1+1)+1    ;base+steps(2)      ;t=(2/4)
 add  r7,r5,r1,asr (1+1)+1    ;base+steps(1,2)    ;t=(3/4)
 orr  r0,r2,r5,lsl 8            ;\
 orr  r0,r0,r6,lsl 16           ; merge 4 bytes --> 1 word
 orr  r0,r0,r7,lsl 24           ;/
 xor  r0,r10         ;make signed
 mov  r1,r2  ;\
 mov  r2,r3  ; shuffle prev values (alternately keep them in place, and use opcodes with different registers in each step)
 mov  r3,r4  ;/
 str  r0,[r9],4
 subs lr,4
 bhi  @@lop
;blo  $        ;oops
 orr  r1,r2,lsl 8                              ;\
 orr  r1,r3,lsl 16                             ; end of curr block
 str  r1,[r11,mp3ctx_upsample_recent]          ;/
 timelog_end rdtsc_upsampler
 pop  r9,r12,pc
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
.macro mp3mac_upsample_4_point_parabolic_4x
 push r9,r12,lr
 timelog_start rdtsc_upsampler
 ldr  lr,[r11,mp3ctx_samples_output_size]  ;siz
 ldr  r12,=mp3_upsample_buf                ;src
;mov  r9,r9                                ;dst
 ldr  r1,[r11,mp3ctx_upsample_recent]          ;\
 mov  r3,r1,lsr 16                             ;
 mov  r2,r1,lsr 8                              ; end of recent block
 and  r1,0ffh                                  ;
 and  r2,0ffh                                  ;/
 ldr  r10,=80808080h
@@lop:                    ;Parabolic
;SHIM-UNROLLED .rept 4 = 4
   ;4-point, 2nd-order parabolic 2x (x-form) (dunno why this is called "2x", but apparently it isn't related to multiplying the sample rate by 2x)
   ldrb r4,[r12],1        ;new
   xor  r4,80h            ;make unsigned (faster because "r2+steps" won't flip sign, and thus doesn't neeed three AND FFh's)
   sub  r0,r3,r1          ;-tt = r3-r1
   add  r5,r3,r1          ;\r5 = r2*2 + r1 + r3
   add  r5,r2,lsl 1       ;/
   mov  r6,r0,lsl 1       ;-r6 = tt*2
   sub  r7,r4,r2          ;\r7 = r4 - r2 - tt
   sub  r7,r0             ;/
   ;- - - return ((c2*x+c1)*x+c0)/4;
   add  r0,r7,r6,lsl 2          ;step(1) for t=(1/4)
   add  r1,r7,r6,lsl 1          ;step(2) for t=(2/4)
     mov  r5,r5   ,asr 2          ;base+0             ;t=(0/4)
     add  r6,r5,r0,asr (2+2)+2    ;base+steps(1)      ;t=(1/4)
     add  r7,r5,r1,asr (1+1)+2    ;base+steps(2)      ;t=(2/4)
     add  r8,r6,r1,asr (1+1)+2    ;base+steps(1,2)    ;t=(3/4)
   orr  r0,r5,r6,lsl 8            ;\
   orr  r0,r0,r7,lsl 16           ; merge 4 bytes --> 1 word
   orr  r0,r0,r8,lsl 24           ;/
   xor  r0,r10         ;make signed
   str  r0,[r9],4
   mov  r1,r2  ;\
   mov  r2,r3  ; shuffle prev values (alternately keep them in place, and use opcodes with different registers in each step)
   mov  r3,r4  ;/
   ;4-point, 2nd-order parabolic 2x (x-form) (dunno why this is called "2x", but apparently it isn't related to multiplying the sample rate by 2x)
   ldrb r4,[r12],1        ;new
   xor  r4,80h            ;make unsigned (faster because "r2+steps" won't flip sign, and thus doesn't neeed three AND FFh's)
   sub  r0,r3,r1          ;-tt = r3-r1
   add  r5,r3,r1          ;\r5 = r2*2 + r1 + r3
   add  r5,r2,lsl 1       ;/
   mov  r6,r0,lsl 1       ;-r6 = tt*2
   sub  r7,r4,r2          ;\r7 = r4 - r2 - tt
   sub  r7,r0             ;/
   ;- - - return ((c2*x+c1)*x+c0)/4;
   add  r0,r7,r6,lsl 2          ;step(1) for t=(1/4)
   add  r1,r7,r6,lsl 1          ;step(2) for t=(2/4)
     mov  r5,r5   ,asr 2          ;base+0             ;t=(0/4)
     add  r6,r5,r0,asr (2+2)+2    ;base+steps(1)      ;t=(1/4)
     add  r7,r5,r1,asr (1+1)+2    ;base+steps(2)      ;t=(2/4)
     add  r8,r6,r1,asr (1+1)+2    ;base+steps(1,2)    ;t=(3/4)
   orr  r0,r5,r6,lsl 8            ;\
   orr  r0,r0,r7,lsl 16           ; merge 4 bytes --> 1 word
   orr  r0,r0,r8,lsl 24           ;/
   xor  r0,r10         ;make signed
   str  r0,[r9],4
   mov  r1,r2  ;\
   mov  r2,r3  ; shuffle prev values (alternately keep them in place, and use opcodes with different registers in each step)
   mov  r3,r4  ;/
   ;4-point, 2nd-order parabolic 2x (x-form) (dunno why this is called "2x", but apparently it isn't related to multiplying the sample rate by 2x)
   ldrb r4,[r12],1        ;new
   xor  r4,80h            ;make unsigned (faster because "r2+steps" won't flip sign, and thus doesn't neeed three AND FFh's)
   sub  r0,r3,r1          ;-tt = r3-r1
   add  r5,r3,r1          ;\r5 = r2*2 + r1 + r3
   add  r5,r2,lsl 1       ;/
   mov  r6,r0,lsl 1       ;-r6 = tt*2
   sub  r7,r4,r2          ;\r7 = r4 - r2 - tt
   sub  r7,r0             ;/
   ;- - - return ((c2*x+c1)*x+c0)/4;
   add  r0,r7,r6,lsl 2          ;step(1) for t=(1/4)
   add  r1,r7,r6,lsl 1          ;step(2) for t=(2/4)
     mov  r5,r5   ,asr 2          ;base+0             ;t=(0/4)
     add  r6,r5,r0,asr (2+2)+2    ;base+steps(1)      ;t=(1/4)
     add  r7,r5,r1,asr (1+1)+2    ;base+steps(2)      ;t=(2/4)
     add  r8,r6,r1,asr (1+1)+2    ;base+steps(1,2)    ;t=(3/4)
   orr  r0,r5,r6,lsl 8            ;\
   orr  r0,r0,r7,lsl 16           ; merge 4 bytes --> 1 word
   orr  r0,r0,r8,lsl 24           ;/
   xor  r0,r10         ;make signed
   str  r0,[r9],4
   mov  r1,r2  ;\
   mov  r2,r3  ; shuffle prev values (alternately keep them in place, and use opcodes with different registers in each step)
   mov  r3,r4  ;/
   ;4-point, 2nd-order parabolic 2x (x-form) (dunno why this is called "2x", but apparently it isn't related to multiplying the sample rate by 2x)
   ldrb r4,[r12],1        ;new
   xor  r4,80h            ;make unsigned (faster because "r2+steps" won't flip sign, and thus doesn't neeed three AND FFh's)
   sub  r0,r3,r1          ;-tt = r3-r1
   add  r5,r3,r1          ;\r5 = r2*2 + r1 + r3
   add  r5,r2,lsl 1       ;/
   mov  r6,r0,lsl 1       ;-r6 = tt*2
   sub  r7,r4,r2          ;\r7 = r4 - r2 - tt
   sub  r7,r0             ;/
   ;- - - return ((c2*x+c1)*x+c0)/4;
   add  r0,r7,r6,lsl 2          ;step(1) for t=(1/4)
   add  r1,r7,r6,lsl 1          ;step(2) for t=(2/4)
     mov  r5,r5   ,asr 2          ;base+0             ;t=(0/4)
     add  r6,r5,r0,asr (2+2)+2    ;base+steps(1)      ;t=(1/4)
     add  r7,r5,r1,asr (1+1)+2    ;base+steps(2)      ;t=(2/4)
     add  r8,r6,r1,asr (1+1)+2    ;base+steps(1,2)    ;t=(3/4)
   orr  r0,r5,r6,lsl 8            ;\
   orr  r0,r0,r7,lsl 16           ; merge 4 bytes --> 1 word
   orr  r0,r0,r8,lsl 24           ;/
   xor  r0,r10         ;make signed
   str  r0,[r9],4
   mov  r1,r2  ;\
   mov  r2,r3  ; shuffle prev values (alternately keep them in place, and use opcodes with different registers in each step)
   mov  r3,r4  ;/
 subs lr,4*4
 bhi  @@lop
;blo  $        ;oops
 orr  r1,r2,lsl 8                              ;\
 orr  r1,r3,lsl 16                             ; end of curr block
 str  r1,[r11,mp3ctx_upsample_recent]          ;/
 timelog_end rdtsc_upsampler
 pop  r9,r12,pc
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
.macro mp3mac_upsample_4_point_parabolic_8x
 push r9,r12,lr
 timelog_start rdtsc_upsampler
 ldr  lr,[r11,mp3ctx_samples_output_size]  ;siz
 ldr  r12,=mp3_upsample_buf                ;src
;mov  r9,r9                                ;dst
 ldr  r1,[r11,mp3ctx_upsample_recent]          ;\
 mov  r3,r1,lsr 16                             ;
 mov  r2,r1,lsr 8                              ; end of recent block
 and  r1,0ffh                                  ;
 and  r2,0ffh                                  ;/
 ldr  r10,=80808080h
 push r11
@@lop:                    ;Parabolic
;SHIM-UNROLLED .rept 4       /4 = 1
   ;4-point, 2nd-order parabolic 2x (x-form) (dunno why this is called "2x", but apparently it isn't related to multiplying the sample rate by 2x)
   ldrb r4,[r12],1        ;new
   xor  r4,80h            ;make unsigned (faster because "r2+steps" won't flip sign, and thus doesn't neeed three AND FFh's)
   sub  r0,r3,r1          ;-tt = r3-r1
   add  r5,r3,r1          ;\r5 = r2*2 + r1 + r3
   add  r5,r2,lsl 1       ;/
   mov  r6,r0,lsl 1       ;-r6 = tt*2
   sub  r7,r4,r2          ;\r7 = r4 - r2 - tt
   sub  r7,r0             ;/
   ;- - - return ((c2*x+c1)*x+c0)/4;
   add  r0,r7,r6,lsl 3            ;step(3) for t=(1/8)
   add  r1,r7,r6,lsl 2            ;step(1) for t=(2/8)
   add  r11,r7,r6,lsl 1           ;step(2) for t=(4/8)
     mov  r5,r5   ,asr 2          ;base+0             ;t=(0/8)
     add  r6,r5,r0,asr (3+3)+2    ;base+steps(1)      ;t=(1/8)
     add  r7,r5,r1,asr (2+2)+2    ;base+steps(2)      ;t=(2/8)
     add  r8,r6,r1,asr (2+2)+2    ;base+steps(1,2)    ;t=(3/8)
   orr  r0,r5,r6,lsl 8            ;\
   orr  r0,r0,r7,lsl 16           ; merge 4 bytes --> 1 word
   orr  r0,r0,r8,lsl 24           ;/
   xor  r0,r10         ;make signed
   str  r0,[r9],4

   add  r5,r11,asr (1+1)+2    ;base+steps(4,1)      ;t=(4/8)
   add  r6,r11,asr (1+1)+2    ;base+steps(4,1)      ;t=(5/8)
   add  r7,r11,asr (1+1)+2    ;base+steps(4,2)      ;t=(6/8)
   add  r8,r11,asr (1+1)+2    ;base+steps(4,1,2)    ;t=(7/8)
   orr  r0,r5,r6,lsl 8            ;\
   orr  r0,r0,r7,lsl 16           ; merge 4 bytes --> 1 word
   orr  r0,r0,r8,lsl 24           ;/
   xor  r0,r10         ;make signed
   str  r0,[r9],4

   mov  r1,r2  ;\
   mov  r2,r3  ; shuffle prev values (alternately keep them in place, and use opcodes with different registers in each step)
   mov  r3,r4  ;/
 subs lr,8*4   /4
 bhi  @@lop
;blo  $        ;oops
 pop  r11
 orr  r1,r2,lsl 8                              ;\
 orr  r1,r3,lsl 16                             ; end of curr block
 str  r1,[r11,mp3ctx_upsample_recent]          ;/
 timelog_end rdtsc_upsampler
 pop  r9,r12,pc
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
.macro mp3mac_upsample_4_point_gauss_psx_4x
 push r9,r12,lr
 timelog_start rdtsc_upsampler
 ldr  lr,[r11,mp3ctx_samples_output_size]  ;siz
 ldr  r12,=mp3_upsample_buf                ;src
;mov  r9,r9                                ;dst
 ldr  r1,[r11,mp3ctx_upsample_recent]          ;-end of recent block
               mov  r3,r1,lsr 16       ;<-- could be omitted for fast 3-point
               mov  r2,r1,lsr 8
               and  r1,0ffh
               and  r2,0ffh            ;<-- could be omitted for fast 3-point
 ldr  r10,=80808080h
@@lop:                    ;Gauss PSX
;SHIM-UNROLLED .rept 4       /4 = 1
   ldrb r4,[r12],1        ;new
   xor  r4,80h            ;make unsigned (faster because "r2+steps" won't flip sign, and thus doesn't neeed three AND FFh's)


     mov  r0,025h
     mul r5,r1,r0;\                         ;12C7h/80h
     mov  r0,0B3h
     mla r5,r2,r0,r5; t=(0/4)                  ;59B3h/80h
     mov  r0,026h
     mla r5,r3,r0,r5;                          ;1307h/80h
    ;mov  r0,000h // mla r5,r4,r0,r5   ;/         ;<-- omit zero  ;0000h/80h
     mov  r0,00Dh
     mul r6,r1,r0;\                         ;06DCh/80h
     mov  r0,0A3h
     mla r6,r2,r0,r6; t=(1/4)                  ;51D0h/80h
     mov  r0,04Dh
     mla r6,r3,r0,r6;                          ;26ADh/80h
    ;mov  r0,000h // mla r6,r4,r0,r6   ;/         ;<-- omit zero  ;0027h/80h
     mov  r0,003h
     mul r7,r1,r0;\         ;<-- add n,n*2  ;019Ch/80h
     mov  r0,07Bh
     mla r7,r2,r0,r7; t=(2/4)                  ;3DEFh/80h
     mov  r0,07Ch
     mla r7,r3,r0,r7;                          ;3E4Ch/80h
     mov  r0,003h
     mla r7,r4,r0,r7;/         ;<-- add n,n*2  ;01A8h/80h
    ;mov  r0,000h // mul r8,r1,r0      ;\         ;<-- omit zero  ;0025h/80h
     mov  r0,04Ch
     mul r8,r2,r0; t=(3/4)                  ;2653h/80h
     mov  r0,0A4h
     mla r8,r3,r0,r8;                          ;520Ch/80h
     mov  r0,00Dh
     mla r8,r4,r0,r8;/                         ;06FDh/80h

   mov  r5,r5,lsr 15-7    ;\
   mov  r6,r6,lsr 15-7    ; PSX does that after EACH MULTIPLY
   mov  r7,r7,lsr 15-7    ; (done after SUM can be bigger... maybe can overflow?)
   mov  r8,r8,lsr 15-7    ;/(also caution: table values -1 are replaced by 0)
   orr  r5,r6,lsl 8
   orr  r5,r7,lsl 16
   orr  r5,r8,lsl 24
   xor  r5,r10         ;make signed
   str  r5,[r9],4
   mov  r1,r2  ;\
   mov  r2,r3  ; shuffle prev values (alternately keep them in place, and use opcodes with different registers in each step)
   mov  r3,r4  ;/
 subs lr,4*4   /4
 bhi  @@lop
;blo  $        ;oops
 orr  r1,r2,lsl 8                              ;\
 orr  r1,r3,lsl 16                             ; end of curr block
 str  r1,[r11,mp3ctx_upsample_recent]          ;/
 timelog_end rdtsc_upsampler
 pop  r9,r12,pc
.pool
gauss_table_psx:
