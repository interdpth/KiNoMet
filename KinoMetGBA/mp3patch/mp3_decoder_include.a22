   sub  r5,r4,r1,lsr 24   ;diff=new-old
   sub  r2,r4,r5,asr 2    ;new-(2/8)
   sub  r1,r2,r5,asr 1    ;new-(6/8)
   orr  r1,r2,lsl 8
   orr  r1,r4,lsl 16
   orr  r1,r4,lsl 24
   xor  r2,r1,r10         ;make signed
   str  r2,[r6],4
 subs r8,4*4
