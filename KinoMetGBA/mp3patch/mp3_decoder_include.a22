;XXX Filelist Sort=^Alphabetically=By timestamp    ;(useful for things like "newly downloaded songs")
;XXX on nds/dsi, use upper/lower/both screens
;XXX fadeover (for GBA only when 12kHz mono or less)
 dd 0   ;end of list
