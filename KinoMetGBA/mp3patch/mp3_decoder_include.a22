;------------------
;:----------------- Text output (TTY debug window)
;------------------
;SHIM-REMOVED.code
;------------------
tty_wrchr_r4:
 push r3,lr
   mov  r3,5000000h
   strb r4,[r3,4FFFA1Ch-5000000h]   ;Debug Char Out (nocash)
 pop  r3,pc
;------------------
tty_wrstr_r5:
 push r4,lr
@@lop:
 ldrb r4,[r5],1
 cmp  r4,00h
 beq  @@done
 bl   tty_wrchr_r4
 b    @@lop
@@done:
 pop  r4,pc
;------------------
tty_wrstr_r5_unicode16bit:
 push r4,lr
@@lop:
 ldrh r4,[r5],2
 cmp  r4,0000h
 beq  @@done
 cmp   r4,0080h
 movhs r4,7fh
 bl   tty_wrchr_r4
 b    @@lop
@@done:
 pop  r4,pc
;------------------
;------------------
tty_wrcrlf:
 push r4,lr
 mov  r4,0dh
 bl   tty_wrchr_r4
 mov  r4,0ah
 bl   tty_wrchr_r4
 pop  r4,pc
;------------------
tty_wrspc:
 push r4,lr
 mov  r4,20h
 bl   tty_wrchr_r4
 pop  r4,pc
;------------------
tty_wrcomma:
 push r4,lr
 mov  r4,','
 bl   tty_wrchr_r4
 pop  r4,pc
;------------------
tty_decimal_r4_with_thousands_separator:  ;in: r4
 push r2-r8,lr
 mov  r7,02h    ;thousands(yes, starting before 2nd digit)
 b    wr_decimal_r4_inj
;------------------
tty_decimal_r4:
 push r2-r8,lr
 mov  r7,0      ;thousands(none)
wr_decimal_r4_inj: ;in: r4,r7 (and, stack pushed)
 ldr  r8,=1000000000  ;nine zeroes (32bit max 4.294.967.296)
 mov  r6,0      ;leadflag (none)
@@dezlop:
 subs r7,1                      ;\
 bne  @@no_thousands            ;
 mov  r7,3                      ;
 cmp  r6,0      ;leadflag       ;
 blne tty_wrcomma               ;
@@no_thousands:                 ;/
 mov  r5,r8
 bl   rom_div_r4_r5
 mov  r2,r5     ;val
 cmp  r8,1
 beq  @@force_last_zero
 orrs r6,r4     ;leadflag
 beq  @@skip_lead_zero
@@force_last_zero:
 add  r4,30h
 bl   tty_wrchr_r4
@@skip_lead_zero:
 mov  r4,r8
 mov  r5,10
 bl   rom_div_r4_r5
 movs r8,r4       ;zf
 mov  r4,r2     ;val
 bne  @@dezlop    ;zf
 pop  r2-r8,pc
;------------------
appstr_decimal_r4_with_thousands_separator:  ;in: r4
 push r2-r8,lr
 mov  r7,02h    ;thousands(yes, starting before 2nd digit)
 b    appstr_decimal_r4_inj
;------------------
appstr_decimal_r4:
 push r2-r8,lr
 mov  r7,0      ;thousands(none)
appstr_decimal_r4_inj: ;in: r4,r7 (and, stack pushed)
 ldr  r8,=1000000000  ;nine zeroes (32bit max 4.294.967.296)
 mov  r6,0      ;leadflag (none)
@@dezlop:
 subs r7,1                      ;\
 bne  @@no_thousands            ;
 mov  r7,3                      ;
 cmp  r6,0      ;leadflag       ;
 movne  r5,','      ;\comma     ;
 strneb r5,[r10],1  ;/          ;
@@no_thousands:                 ;/
 mov  r5,r8
 bl   rom_div_r4_r5
 mov  r2,r5     ;val
 cmp  r8,1
 beq  @@force_last_zero
 orrs r6,r4     ;leadflag
 beq  @@skip_lead_zero
@@force_last_zero:
 add  r4,30h
 strb r4,[r10],1
@@skip_lead_zero:
 mov  r4,r8
 mov  r5,10
 bl   rom_div_r4_r5
 movs r8,r4       ;zf
 mov  r4,r2     ;val
 bne  @@dezlop    ;zf
 mov  r2,0
 strb r2,[r10]    ;eol
 pop  r2-r8,pc
;------------------
appstr_hex4bit:
 push r4,lr
 and  r4,0fh
 cmp  r4,09h
 addhi r4,07h
 add  r4,30h
 strb r4,[r10],1
 pop  r4,pc
;------------------
appstr_hex8bit:
 push lr
 mov  r4,r4,ror 4
 bl   appstr_hex4bit
 mov  r4,r4,ror 32-4
 bl   appstr_hex4bit
 pop  pc
;------------------
appstr_hex16bit:
 push lr
 mov  r4,r4,ror 8
 bl   appstr_hex8bit
 mov  r4,r4,ror 32-8
 bl   appstr_hex8bit
 pop  pc
;------------------
appstr_hex32bit:
 push lr
 mov  r4,r4,ror 16
 bl   appstr_hex16bit
 mov  r4,r4,ror 32-16
 bl   appstr_hex16bit
 pop  pc
;------------------
tty_wrhex4bit:
 push r4,lr
 and  r4,0fh
 cmp  r4,09h
 addhi r4,07h
 add  r4,30h
 bl   tty_wrchr_r4
 pop  r4,pc
;------------------
tty_wrhex8bit:
 push lr
 mov  r4,r4,ror 4
 bl   tty_wrhex4bit
 mov  r4,r4,ror 32-4
 bl   tty_wrhex4bit
 pop  pc
;------------------
tty_wrhex16bit:
 push lr
 mov  r4,r4,ror 8
 bl   tty_wrhex8bit
 mov  r4,r4,ror 32-8
 bl   tty_wrhex8bit
 pop  pc
;------------------
tty_wrhex32bit:
 push lr
 mov  r4,r4,ror 16
 bl   tty_wrhex16bit
 mov  r4,r4,ror 32-16
 bl   tty_wrhex16bit
 pop  pc
