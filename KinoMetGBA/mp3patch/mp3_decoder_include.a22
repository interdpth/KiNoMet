 xor  r4,r0,lsl 16                      ;/
 add  r0,r1,r3        ;r1*1+r3*1        ;\
 add  r0,r2,lsl 3     ;r1*1+r3*1+r2*8   ; (A*38h+B*B0h+C*18h)/100h
 add  r0,r0,lsl 1     ;r1*3+r3*3+r2*18h ;
 sub  r0,r2,lsl 1     ;r1*3+r3*3+r2*16h ;
 add  r0,r1,lsl 2     ;r1*7+r3*3+r2*16h ;
 mov  r0,r0,lsr 5                          ;
 xor  r4,r0,lsl 24                      ;/
 add  r0,r2,r2,lsl 1  ;r2*3             ;\
 add  r0,r1,r0,lsl 1  ;r2*6+r1          ; (A*20h+B*C0h+C*20h)/100h
 add  r0,r3           ;r2*6+r1+r3       ;
 xor  r5,r10,r0,lsr 3                   ;/
 add  r0,r3,r1        ;r3*1+r1*1        ;\
 add  r0,r2,lsl 3     ;r3*1+r1*1+r2*8   ; (A*18h+B*B0h+C*38h)/100h
 add  r0,r0,lsl 1     ;r3*3+r1*3+r2*18h ;
 sub  r0,r2,lsl 1     ;r3*3+r1*3+r2*16h ;
 add  r0,r3,lsl 2     ;r3*7+r1*3+r2*16h ;
 mov  r0,r0,lsr 5                          ;
 xor  r5,r0,lsl 8                       ;/
 add  r0,r3,r2,lsl 1  ;r2*2+r3          ;\
 add  r0,r0,r0,lsl 2  ;r2*0ah+r3*5      ; (A*10h+B*A0h+C*50h)/100h
 add  r0,r1                             ;
 mov  r0,r0,lsr 4                          ;
 xor  r5,r0,lsl 16                      ;/
 add  r0,r3,r2,lsl 1  ;r2*02h+r3        ;\
 add  r0,r0,lsl 3     ;r2*12h+r3*9      ; (A*08h+B*90h+C*68h)/100h
 add  r0,r3,lsl 2     ;r2*12h+r3*0Dh    ;
 add  r0,r1           ;r2*12h+r3*0Dh+r1 ;
 mov  r0,r0,lsr 5                          ;
 xor  r5,r0,lsl 24                      ;/
 stmia [r9]!,r4,r5                      ;-output
 mov  r1,r2  ;\shuffle prev values (alternately keep them in place, and use opcodes with different registers in each step)
 mov  r2,r3  ;/
 subs lr,8
 bhi  @@lop
;blo  $        ;oops
 orr  r1,r2,lsl 8                               ;\end of curr block
 str  r1,[r11,mp3ctx_upsample_recent]           ;/
 timelog_end rdtsc_upsampler
 pop  r9,r12,pc
;SHIM-RENAMED .endm -> .endmacro
.endmacro
