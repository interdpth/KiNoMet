.macro mp3mac_upsample_4_point_hermite_4x
 push r9,r12,lr
 timelog_start rdtsc_upsampler
 ldr  lr,[r11,mp3ctx_samples_output_size]  ;siz
 ldr  r12,=mp3_upsample_buf                ;src
;mov  r9,r9                                ;dst
 ldr  r1,[r11,mp3ctx_upsample_recent]          ;\
 mov  r3,r1,lsr 16                             ;
 mov  r2,r1,lsr 8                              ; end of recent block
 and  r1,0ffh                                  ;
 and  r2,0ffh                                  ;/
 ldr  r10,=80808080h
@@lop:                    ;InterpolateHermite4pt3oX
;SHIM-UNROLLED .rept 4       /4 = 1
   ldrb r4,[r12],1        ;new
   xor  r4,80h            ;make unsigned (faster because "r2+steps" won't flip sign, and thus doesn't neeed three AND FFh's)
   sub  r5,r3,r1          ;-r5 = (r3-r1)
   add  r8,r2,r2,lsl 2    ;\
   add  r6,r1,r3,lsl 1    ; r6 = (r1)*2 - (r2)*5 + (r3)*4 - (r4)
   add  r8,r4             ;
   rsb  r6,r8,r6,lsl 1    ;/
   sub  r8,r2,r3          ;\
   sub  r7,r4,r1          ; r7 = (r4-r1) + (r2-r3)*3
   add  r8,r8,r8,lsl 1    ;
   add  r7,r8,r7          ;/
   ;- - - return (((((r7 * t) + r6) * t) + r5) * t)/2 + r2
   add  r0,r6,r5,lsl 2            ;prepare step(1) for t=(1/4)
   add  r1,r6,r5,lsl 1            ;prepare step(2) for t=(2/4)
   add  r0,r7,r0,lsl 2            ;finish  step(1) for t=(1/4)
   add  r1,r7,r1,lsl 1            ;finish  step(2) for t=(2/4)
   add  r5,r2,r0,asr (2+2+2)+1    ;base+steps(1)      ;t=(1/4)
   add  r6,r2,r1,asr (1+1+1)+1    ;base+steps(2)      ;t=(2/4)
   add  r7,r5,r1,asr (1+1+1)+1    ;base+steps(1,2)    ;t=(3/4)
   orr  r0,r2,r5,lsl 8            ;\
   orr  r0,r0,r6,lsl 16           ; merge 4 bytes --> 1 word
   orr  r0,r0,r7,lsl 24           ;/
   xor  r0,r10         ;make signed
   mov  r1,r2  ;\
   mov  r2,r3  ; shuffle prev values (alternately keep them in place, and use opcodes with different registers in each step)
   mov  r3,r4  ;/
   str  r0,[r9],4
 subs lr,4*4   /4
 bhi  @@lop
;blo  $        ;oops
 orr  r1,r2,lsl 8                              ;\
 orr  r1,r3,lsl 16                             ; end of curr block
 str  r1,[r11,mp3ctx_upsample_recent]          ;/
 timelog_end rdtsc_upsampler
 pop  r9,r12,pc
;SHIM-RENAMED .endm -> .endmacro
.endmacro
