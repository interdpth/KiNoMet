   orr  r1,r1,lsl 8    ;xxxx
   orr  r1,r1,lsl 16   ;xxxxxxxx
   mov  r2,r1          ;xxxxxxxx,xxxxxxxx
   mov  r3,r1          ;xxxxxxxx,xxxxxxxx
   mov  r4,r1          ;xxxxxxxx,xxxxxxxx
   stmia [r6]!,r1,r2,r3,r4
 subs r8,4*16
 bhi  @@lop
;blo  $        ;oops
 timelog_end rdtsc_upsampler
 bx   lr
;SHIM-RENAMED .endm -> .endmacro
