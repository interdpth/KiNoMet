 db sortcode_blank      ;8Bh    ;2039h Quotation single left-pointing angle < (Guillemet) (ANSI=8Bh)
 db sortcode_latin_O    ;8Ch    ;0152h Latin Capital Ligature OE (ANSI=8Ch)
 db sortcode_unused     ;8Dh    ; (unused)
