cp870_to_unicode_xlat:   ;for ZIP files (if they were using a western-european codepage)
 dw  0C7h   ;080h  ;Letter C cedilla, uppercase
 dw  0FCh   ;081h  ;Letter U diaresis (umlaut), lowercase
 dw  0E9h   ;082h  ;Letter E acute, lowercase
