    ;  .import "D:\big-audio\DDR - In Line (FLAC).flac",0,30*1000*1000 ;48kHz, 24bit (fast enough for GBA, but using INCOMPLETE file, the whole 39Mbyte file is too big for GBA-ROM-Images)


    ;  .import d:\big-audio\flac-example.flac  ;speech   ;with FLAC_UNROLLED it seems JUST FAST ENOUGH for GBA (abbreviation "doubleyou-doubleyou-doubleyou" is longer than "world-wide-web" in spoken language)
    ;  .import d:\big-audio\flac-test.flac     ;piuiuuu  ;VERY FAST
    ;  .import "D:\big-audio\WAV-M1F1-Alaw-AFsp.wav"
    ;  .import "D:\big-audio\flac-test-files-main\subset\14 - wasted bits.flac"  ;FAST ENOUGH for GBA
    ;  .import "D:\big-audio\flac-test-files-main\subset\33 - samplerate 192kHz.flac"  ;FAST ENOUGH for GBA

  .definelabel src_imported_data_len, org()-src_data_start;=ZERO when none imported (but USER may APPEND a custom file)
  .definelabel src_data_max_len, MEM_ROM_MAX-src_data_start;MAX size till 32Mbyte boundary

  .align 4
;------------------
