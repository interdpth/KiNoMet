 dd apply_remove_all_files    ,0
 db "Remove all files from playqueue",0
 .align 4
 dd apply_shuffle             ,0
 db "Shuffle playqueue",0
 .align 4
 dd apply_pitch      ,option_pitch
 db "Pitch=92% (-8)=93% (-7)=94% (-6)=95% (-5)=96% (-4)=97% (-3)=98% (-2)=99% (-1)=^100% (normal)=101% (+1)=102% (+2)=103% (+3)=104% (+4)=105% (+5)=106% (+6)=107% (+7)=108% (+8)",0
 .align 4
;dd apply_none       ,option_reset           // db 'Reset Pitch/Volume=On each song=On Reboot=Don''t reset',0 // .align 4
;dd apply_volume_boo ,option_volume_boost    // db 'Volume Boost=^1.0=1.5=2.0=3.0=4.0',0                // .align 4
 dd apply_colors     ,option_colors
