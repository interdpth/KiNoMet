.macro mp3mac_upsample_4_point_gauss_psx_8x
 push r9,r12,lr
 timelog_start rdtsc_upsampler
 ldr  lr,[r11,mp3ctx_samples_output_size]  ;siz
 ldr  r12,=mp3_upsample_buf                ;src
;mov  r9,r9                                ;dst
 ldr  r1,[r11,mp3ctx_upsample_recent]          ;\
 mov  r3,r1,lsr 16                             ;
 mov  r2,r1,lsr 8                              ; end of recent block
 and  r1,0ffh                                  ;
 and  r2,0ffh                                  ;/
 ldr  r10,=80808080h
@@lop:                    ;Gauss PSX
;SHIM-UNROLLED .rept 4 = 4
   ldrb r4,[r12],1        ;new
   xor  r4,80h            ;make unsigned (faster because "r2+steps" won't flip sign, and thus doesn't neeed three AND FFh's)
   mov  r0,025h
   mul r7,r1,r0;\
   mov  r0,0B3h
   mla r7,r2,r0,r7; t=(0/8)
   mov  r0,026h
   mla r7,r3,r0,r7;
  ;mov  r0,000h // mla r7,r4,r0,r7   ;          ;<-- omit zero
   mov  r5,r7,lsr 15-7               ;/
   mov  r0,017h
   mul r7,r1,r0;\
   mov  r0,0AFh
   mla r7,r2,r0,r7; t=(1/8)
   mov  r0,038h
   mla r7,r3,r0,r7;
  ;mov  r0,000h // mla r7,r4,r0,r7   ;
   mov  r7,r7,lsr 15-7                  ;
   orr  r5,r7,lsl 8                  ;/
   mov  r0,00Dh
   mul r7,r1,r0;\
   mov  r0,0A3h
   mla r7,r2,r0,r7; t=(2/8)
   mov  r0,04Dh
   mla r7,r3,r0,r7;
  ;mov  r0,000h // mla r7,r4,r0,r7   ;
   mov  r7,r7,lsr 15-7                  ;
   orr  r5,r7,lsl 16                 ;/
   mov  r0,007h
   mul r7,r1,r0;\
   mov  r0,091h
   mla r7,r2,r0,r7; t=(3/8)
   mov  r0,064h
   mla r7,r3,r0,r7;
  ;mov  r0,001h // mla r7,r4,r0,r7   ;          ;<-- omit near zero
   mov  r7,r7,lsr 15-7                  ;
   orr  r5,r7,lsl 24                 ;/
   mov  r0,003h
   mul r7,r1,r0;\
   mov  r0,07Bh
   mla r7,r2,r0,r7; t=(4/8)
   mov  r0,07Ch
   mla r7,r3,r0,r7;
   mov  r0,003h
   mla r7,r4,r0,r7;
   mov  r6,r7,lsr 15-7               ;/
  ;mov  r0,001h // mul r7,r1,r0      ;\         ;<-- omit near zero
   mov  r0,064h
   mul r7,r2,r0; t=(5/8)
   mov  r0,092h
   mla r7,r3,r0,r7;
   mov  r0,007h
   mla r7,r4,r0,r7;
   mov  r7,r7,lsr 15-7                  ;
   orr  r6,r7,lsl 8                  ;/
  ;mov  r0,000h // mul r7,r1,r0      ;\         ;<-- omit zero
   mov  r0,04Ch
   mul r7,r2,r0; t=(6/8)
   mov  r0,0A4h
   mla r7,r3,r0,r7;
   mov  r0,00Dh
   mla r7,r4,r0,r7;
   mov  r7,r7,lsr 15-7                  ;
   orr  r6,r7,lsl 16                 ;/
  ;mov  r0,000h // mul r7,r1,r0      ;\         ;<-- omit zero
   mov  r0,037h
   mul r7,r2,r0; t=(7/8)
   mov  r0,0AFh
   mla r7,r3,r0,r7;
   mov  r0,018h
   mla r7,r4,r0,r7;
   mov  r7,r7,lsr 15-7                  ;
   orr  r6,r7,lsl 24                 ;/
   xor  r5,r10         ;make signed
   xor  r6,r10         ;make signed
   stmia [r9]!,r5,r6
   mov  r1,r2          ;\shuffle prev values (alternately could keep them in
   mov  r2,r3          ; place, and use opcodes with different registers
   mov  r3,r4          ;/in each step)
   ldrb r4,[r12],1        ;new
   xor  r4,80h            ;make unsigned (faster because "r2+steps" won't flip sign, and thus doesn't neeed three AND FFh's)
   mov  r0,025h
   mul r7,r1,r0;\
   mov  r0,0B3h
   mla r7,r2,r0,r7; t=(0/8)
   mov  r0,026h
   mla r7,r3,r0,r7;
  ;mov  r0,000h // mla r7,r4,r0,r7   ;          ;<-- omit zero
   mov  r5,r7,lsr 15-7               ;/
   mov  r0,017h
   mul r7,r1,r0;\
   mov  r0,0AFh
   mla r7,r2,r0,r7; t=(1/8)
   mov  r0,038h
   mla r7,r3,r0,r7;
  ;mov  r0,000h // mla r7,r4,r0,r7   ;
   mov  r7,r7,lsr 15-7                  ;
   orr  r5,r7,lsl 8                  ;/
   mov  r0,00Dh
   mul r7,r1,r0;\
   mov  r0,0A3h
   mla r7,r2,r0,r7; t=(2/8)
   mov  r0,04Dh
   mla r7,r3,r0,r7;
  ;mov  r0,000h // mla r7,r4,r0,r7   ;
   mov  r7,r7,lsr 15-7                  ;
   orr  r5,r7,lsl 16                 ;/
   mov  r0,007h
   mul r7,r1,r0;\
   mov  r0,091h
   mla r7,r2,r0,r7; t=(3/8)
   mov  r0,064h
   mla r7,r3,r0,r7;
  ;mov  r0,001h // mla r7,r4,r0,r7   ;          ;<-- omit near zero
   mov  r7,r7,lsr 15-7                  ;
   orr  r5,r7,lsl 24                 ;/
   mov  r0,003h
   mul r7,r1,r0;\
   mov  r0,07Bh
   mla r7,r2,r0,r7; t=(4/8)
   mov  r0,07Ch
   mla r7,r3,r0,r7;
   mov  r0,003h
   mla r7,r4,r0,r7;
   mov  r6,r7,lsr 15-7               ;/
  ;mov  r0,001h // mul r7,r1,r0      ;\         ;<-- omit near zero
   mov  r0,064h
   mul r7,r2,r0; t=(5/8)
   mov  r0,092h
   mla r7,r3,r0,r7;
   mov  r0,007h
   mla r7,r4,r0,r7;
   mov  r7,r7,lsr 15-7                  ;
   orr  r6,r7,lsl 8                  ;/
  ;mov  r0,000h // mul r7,r1,r0      ;\         ;<-- omit zero
   mov  r0,04Ch
   mul r7,r2,r0; t=(6/8)
   mov  r0,0A4h
   mla r7,r3,r0,r7;
   mov  r0,00Dh
   mla r7,r4,r0,r7;
   mov  r7,r7,lsr 15-7                  ;
   orr  r6,r7,lsl 16                 ;/
  ;mov  r0,000h // mul r7,r1,r0      ;\         ;<-- omit zero
   mov  r0,037h
   mul r7,r2,r0; t=(7/8)
   mov  r0,0AFh
   mla r7,r3,r0,r7;
   mov  r0,018h
   mla r7,r4,r0,r7;
   mov  r7,r7,lsr 15-7                  ;
   orr  r6,r7,lsl 24                 ;/
   xor  r5,r10         ;make signed
   xor  r6,r10         ;make signed
   stmia [r9]!,r5,r6
   mov  r1,r2          ;\shuffle prev values (alternately could keep them in
   mov  r2,r3          ; place, and use opcodes with different registers
   mov  r3,r4          ;/in each step)
   ldrb r4,[r12],1        ;new
   xor  r4,80h            ;make unsigned (faster because "r2+steps" won't flip sign, and thus doesn't neeed three AND FFh's)
   mov  r0,025h
   mul r7,r1,r0;\
   mov  r0,0B3h
   mla r7,r2,r0,r7; t=(0/8)
