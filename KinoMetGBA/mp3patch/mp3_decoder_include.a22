.macro mp3mac_upsample_3_point_gauss_nocash_8x
 push r9,r12,lr
 timelog_start rdtsc_upsampler
 ldr  lr,[r11,mp3ctx_samples_output_size]  ;siz
 ldr  r12,=mp3_upsample_buf                ;src
;mov  r9,r9                                ;dst
 ldr  r1,[r11,mp3ctx_upsample_recent]          ;\
 mov  r2,r1,lsr 8                              ; end of recent block
 and  r1,0ffh                                  ;/
 ldr  r10,=80808080h
@@lop:                    ;Gauss PSX
        ;00h
        ;00h
        ;00h
        ;00h
        ;00h
        ;10h xx
        ;18h xxx
        ;20h xxxx
        ;38h xxxxxxx
        ;50h xxxxxxxxxx
        ;68h xxxxxxxxxxxxx
        ;80h xxxxxxxxxxxxxxxx
        ;90h xxxxxxxxxxxxxxxxxx
        ;A0h xxxxxxxxxxxxxxxxxxxx
        ;B0h xxxxxxxxxxxxxxxxxxxxxx
        ;C0h xxxxxxxxxxxxxxxxxxxxxxxx
 ldr  r8,[r12],4        ;new
 xor  r8,r10            ;make unsigned (faster because "r2+steps" won't flip sign, and thus doesn't neeed three AND FFh's)
 and  r3,r8,0ffh        ;new            ;-fetch new
 add  r0,r1,r2                          ;\(A*80h+B*80h+C*00h)/100h
 xor  r4,r10,r0,lsr 1                   ;/
 add  r0,r1,r2,lsl 1  ;r2*02h+r1        ;\
 add  r0,r0,lsl 3     ;r2*12h+r1*9      ; (A*68h+B*90h+C*08h)/100h
 add  r0,r1,lsl 2     ;r2*12h+r1*0Dh    ;
 add  r0,r3           ;r2*12h+r1*0Dh+r3 ;
 mov  r0,r0,lsr 5                          ;
 xor  r4,r0,lsl 8                       ;/
 add  r0,r1,r2,lsl 1  ;r2*2+r1          ;\
 add  r0,r0,r0,lsl 2  ;r2*0ah+r1*5      ; (A*50h+B*A0h+C*10h)/100h
 add  r0,r3                             ;
 mov  r0,r0,lsr 4                          ;
 xor  r4,r0,lsl 16                      ;/
 add  r0,r1,r3        ;r1*1+r3*1        ;\
 add  r0,r2,lsl 3     ;r1*1+r3*1+r2*8   ; (A*38h+B*B0h+C*18h)/100h
 add  r0,r0,lsl 1     ;r1*3+r3*3+r2*18h ;
 sub  r0,r2,lsl 1     ;r1*3+r3*3+r2*16h ;
 add  r0,r1,lsl 2     ;r1*7+r3*3+r2*16h ;
 mov  r0,r0,lsr 5                          ;
 xor  r4,r0,lsl 24                      ;/
 add  r0,r2,r2,lsl 1  ;r2*3             ;\
 add  r0,r1,r0,lsl 1  ;r2*6+r1          ; (A*20h+B*C0h+C*20h)/100h
 add  r0,r3           ;r2*6+r1+r3       ;
 xor  r5,r10,r0,lsr 3                   ;/
 add  r0,r3,r1        ;r3*1+r1*1        ;\
 add  r0,r2,lsl 3     ;r3*1+r1*1+r2*8   ; (A*18h+B*B0h+C*38h)/100h
 add  r0,r0,lsl 1     ;r3*3+r1*3+r2*18h ;
 sub  r0,r2,lsl 1     ;r3*3+r1*3+r2*16h ;
 add  r0,r3,lsl 2     ;r3*7+r1*3+r2*16h ;
 mov  r0,r0,lsr 5                          ;
 xor  r5,r0,lsl 8                       ;/
 add  r0,r3,r2,lsl 1  ;r2*2+r3          ;\
 add  r0,r0,r0,lsl 2  ;r2*0ah+r3*5      ; (A*10h+B*A0h+C*50h)/100h
 add  r0,r1                             ;
 mov  r0,r0,lsr 4                          ;
 xor  r5,r0,lsl 16                      ;/
 add  r0,r3,r2,lsl 1  ;r2*02h+r3        ;\
 add  r0,r0,lsl 3     ;r2*12h+r3*9      ; (A*08h+B*90h+C*68h)/100h
 add  r0,r3,lsl 2     ;r2*12h+r3*0Dh    ;
 add  r0,r1           ;r2*12h+r3*0Dh+r1 ;
 mov  r0,r0,lsr 5                          ;
 xor  r5,r0,lsl 24                      ;/
 mov  r1,r8,lsr 8       ;new            ;\fetch new
 and  r1,0ffh                           ;/
 add  r0,r2,r3                          ;\(A*80h+B*80h+C*00h)/100h
 xor  r6,r10,r0,lsr 1                   ;/
 add  r0,r2,r3,lsl 1                    ;\
 add  r0,r0,lsl 3                       ; (A*68h+B*90h+C*08h)/100h
 add  r0,r2,lsl 2                       ;
 add  r0,r1                             ;
 mov  r0,r0,lsr 5                          ;
 xor  r6,r0,lsl 8                       ;/
 add  r0,r2,r3,lsl 1                    ;\
 add  r0,r0,r0,lsl 2                    ; (A*50h+B*A0h+C*10h)/100h
 add  r0,r1                             ;
 mov  r0,r0,lsr 4                          ;
 xor  r6,r0,lsl 16                      ;/
 add  r0,r2,r1                          ;\
 add  r0,r3,lsl 3                       ; (A*38h+B*B0h+C*18h)/100h
 add  r0,r0,lsl 1                       ;
 sub  r0,r3,lsl 1                       ;
 add  r0,r2,lsl 2                       ;
 mov  r0,r0,lsr 5                          ;
 xor  r6,r0,lsl 24                      ;/
 add  r0,r3,r3,lsl 1                    ;\
 add  r0,r2,r0,lsl 1                    ; (A*20h+B*C0h+C*20h)/100h
 add  r0,r1                             ;
 xor  r7,r10,r0,lsr 3                   ;/
 add  r0,r1,r2                          ;\
 add  r0,r3,lsl 3                       ; (A*18h+B*B0h+C*38h)/100h
 add  r0,r0,lsl 1                       ;
 sub  r0,r3,lsl 1                       ;
 add  r0,r1,lsl 2                       ;
 mov  r0,r0,lsr 5                          ;
 xor  r7,r0,lsl 8                       ;/
 add  r0,r1,r3,lsl 1                    ;\
 add  r0,r0,r0,lsl 2                    ; (A*10h+B*A0h+C*50h)/100h
 add  r0,r2                             ;
 mov  r0,r0,lsr 4                          ;
 xor  r7,r0,lsl 16                      ;/
 add  r0,r1,r3,lsl 1                    ;\
 add  r0,r0,lsl 3                       ; (A*08h+B*90h+C*68h)/100h
 add  r0,r1,lsl 2                       ;
 add  r0,r2                             ;
 mov  r0,r0,lsr 5                          ;
 xor  r7,r0,lsl 24                      ;/
 stmia [r9]!,r4,r5,r6,r7                ;-output
 mov  r2,r8,lsr 16      ;new            ;\fetch new
 and  r2,0ffh                           ;/
 add  r0,r3,r1                          ;\(A*80h+B*80h+C*00h)/100h
 xor  r4,r10,r0,lsr 1                   ;/
 add  r0,r3,r1,lsl 1                    ;\
 add  r0,r0,lsl 3                       ; (A*68h+B*90h+C*08h)/100h
 add  r0,r3,lsl 2                       ;
 add  r0,r2                             ;
 mov  r0,r0,lsr 5                          ;
 xor  r4,r0,lsl 8                       ;/
 add  r0,r3,r1,lsl 1                    ;\
 add  r0,r0,r0,lsl 2                    ; (A*50h+B*A0h+C*10h)/100h
 add  r0,r2                             ;
 mov  r0,r0,lsr 4                          ;
 xor  r4,r0,lsl 16                      ;/
 add  r0,r3,r2                          ;\
 add  r0,r1,lsl 3                       ; (A*38h+B*B0h+C*18h)/100h
 add  r0,r0,lsl 1                       ;
 sub  r0,r1,lsl 1                       ;
 add  r0,r3,lsl 2                       ;
 mov  r0,r0,lsr 5                          ;
 xor  r4,r0,lsl 24                      ;/
 add  r0,r1,r1,lsl 1                    ;\
 add  r0,r3,r0,lsl 1                    ; (A*20h+B*C0h+C*20h)/100h
 add  r0,r2                             ;
 xor  r5,r10,r0,lsr 3                   ;/
 add  r0,r2,r3                          ;\
 add  r0,r1,lsl 3                       ; (A*18h+B*B0h+C*38h)/100h
 add  r0,r0,lsl 1                       ;
 sub  r0,r1,lsl 1                       ;
 add  r0,r2,lsl 2                       ;
 mov  r0,r0,lsr 5                          ;
 xor  r5,r0,lsl 8                       ;/
 add  r0,r2,r1,lsl 1                    ;\
 add  r0,r0,r0,lsl 2                    ; (A*10h+B*A0h+C*50h)/100h
 add  r0,r3                             ;
 mov  r0,r0,lsr 4                          ;
 xor  r5,r0,lsl 16                      ;/
 add  r0,r2,r1,lsl 1                    ;\
 add  r0,r0,lsl 3                       ; (A*08h+B*90h+C*68h)/100h
 add  r0,r2,lsl 2                       ;
 add  r0,r3                             ;
 mov  r0,r0,lsr 5                          ;
 xor  r5,r0,lsl 24                      ;/
 mov  r3,r8,lsr 24      ;new            ;-fetch new
 add  r0,r1,r2                          ;\(A*80h+B*80h+C*00h)/100h
 xor  r6,r10,r0,lsr 1                   ;/
 add  r0,r1,r2,lsl 1  ;r2*02h+r1        ;\
 add  r0,r0,lsl 3     ;r2*12h+r1*9      ; (A*68h+B*90h+C*08h)/100h
 add  r0,r1,lsl 2     ;r2*12h+r1*0Dh    ;
 add  r0,r3           ;r2*12h+r1*0Dh+r3 ;
 mov  r0,r0,lsr 5                          ;
 xor  r6,r0,lsl 8                       ;/
 add  r0,r1,r2,lsl 1  ;r2*2+r1          ;\
 add  r0,r0,r0,lsl 2  ;r2*0ah+r1*5      ; (A*50h+B*A0h+C*10h)/100h
 add  r0,r3                             ;
 mov  r0,r0,lsr 4                          ;
 xor  r6,r0,lsl 16                      ;/
 add  r0,r1,r3        ;r1*1+r3*1        ;\
 add  r0,r2,lsl 3     ;r1*1+r3*1+r2*8   ; (A*38h+B*B0h+C*18h)/100h
 add  r0,r0,lsl 1     ;r1*3+r3*3+r2*18h ;
 sub  r0,r2,lsl 1     ;r1*3+r3*3+r2*16h ;
 add  r0,r1,lsl 2     ;r1*7+r3*3+r2*16h ;
 mov  r0,r0,lsr 5                          ;
 xor  r6,r0,lsl 24                      ;/
 add  r0,r2,r2,lsl 1  ;r2*3             ;\
 add  r0,r1,r0,lsl 1  ;r2*6+r1          ; (A*20h+B*C0h+C*20h)/100h
 add  r0,r3           ;r2*6+r1+r3       ;
 xor  r7,r10,r0,lsr 3                   ;/
 add  r0,r3,r1        ;r3*1+r1*1        ;\
 add  r0,r2,lsl 3     ;r3*1+r1*1+r2*8   ; (A*18h+B*B0h+C*38h)/100h
 add  r0,r0,lsl 1     ;r3*3+r1*3+r2*18h ;
 sub  r0,r2,lsl 1     ;r3*3+r1*3+r2*16h ;
 add  r0,r3,lsl 2     ;r3*7+r1*3+r2*16h ;
 mov  r0,r0,lsr 5                          ;
 xor  r7,r0,lsl 8                       ;/
 add  r0,r3,r2,lsl 1  ;r2*2+r3          ;\
 add  r0,r0,r0,lsl 2  ;r2*0ah+r3*5      ; (A*10h+B*A0h+C*50h)/100h
 add  r0,r1                             ;
 mov  r0,r0,lsr 4                          ;
 xor  r7,r0,lsl 16                      ;/
 add  r0,r3,r2,lsl 1  ;r2*02h+r3        ;\
 add  r0,r0,lsl 3     ;r2*12h+r3*9      ; (A*08h+B*90h+C*68h)/100h
 add  r0,r3,lsl 2     ;r2*12h+r3*0Dh    ;
 add  r0,r1           ;r2*12h+r3*0Dh+r1 ;
 mov  r0,r0,lsr 5                          ;
 xor  r7,r0,lsl 24                      ;/
 stmia [r9]!,r4,r5,r6,r7                ;-output
 mov  r1,r2                             ;\shuffle prev values
 mov  r2,r3                             ;/
 subs lr,8*4
 bhi  @@lop
;blo  $        ;oops
 orr  r1,r2,lsl 8                               ;\end of curr block
 str  r1,[r11,mp3ctx_upsample_recent]           ;/
 timelog_end rdtsc_upsampler
 pop  r9,r12,pc
;SHIM-RENAMED .endm -> .endmacro
.endmacro
