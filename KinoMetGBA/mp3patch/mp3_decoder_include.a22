  ;     .import d:\Pisse32kHzLR.mp3                                ;32kHz.LR (very high cpu load, but can be just played on GBA as 32kHz&mono)
  ;     .import d:\Pisse16kHz.mp3                                  ;16kHz
    ;.import 'D:\AnnaMp3\Newer\Pisse - Fliegerbombe.mp3'           ;VBR        ;crashes at 10s on 3DS
    ;.import "D:\AnnaMp3\Newer\Nova Twins - Taxi.mp3"
    ;.import "D:\AnnaMp3\Newer\Benny Quick - Motorbiene.mp3"      ;<-- stereo

    ;.import D:\AnnaMp3\Newer\NOVATW~3.MP3,0,1024*1024*2  ;-QUICK
    ;.import D:\AnnaMp3\Newer\Pisse-~4.mp3,0,1024*500     ;/

    ;  .import D:\big-audio\sorttest.zip        ;XXX this ZIP may contain COMPRESSED mp3's (which, the prescan function may refuse them, or the mp3 decoder will be unable to play them)
    ;  .import ..\..\no$gba\pc-hdd\zip-utf8-filename-testfile.zip
;;;         .import D:\mp3mix\mp3mix.zip
