.gba
;:----------------- Mp3 decoder
;------------------
target_gba      equ (1)                         ;\
target_dsi      equ (0)                         ; enable ONE of these
target_3ds      equ (0)                         ; (NDS+DSi may be both on)
target_nds      equ (0 | target_dsi)           ;/
        XXX_nds_load_mp3_from_code_area      equ target_gba | 0;1
;---
;---
is_mp3_player                equ 1
is_wifiboot                  equ 0
;------------------
;XXX l3-si_block has a small error that doesn't occur in 80x86 version (maybe due to different 64bit smlal sum precision?)
        with_circle_pad     equ target_3ds
        with_notify_on_quit equ 0       ;should be 0 (only for testing if BPTWL power tap/held IRQs are received)
        with_sdmmc_selftest equ 01      ;should be 0 (unless for writing test files)
        use_ccnt equ 0   ;<-- XXX doesn't work on Old3DS ??? (but I did have it working in diag3ds.a22)
        directly_render_3ds_pixels equ 01
        with_qwerty equ 01
        tight_qwerty equ target_gba  ;<-- good to see list of search results on single-screen display (on left side of smaller keyboard)
        with_search equ 01
        with_new_search equ target_gba   ;for single-screen only (nds/dsi/3ds can always display the keyboard on lower screen)
        UNICODE_UTF8  equ 01  ;should be 1 (otherwise ANSI)
        FLAC_UNROLLED equ 1           ;this is good (makes FLAC 16bit Stereo 44100Hz possible on GBA)
        FLAC_CACHED   equ target_gba  ;this is good on GBA (because GBA doesn't have hardware cache, manualy caching data in FAST RAM fixes that) (not needed on NDS/DSi, which DO have hardware cache)
        with_dual_line_artist_title equ 0   ;should be 0 (dual-line is a "nice" idea, but somehow it looks "nicer" to use single-line)
        with_graffiti equ 1
        with_pitch  equ 1             ;;;PITCH   equ 100h ;+10h   ;100h=normal  ;120h=speedup
        with_options equ 1
        with_lead_silence_skip  equ 01
        with_keypad      equ 01
        with_2d_gui      equ 1
        ONLY_1ST_5SEC    equ 0;1   ;debug option (for testing playqueue)
        WITH_ZIP_ARCHIVE equ 01
        THIS_RATE_SHIFT equ 0;1   ;range 0..5 = div1..div32 (best: 1 for gba/mono, or 2 for gba/stereo)
        SELFTEST equ 0;1
        PRESCAN_UNKNOWN_SIZE equ (SELFTEST ^ 1)
        WANT_MONO            equ (SELFTEST ^ 1)       ;XXXXX bugs on some SELFTEST files (l3-he_mode, l3-sin10kdb)

        QUICK_INDEX_MEM equ 01    ;OK (for fast/dirty 16bit) (good for ARM-LDRH) (not so for MIPS)
        LARGE_INDIRECT_CTX equ 01     ;OK
        LARGE_INDIRECT_GR equ 01      ;OK (but slightly slower?)
        SUPPORT_ODD_FILL        equ 0    ;for VRAM (not required by current code)
        SUPPORT_ODD_COPY        equ 01   ;for VRAM (required by append_pool)
        SUPPORT_ODD_GRANULE     equ 0    ;for VRAM (don't use, SLOW, only needed if granule/context is in VRAM without 8bit write support)
        SUPPORT_ODD_MP2         equ 0    ;for VRAM
       SELF_CHECK       equ 0;1       ;XXX disable that (just used for testing)
        with_cut_off  equ (SELFTEST ^ 1)            ;this is GOOD (much faster, thanks Joe from nesdev)
        TEMP_IMDCT36  equ 01            ;this is GOOD (use temp delta buffer in FAST RAM)
                DOUBLE_VOLUME equ 0;2    ;0=normal, 1=double, 2=quad (this doesn't really help to get more output from the GBA speaker)
        with_cpu_load_stats     equ 01
;------------------
;nocash mp3 asm decoder - 80x86 version started mid june 2024
;working 80x86 playback 21 jul 2024
;arm version started 15 oct 2024
;---
;based on minimp3 https://keyj.emphy.de/minimp3/ (c) 2007 Martin J. Fiedler
;which was itself based FFmpeg  (c) 2001, 2002 Fabrice Bellard
;intensity_stereo is based on lieff's decoder (minimp3 was rather bugged)
;---
ver_hi  equ 1
ver_lo  equ 5
year    equ 2025
;---
.arm
.nocash on
;SHIM-REMOVED.strict
;SHIM-REMOVED.fix
;SHIM-REMOVED.ual        ;use newer UAL syntax (alternately use .pre_ual for old syntsx)
;------------------
;r0             bitstream col32 data  ;\or general regs   ;<-- but avoid using r0 for making it easier to port to MIPS (unless r0=0, or unless code is GBA-specific anyways, eg. HW or GUI code)
;r1             bitstream colPP addr  ; outside bitstream
;r2             bitstream colNN num   ;/
;r3             scratch
;r4..r9         regs
;r10            granule
;r11            context
;r12            global_fast_vars
;r13            sp
;r14            lr
;r15            pc
;------------------
;:----------------- Mp3 player
;------------------
  Xkey_a     equ 01h
  Xkey_b     equ 02h
  Xkey_sel   equ 04h
  Xkey_sta   equ 08h
  Xkey_rt    equ 10h
  Xkey_lt    equ 20h
  Xkey_up    equ 40h
  Xkey_dn    equ 80h
  Xkey_r     equ 100h
  Xkey_l     equ 200h
  Xkey_x     equ 400h    ;nds/dsi/3ds
  Xkey_y     equ 800h    ;nds/dsi/3ds
  Xkey_close equ 1000h   ;nds/dsi/3ds.shell.closed
  Xkey_debug equ 2000h   ;nds/dsi/3ds.debug
  Xkey_power equ 4000h   ;dsi/3ds.power
  Xkey_home  equ 8000h   ;3ds
  Xkey_pen   equ 10000h  ;nds/dsi/3ds.touchscr.pendown
  Xkey_sleep equ 20000h  ;nds/dsi/3ds.sleep.limit
  Xkey_empty equ 40000h  ;dsi/3ds.battery.empty
  Xkey_qwerty_char equ 0ff000000h ;bit24-31
  Xkey_qwerty_char_bit equ 24     ;bit24-31
    Xkey_all  equ 3ffh
  Xkey_none equ 000h
  Xkeyrep_1st equ 12
  Xkeyrep_2nd equ 4
;------------------
   force_8bit equ 01 * (SELFTEST ^ 1)        ;XXX instead of option_8bit
   with_upsample equ (SELFTEST ^ 1)
        with_upsample_mid_way equ with_upsample
 with_standard_features equ 1   ;standard version with all commandline switches
 be_fast                equ 1   ;want fast code
 prefer_dirty           equ force_8bit   ;this is don't care here (if with_fast_option is enabled)
;------------------
with_output_to_speaker  equ (SELFTEST ^ 1) *01      ;\
with_verify_to_pcm_file equ SELFTEST                  ; enable at least one of these
with_raw_testing        equ with_standard_features    ;/
with_8bit_output        equ with_standard_features    ;\
with_rate_shift         equ with_standard_features    ; extra options
with_fast_option        equ with_standard_features*0    ;/
with_free_format        equ 1                         ;-obscure feature
with_mp2_audio          equ with_standard_features    ;-extra feature
with_wav_audio          equ with_standard_features    ;-extra feature
with_aiff_audio         equ with_standard_features    ;-extra feature
with_au_audio           equ with_standard_features    ;-extra feature
with_flac_audio         equ with_standard_features*01  ;-extra feature
with_echo               equ target_nds | target_dsi | target_3ds
with_sdmmc              equ target_nds | target_dsi | target_3ds
with_touchscr           equ (target_nds | target_dsi | target_3ds) & with_search
with_dldi               equ target_nds | target_dsi
;------------------
log_file_info           equ with_standard_features
log_timing              equ with_raw_testing
log_statistics          equ with_raw_testing
log_channel_sizes       equ log_statistics
log_memory              equ 01
log_init                equ 0;1         ;\
log_frames              equ 0;1         ; should be 0
log_crc16               equ 0;1         ; (except for debugging)
log_granules            equ 0;1         ;
log_scalefac            equ 0;1         ;   ;\
log_huffcodes           equ 0;1         ;   ;
log_reorder             equ 0;1         ;   ; these output a LOT of data
log_antialias           equ 0;1         ;   ;
log_imdct               equ 0;1         ;   ;
log_synth_dct32         equ 0;1         ;   ;
log_synth_output        equ 0;1         ;/  ;/
;------------------
code_align  equ 4
data_align  equ 4
cache_align equ 20h  ;20h for NDS/DSi
;------------------
with_tech_info         equ 1
with_rtc               equ target_nds | target_dsi | target_3ds
with_tsc               equ target_nds | target_dsi | target_3ds
with_rtc_vol_bat       equ target_nds | target_dsi | target_3ds
with_up_next           equ 1
with_tab_bar           equ 1
with_crc16             equ (0 | log_crc16)  ;should be 0 (slow, and not useful)
;------------------
  ;xxx eye: new glasses
  ;xxxx speed: for rate_shift --> try to collapse synth_buf,synth_win to less entries (instead of skipping unused entries), maybe gives better caching?
  ;xxxx speed: try smaller CHILD_BITS for old CPUs with smaller cache
  ;xxx speed: WITHOUT_ZEROES --> if num_zeroes (from prev frame) is known --> don't need to zeropad those again
  ;xxx speed: for synth_win, try 16bit mul ax,dx (but may need to pre-shift when VVRAC>15)
  ;xxx speed: synth_win contains DUPLICATED and NEGATED values - could that be used to avoid DUPLICATED multiplications?
  ;xxx accuracy: try to cripple 32bit constants to same precision as single-precision-float (or whatever the official decoder was using)
  ;xxx info: calc/display assumed duration based on filesize/bitrate (that is, filesize excluding ID3)
        LEAD_SHR        equ 6         ;XXX six or whatever (sensitivity for NEAR-SILENCE check)
        SYNTH32         equ 01 ;;-prefer_dirty           ;XXX when OFF: can be a bit faster, and that'd be good enough for prefer_dirty... BUT may require to implement SINGLE_SAT=0 (to avoid overflows)
        SINGLE_SAT      equ SYNTH32   ;XXXXXX only for SYNTH32 and large WFRAC (with final output multiply result in edx)
        COLL_MACRO      equ be_fast   ;\only good when BOTH are on
        HUFF_MACRO      equ be_fast   ;/
        WITHOUT_ZEROES  equ be_fast   ;XXX this is GOOD, v1.2
        ALREADY_PADDED  equ be_fast   ;XXX cleanup, merge with WITHOUT_ZEROES
        UNROLL_DCT0     equ 000       ;XXX this is GOOD !!!! ("dec/jnz" instead "loop" does also help, but unrolling is yet faster)
        QUICK_SIGN      equ 1         ;XXX this is ALWAYS GOOD !!!! (always on, because it's fast AND small)
        FAST_SMALL      equ be_fast   ;XXX this is GOOD !!!!
        RUN_LENGTH      equ be_fast   ;XXX this is GOOD !!!!
        COARSE_END      equ be_fast   ;XXX is now faster (but exceeds 9.5Kbyte)
        ZERO_WINDOW     equ 0         ;XXX should be OFF (half rate is slighly faster when skipping instead of duing dummy-zero multiplies)
        LONG_WINDOW     equ be_fast   ;XXX this is GOOD !!! slightly faster, but slightly bigger when compressed
        MERGE_TABLE_4_3 equ 01       ;XXX bad, not faster, and less accurate
        INTERLEAVE_STEREO equ 0   ;for mp2 (should be 0 to match mp2_samples with current mp3_synth format)
        RECENT_HEADER   equ be_fast   ;XXXXXXXX
        MONO_CONVERT    equ 01     ;GOOD but slower (needed for files that contain mixed M/S and L/R stereo, which would sound bad when playing only raw ch0, which could alternate between M or L channel)
        MONO_ISTEREO    equ 01     ;GOOD but maybe NOT FULLY needed, and MAYBE ONLY needed for LSF files?)
        TIGHT_SYN_IDX   equ 01       ;XXX uhm
        TIGHT_SYN_BUF   equ 01       ;XXX this is GOOD (tighter caching and a bit faster)
        TIGHT_SYN_WIN   equ 0        ;XXX uhm, tighter caching, but it can be slightly SLOWER-OR-FASTER depending on CODE-ALIGNMENT)
        TIGHT_HUFF      equ 01     ;saves memory (and speed is SAME for 16bit VRAM bus) (but would be SLOWER when having 32bit bus)
                                   ;XXX above TIGHT_HUFF doesn't actually save memory yet (because buffer is always allocated 32bit wide, and then collapsed to 16bit)
        TOTAL_TSC_ONLY  equ 0;1   ;XXXXX measure ONLY total cycles (FASTER and SMALLER, less overload !!!)


      force_fast equ prefer_dirty          ;XXX instead of option_fast
      INTERLEAVE_LEFT_RIGHT equ 0
      FAST_CBRT         equ 01      ;XXX could also quick-skip GROUPS of leading zeroes, and when force_8bit or MERGE_TABLE_4_3, return 16..24bit result

;---
;MP3_FRAME_SIZE           equ 1152   ;whatever (576*2)
;MP3_MAX_CODED_FRAME_SIZE equ 1792   ;whatever (700h) (maybe some compressed size?)
MP3_MAX_CHANNELS         equ 2
SBLIMIT                  equ 32
MP3_STEREO               equ 0  ;raw stereo left/right encoding     ;\
MP3_JSTEREO              equ 1  ;joint stereo mid/side or intensity ;
MP3_DUAL                 equ 2  ;raw two mono channels              ;
MP3_MONO                 equ 3  ;raw single mono channel            ;/
MODE_EXT_I_STEREO        equ 1  ;\for JSTEREO   ;intensity stereo (aka channel 0, with panning)
MODE_EXT_MS_STEREO       equ 2  ;/              ;mid/side stereo
CHILD_BITS               equ 7  ;9   ;7     ;XXX ;original in minimp3 was 7  ;PentiumIII: fastest is 9..10 (larger values get slower, maybe exceeding cache size)
;------------------
  ;default are V=15, W=14, better are V=18, W=11 (or yet better W=12, but that may overflow?)
   ;XXX for l3-si_huff.bit, sum of below should be 2 smaller, eg. 17+10, or 16+11, or 18+9) (... may also depend on SINGLE_SAT on/off)
   VFRAC_BITS_fast       equ (18-0) ;18 ;-default=15   ;<-- less than 10 makes evil background noise
   WFRAC_BITS_fast       equ (11-0) ;11 ;-default=14   ;<-- can be even smaller than 14 (even 4 isn't so bad, and even 1 does still produce recognizable audio)
  SUM_SHIFT_fast         equ (0)    ;0=default/fastest (bigger may avoid sum/add overflows)
  OUT_SHIFT_fast         equ (WFRAC_BITS_fast + VFRAC_BITS_fast - SUM_SHIFT_fast - 15)
  VFRAC_BITS_default    equ VFRAC_BITS_fast
  WFRAC_BITS_default    equ 16  ;constant table in ARM version is always 16bit (unlike 80x86 version)
;note: OUT_SHIFT implies the fraction for final SUM additions (so it should be bigger than 0, about 6 or so)
;      (or ideally, it would be 32, when including the LSW of multipy result in sum, eg. on ARM with SMLAL opcode)
;------------------
MP3_MAX_OUTPUT_SIZE equ 2*2*18*32*2   ;=1200h = 4608 decimal = 2 channels, 2 granules, 18*32, 2 byte(16bit)
;for actual size, see [mp3ctx_samples_output_size]
;------------------
;:----------------- Mp3 cart header (gba)
;------------------
;SHIM-REMOVED.code
;------------------
.gba
.arm
;- - - - - --------
      RELOC_CODE      equ 01        ;OK   ;\use GBA Fast RAM
      USE_FAST_DATA   equ 01        ;OK   ;/and relocate code snippets to it
        MEM_DATA     equ 02000000h   ;XXX or 3000000h
        MEM_DATA_MAX equ 02040000h  ;max 256K main ram
        MEM_VRAM     equ 06000000h
        MEM_VRAM_OBJ equ 06010000h
        MEM_VRAM_MAX equ 06018000h  ;max 96K vram
        MEM_OAM      equ 07000000h
        MEM_PALETTE  equ 05000000h
;SHIM-CHANGED: MEM_ROM used to be a fixed literal ('MEM_ROM equ 0x....'), then briefly a
;'.definelabel MEM_ROM, org()' dynamic capture. Testing found THAT caused armips's optimizer
;to stop collapsing 'ldr rX,=MEM_ROM+expr' into compact mov/mvn immediates (label-derived
;expressions apparently take a different codepath than plain-equ literal expressions), which
;made the whole assembled blob balloon from the correct ~0x20000 bytes to ~0x2BA000+ bytes --
;confirmed by A/B testing: an identical file differing ONLY in .definelabel-vs-equ for this
;one symbol (same numeric value either way) reproduced the same blowup. So MEM_ROM must now
;be a REAL 'equ' literal, computed OUTSIDE armips (Python reads ROMFILENAME's byte size,
;adds 0x8000000, word-aligns) and injected on the command line via
;'-equ MEM_ROM 0x........' before this file is processed -- see build_mp3_blob.py. This also
;keeps the earlier-fixed equ-retokenization hazard closed, since the literal is computed once
;in Python, not re-derived via a self-referential 'equ ... org()' expression inside armips.
;(No '.if defined(MEM_ROM)' guard here: armips substitutes an -equ'd name's TEXT at
;tokenize time, so by the time any .if here could run, a defined MEM_ROM has already been
;replaced by its numeric literal and an undefined one is a plain "unknown identifier" parse
;error at first use below -- either way the failure is immediate and points at this file.)
        MEM_ROM_MAX  equ 0A000000h
        MEM_SRAM     equ 0E000000h
        ;SHIM-FIXED: was 3000000h (ORIGIN(iwram) exactly) -- collided with KiNoMet's own
        ;.bss/.data. devkitARM's stock gba_cart.ld continues KiNoMet's ordinary global
        ;variables (every plain global/static, not just anything IWRAM-tagged) starting
        ;at real hardware IWRAM's base, 0x03000000, immediately after any explicitly
        ;.iwram-tagged code -- confirmed against the real compiled KinometGBA.elf's own
        ;symbol table: __bss_start = 0x03000000, .bss+.data+.init_array totaling 0x1f40
        ;(7968) bytes there. This constant is the base of EVERY relocation this decoder
        ;does (mp3_kernel_reloc_dst directly; mp3_reloc_kernel_max/mp3_reloc_main_max and
        ;everything chained off them -- mp3_decoder_reloc_dst, the mp3_synth_N_reloc_dst
        ;group, init_reloc_dst, mp1mp2/misc/flac_decoder_reloc_dst -- transitively, since
        ;each is a label placed at the end of the previous excursion). Confirmed by real
        ;armips assembly + a full symbol dump (not guessed): with the stock 0x03000000,
        ;this decoder's real (non-mirror/non-overlapping) peak IWRAM footprint is
        ;kernel(0x2194) + largest-decoder-variant(mp3_decoder_reloc_siz=0x25C8) +
        ;synth(mp3_synth_0_reloc_siz=0x12F8) = 0x5A54 (23124) bytes, ending at 0x03005A54
        ;-- so the first-ever decode call's kernel DMA copy to 0x03000000 stomped directly
        ;over KiNoMet's live globals (tsize, TickCounter, requestCount, vblankcounter,
        ;lastVblank, fps, ...), corrupting state that an existing, otherwise-correct
        ;while(1) trap loop then (correctly) tripped on.
        ;
        ;Fix: shift this base up by 0x2000 (8192) bytes, past KiNoMet's current 0x1f40
        ;(7968)-byte static footprint (leaving it ~192 bytes of room to grow before
        ;re-colliding -- tight, but real). Re-verified by real armips assembly that the
        ;shifted peak (now ending at 0x03007A54) still clears this file's own existing
        ;"> gba_stackbottom" .error guards (gba_stackbottom = 0x03007c00), with 0x1AC
        ;(428) bytes to spare before the stack-reserved top of IWRAM.
        ;
        ;IMPORTANT CAVEAT, not yet resolved: this only accounts for KiNoMet's STATIC
        ;.bss/.data. KiNoMet also actively uses the heap during MP3 playback --
        ;AudioV3::GetNextFrame() calls "new AudioKinometPacket(...)" every single audio
        ;frame, and Cinepak/Compression use malloc() during concurrent video decode -- and
        ;the heap (__iheap_start, right after KiNoMet's .data) grows upward from ~0x1f40
        ;toward wherever devkitARM's default GBA heap implementation bounds it. With this
        ;shift, that leaves only ~0xC0 (192) bytes between __iheap_start and this new,
        ;higher decoder base before the heap would grow into the decoder's own relocated
        ;code. IWRAM is extremely tight here regardless of how this budget is split --
        ;this decoder alone uses ~23KB of the 32KB total. If the "never gets past boot"
        ;hang is fixed by this but a NEW symptom appears instead after a few seconds of
        ;actual playback (garbage audio, a crash, or a different hang -- rather than
        ;immediately at boot), that's the live heap growing into this region, and would
        ;need a follow-up fix (most likely: give KiNoMet's heap real EWRAM room instead of
        ;IWRAM, which needs devkitARM's own gba_cart.ld and libgba's heap/sbrk source to
        ;get right without guessing -- not yet attempted, see chat).
        CURR_WRAM_ADDR equ 3002000h  ;<-- increasing/redefined label
        sysclk equ 16*1024*1024   ;GBA sysclk 16.78MHz
        SNDCLK equ (sysclk)
        vblank_clks equ 280896         ;for GBA
        vram_obj_siz   equ 800h
        vram_obj_tiles equ MEM_VRAM_MAX-vram_obj_siz
;- - - - - --------
org MEM_ROM
rom_code_data_start:
 b     gba_entrypoint                           ;-entry point
 dcb   024h,0FFh,0AEh,051h,069h,09Ah,0A2h,021h  ;\
 dcb   03Dh,084h,082h,00Ah,084h,0E4h,009h,0ADh  ;
 dcb   011h,024h,08Bh,098h,0C0h,081h,07Fh,021h  ;
 dcb   0A3h,052h,0BEh,019h,093h,009h,0CEh,020h  ;
 dcb   010h,046h,04Ah,04Ah,0F8h,027h,031h,0ECh  ;
 dcb   058h,0C7h,0E8h,033h,082h,0E3h,0CEh,0BFh  ;
 dcb   085h,0F4h,0DFh,094h,0CEh,04Bh,009h,0C1h  ; Nintendo Logo
 dcb   094h,056h,08Ah,0C0h,013h,072h,0A7h,0FCh  ;
 dcb   09Fh,084h,04Dh,073h,0A3h,0CAh,09Ah,061h  ;
 dcb   058h,097h,0A3h,027h,0FCh,003h,098h,076h  ;
 dcb   023h,01Dh,0C7h,061h,003h,004h,0AEh,056h  ;
 dcb   0BFh,038h,084h,000h,040h,0A7h,00Eh,0FDh  ;
 dcb   0FFh,052h,0FEh,003h,06Fh,095h,030h,0F1h  ;
 dcb   097h,0FBh,0C0h,085h,060h,0D6h,080h,025h  ;
 dcb   0A9h,063h,0BEh,003h,001h,04Eh,038h,0E2h  ;
 dcb   0F9h,0A2h,034h,0FFh,0BBh,03Eh,003h,044h  ;
 dcb   078h,000h,090h,0CBh,088h,011h,03Ah,094h  ;
 dcb   065h,0C0h,07Ch,063h,087h,0F0h,03Ch,0AFh  ;
 dcb   0D6h,025h,0E4h,08Bh,038h,00Ah,0ACh,072h  ;
 dcb   021h,0D4h,0F8h,007h                      ;/
 dcb   "NOCASH MP3  "                           ;-title (12 bytes)
 dcb   0,0,0,0                                  ;-game code (4 bytes)
 dcb   "0$"      ;nocash                        ;-maker code (2 bytes)
 dcb   96h                                      ;-fixed value 96h
 dcb   0                                        ;-main unit code
 dcb   0                                        ;-device type
 dcb   0,0,0,0,0,0,0                            ;-reserved (7 bytes)
 dcb   0                                        ;-software version number
 dcb   0                                        ;-header checksum (set by .fix)
 dcb   0,0                                      ;-reserved (2 bytes)
;- - - - ----------
 b     org()           ;-Multiboot normal/multiplay mode entry point (none such because mp3 requires RAM for DATA, not leaving much space for CODE in RAM, even if the mp3 SONGs were stored elsewhere; on ROM or SD card)
multiboot_flags:
 dcb   0           ;-multiboot reserved byte (overwritten by boot mode value)
 dcb   0           ;-multiboot reserved byte (overwritten by slave ID number)
 dcb   0,0         ;-blank padded for 32bit/word alignment
 dcb   0,0         ;-reserved for RTC io port
 dcb   0,0         ;-blank padded for 32bit/word alignment
;- - - - ----------
 .align 4
  db "SRAM_Vnnn"        ;SRAM, 32Kbytes
 ;db 'FLASH1M_V123'
 ;db 'FLASH512_V123'
 ;db 'FLASH_V123'
 .align 4
 ;---
 screen_x_total         equ 240
 screen_y_total         equ 160
 bgs    equ 5             ;bg shift.step      ;\32 tiles per line
 bgw    equ (1 << bgs)   ;bg width.step      ;/
 ;---
 gba_stackbottom     equ 3007c00h
 gba_stacktop_usr    equ 3007f00h
 gba_stacktop_irq    equ 3007fa0h
 gba_stacktop_svc    equ 3007fe0h
 timer_msw           equ 3fffff4h    ;aka 3007fe8h
 gba_irq_check       equ 3fffff8h    ;aka 3007ff8h
 gba_soft_res_flag   equ 3fffffah    ;aka 3007ffah
 gba_irq_vector      equ 3fffffch    ;aka 3007ffch
 mp3_fast_ram_stack_siz equ 3008000h-gba_stackbottom
;- - - - - --------
 swi_halt              equ 02h << 16
 swi_wait_by_loop      equ 03h << 16
;- - - - - --------
 REGBASE_IO      equ 4000000h ;-BASE
 REG_DISPCNT     equ 000h     ;\
 REG_DISPSTAT    equ 004h     ;
 REG_BG0CNT      equ 008h     ; LCD
 REG_BG0HVOFS    equ 010h     ;
 REG_BG0HOFS     equ 010h     ;
 REG_BG0VOFS     equ 012h     ;/
 REG_SOUNDCNT    equ 080h     ;\
 REG_SOUNDBIAS   equ 088h     ; SOUND
 REG_SND_FIFO_A  equ 0A0h     ;
 REG_SND_FIFO_B  equ 0A4h     ;/
 REG_DMA0_SAD    equ 0B0h     ;\
 REG_DMA0_DAD    equ 0B4h     ; DMA0
 REG_DMA0_CNT    equ 0B8h     ;/
 REG_DMA1_SAD    equ 0BCh     ;\
 REG_DMA1_DAD    equ 0C0h     ; DMA1
 REG_DMA1_CNT    equ 0C4h     ;/
 REG_DMA2_SAD    equ 0C8h     ;\
 REG_DMA2_DAD    equ 0CCh     ; DMA2
 REG_DMA2_CNT    equ 0D0h     ;/
