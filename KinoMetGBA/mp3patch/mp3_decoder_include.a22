;------------------
;SHIM-REMOVED.code
;------------------
;:----------------- Mp3 UI Statistics
;------------------
;------------------
show_statistics:
 push lr
 ldr  r5,=txt_mode_stats
 bl   tty_wrstr_r5
 mov  r9,0
@@mode_lop:
 add  r4,r11,mp3ctx_mode_stats
 ldr  r4,[r4,r9,lsl 2]
 cmp  r4,0
 beq  @@mode_next
 ldr  r5,=mp3_mode_names                ;\
   ldr   r3,[r11,mp3ctx_layer]          ;
   cmp   r3,fmt_flac                    ; name
   ldreq r5,=flac_mode_names            ;
 ldr  r5,[r5,r9,lsl 2]                  ;
 bl   tty_wrstr_r5                      ;/
 mov  r5,100
 mul  r4,r5,r4
 ldr  r5,[r11,mp3ctx_num_frames_decoded]
 bl   rom_div_r4_r5
 cmp  r4,0   ;\round-up nonzero
 moveq r4,1  ;/
 bl   tty_decimal_r4
 mov  r4,'%'
 bl   tty_wrchr_r4
@@mode_next:
 add  r9,1
 cmp  r9,10h
 blo  @@mode_lop
 bl   tty_wrcrlf
 ;- - -
   ldr  r5,=txt_channel_sizes
   bl   tty_wrstr_r5
   ldr  r4,[r11,mp3ctx_channel_sizes+0*4]       ;\ch0
   bl   tty_decimal_r4_with_thousands_separator ;/
   bl   tty_wrcomma
   bl   tty_wrspc
   ldr  r4,[r11,mp3ctx_channel_sizes+1*4]       ;\ch1 (usually SAME .. HALF size of ch0)
   bl   tty_decimal_r4_with_thousands_separator ;/    (XXX does that possibly include dummy-zero-padding in some files?)
   bl   tty_wrcrlf                                       ;(XXX should also show size of unused bits, ie. mp3_bodysize, minus above channel sizes)
 pop  pc
;------------------
;------------------
;:----------------- Hardware I/O
;------------------
.macro cpu_disable_irqs
 mov  cpsr,0dfh ;sys            ;-disable IRQs
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
.macro cpu_enable_irqs
 mov  cpsr,01fh ;sys            ;-enable IRQs
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
.macro maincpu_cp15_halt_mac
   swi  swi_halt                ;GBA / ARM7 Halt
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
.macro get_cycle_count_32bit_mac   ;out: r4
  @@retry:
   mov    r3,REGBASE_IO
   add    r3,180h
   ldrh   r2,[r3,REG_TIMER3CNT-180h]  ;timer3
   ldrh   r4,[r3,REG_TIMER2CNT-180h]  ;timer2
   ldrh   r3,[r3,REG_TIMER3CNT-180h]  ;timer3
   cmp    r3,r2
   bne    @@retry
   orr    r4,r4,r2,lsl 16    ;timer.lsw
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
.macro get_cycle_count_mac   ;out: r5:r4
  @@retry:
   mov    r3,REGBASE_IO
   add    r3,180h
   ldrh   r6,[r3,REG_TIMER3CNT-180h]      ;timer3
   ldrh   r4,[r3,REG_IF-180h]             ;irq.flags
   ands   r4,1 << 6                      ;irq.timer3
   strneh r4,[r3,REG_IF-180h]             ;irq.ack
   ldr    r5,[r3,timer_msw-4000000h-180h] ;timer.msw
   addne  r5,1                            ;timer.msw
   strne  r5,[r3,timer_msw-4000000h-180h] ;timer.msw
   ldrh   r4,[r3,REG_TIMER2CNT-180h]      ;timer2
   ldrh   r3,[r3,REG_TIMER3CNT-180h]      ;timer3
   cmp    r3,r6
   bne    @@retry
   orr    r4,r4,r6,lsl 16    ;timer.lsw
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
rom_cpu_halt:
   get_cycle_count_32bit_mac                    ;\
   mov  r5,r4                                   ;/
   maincpu_cp15_halt_mac                        ;--> wait for IRQ
   get_cycle_count_32bit_mac                    ;\
   sub  r4,r5                                   ;/
   ldr  r3,=rdtsc_idle                          ;\
   ldr  r2,[r3,0]                               ;
   adds r2,r4                                   ; raise global idle counter
   str  r2,[r3,0]                               ;
   ldrcs r2,[r3,4]                              ;
   adccs r2,0                                   ;
   strcs r2,[r3,4]                              ;/
   cpu_disable_irqs
   ldr  r3,=cpu_stats_index                     ;\get index
   ldr  r2,[r3]                                 ;/
   ldr  r3,=cpu_stats_list                      ;\
   ldr  r5,[r3,r2,lsl 2]                        ; raise val[index]
   add  r5,r4                                   ;
   str  r5,[r3,r2,lsl 2]                        ;/
   cpu_enable_irqs
 bx   lr
;------------------
 ;--- --- ---
 init_timelog:
    mov  r4,REGBASE_IO
    mov  r5,80h << 16            ;start, prescaler/1
    str  r5,[r4,REG_TIMER2CNT]    ;timer2
    mov  r5,0c4h << 16           ;start, count-up, irq.enable
    str  r5,[r4,REG_TIMER3CNT]    ;timer3
  ;---
  bx   lr
 ;--- --- ---
 .macro timelog_start, t     
  .if (TOTAL_TSC_ONLY==0) | (t==rdtsc_total)
   get_cycle_count_mac    ;-read timestamp counter (to r5:r4)
   ldr   r3,=t          ;\
   ldr   r6,[r3,0]  ;\    ;
   subs  r6,r4      ; lsw ; exclude origin from time
   str   r6,[r3,0]  ;/    ;
   ldr   r6,[r3,4]  ;\    ;
   sbc   r6,r5      ; msw ;
   str   r6,[r3,4]  ;/    ;/
  .endif
;SHIM-RENAMED .endm -> .endmacro
.endmacro
 ;--- --- ---
 .macro timelog_end, t   
  .if (TOTAL_TSC_ONLY==0) | (t==rdtsc_total)
   get_cycle_count_mac    ;-read timestamp counter (to r5:r4)
   ldr   r3,=t          ;\
   ldr   r6,[r3,0]  ;\    ;
   adds  r6,r4      ; lsw ; raise time (with origin excluded above)
   str   r6,[r3,0]  ;/    ;
   ldr   r6,[r3,4]  ;\    ;
   adc   r6,r5      ; msw ;
   str   r6,[r3,4]  ;/    ;/
  .endif
;SHIM-RENAMED .endm -> .endmacro
.endmacro
 ;--- --- ---
;------------------
  rom_dma3_memcopy:
   mov  r3,REGBASE_IO
   mov  r6,r6,lsr 2   ;len/4 (words)
   orr  r6,84000000h  ;32bit,start
   str  r4,[r3,REG_DMA3_SAD]
   str  r5,[r3,REG_DMA3_DAD]
   str  r6,[r3,REG_DMA3_CNT]
  @@wait:                         ;\
   ldr  r6,[r3,REG_DMA3_CNT]      ; wait (probably not needed)
   tst  r6,80000000h              ; (cpu should stop while executing this or other dma's)
   bne  @@wait                    ;/
   bx   lr
;------------------
abort_stop_playback_dma:   ;in: r11
 push lr
 bl   hw_abort_stop_playback_dma
 ldr  r1,[r11,mp3ctx_stream_pos]          ;src  ;\force end
 str  r1,[r11,mp3ctx_stream_end]          ;end  ;/
 mov  r1,0                                      ;\discard pause (if any)
 str  r1,[r11,pause_flag]                       ;/
 pop  pc
;------------------
;:----------------- Hardware I/O (GBA)
;------------------
;------------------
.macro scale_clks_r5r4
 ;nothing to do on GBA (the 16MHz timer clk match up with 16MHz cpu clk)
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
dev_id_mmap     equ 0  ;dummy
drv_flg_queued  equ 40h
;------------------
init_interrupts:
 mov  r7,REGBASE_IO                                             ;-I/O base
 ldr  r1,=gba_irq_vector                                        ;\
 ldr  r0,=gba_irq_handler                                       ; IRQ handler
 str  r0,[r1]                                                   ;/
 mov  r0,08h                            ;\set BG Stat, enable vblank IRQ
 strb r0,[r7,REG_DISPSTAT]              ;/
 ldr  r1,=(1 << 0)+(1 << 4)+(1 << 13) ;vblank+timer1+gamepak ;\
 mov  r2,r1,lsl 16                      ;msw=ack bits           ;
 str  r2,[r7,REG_IE_IF]  ;=xxxx0000h    ;IF (ack any old)       ;
 str  r1,[r7,REG_IE_IF]  ;=0000xxxxh    ;IE (enable)            ; IRQs
 mov  r1,1                                                      ;
 str  r1,[r7,REG_IME]                   ;IME                    ;/
 bx   lr
;------------------
init_stack_and_memory:
   mov  cpsr_ctl,0c0h+13h ;svc.disable IRQs
   ldr  sp,=gba_stacktop_svc   ;equ 3007fe0h
   mov  cpsr_ctl,0c0h+12h ;irq.disable IRQs
   ldr  sp,=gba_stacktop_irq   ;equ 3007fa0h
  ;mov  cpsr_ctl,0c0h+1fh ;sys.disable IRQs    ;<--when IRQs off, first sample block gets played twice
   mov  cpsr_ctl,000h+1fh ;sys.enable IRQs
   ldr  sp,=gba_stacktop_usr   ;equ 3007f00h
;- - -
 mov  r0,REGBASE_IO                                ;-I/O Base            ;Fliegerbombe 320kbit on mp3gba v1.3
;mov  r1,0000h   ;initial 4,2 clks, no prefetch    ;\gamepak timings     ;<-- 10,016,271 clks (power up default)
;ldr  r1,=431bh  ;fastest 2,1 clks, with prefetch  ; (3,1 is slightly    ;<--  9,975,970 clks (bad, doesn't work on "FLASHadvanceCARD 256M")
 ldr  r1,=4317h  ;common  3,1 clks, with prefetch  ; faster than 4,2)    ;<--  9,991,225 clks (this retail standard, and should also work on all flashcards)
 str  r1,[r0,REG_WAITCNT]                          ;/
;XXX for below, could try to detect GBA micro (and if so, skip the overclocked setting)...
;ldr  r1,=0d000020h ;initial/official ram 3,3 clks ;\                    ;<--  9,991,234 clks
;ldr  r1,=0e000020h ;undoc/overclock  ram 2,2 clks ; main ram timing     ;<--  9,915,155 clks (but CRASHES on GBA micro, and IGNORED on NDS)
;str  r1,[r0,REG_RAMCNT]                           ;/
;- - -
   mov  r4,3000000h
   mov  r5,8000h
   mov  r3,0
  @@zerofill_lop_fast_ram:         ;REQUIRED on 3DS (when using bootstub with SWI without clearing all RAM)
   str  r3,[r4],4
   subs r5,4
   bne  @@zerofill_lop_fast_ram
 bx   lr
;------------------
hw_load_options:
 mov  r4,MEM_SRAM                  ;src ;\
 ldr  r5,=temp_options             ;dst ; copy byte-wise (for 8bit bus)
 mov  r6,temp_options_max_len           ;
 b    memcopy_bytewise_for_8bit_bus     ;/
;------------------
hw_save_options:
 ldr  r4,=temp_options             ;src ;\
 mov  r5,MEM_SRAM                  ;dst ; copy byte-wise (for 8bit bus)
 mov  r6,temp_options_max_len           ;
 b    memcopy_bytewise_for_8bit_bus     ;/
;------------------
memcopy_bytewise_for_8bit_bus:
@@copy_bytewise_lop:                    ;\
 ldrb r1,[r4],1                         ;
 strb r1,[r5],1                         ;
 subs r6,1                              ;
 bne  @@copy_bytewise_lop               ;/
 bx   lr
;------------------
hw_set_pitch_r4:
 mov  r1,REGBASE_IO                                     ;\
 add  r1,REG_TIMER0CNT                                  ; timer0 (sample rate)
 rsb  r4,10000h+(00h << 16)     ;\timer0, sysclk/1     ;
 strh r4,[r1]                    ;/                     ;/
 bx   lr
;------------------
.macro test_if_audio_dma_active
 mov  r3,REGBASE_IO                             ;\
 ldrb r3,[r3,REG_TIMER0CNT+2]   ;timer0.ctl     ;
 tst  r3,80h                                    ;/
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
hw_start_playback_unless_already:
 mov  r1,REGBASE_IO
 mov  r2,80h    ;timer0, sysclk/1, start
 strb r2,[r1,REG_TIMER0CNT+2]
 bx   lr
;------------------
hw_abort_stop_playback_dma:
 cpu_disable_irqs
 mov  r0,REGBASE_IO
 ldr   r2,[r0,REG_DMA2_CNT]         ;dma2.ctl   ;\check mono/stereo
 cmp   r2,0                         ;zf         ;/
 mov   r2,0                                     ;\
 str   r2,[r0,REG_DMA1_CNT]         ;dma1.stop  ; stop dma
 strne r2,[r0,REG_DMA2_CNT]         ;dma2.stop  ;/
;mov  r0,REGBASE_IO   ;lsb=00h                  ;\stop timer0 (sample rate)
 strb r0,[r0,REG_TIMER0CNT+2]    ;timer0.ctl=0  ;/
 mov  r2,1 << 4                                ;\ack timer1 (if any)
 strb r2,[r0,REG_IF]                    ;IF     ;/
 cpu_enable_irqs
 bx   lr
;------------------
toggle_play_pause_dma:
 cpu_disable_irqs
 mov  r0,REGBASE_IO
 ldrb r2,[r0,REG_TIMER0CNT+2]    ;timer0.ctl    ;\
 ldr  r1,[r11,pause_flag]                       ;
 eor  r1,1                                      ; toggle timer0 (sample rate)
 orr  r2,80h        ;activate timer             ; (on GBA, that will also
 eor  r2,r1,lsl 7   ;deactivate if paused       ; automatically freeze the
 strb r2,[r0,REG_TIMER0CNT+2]    ;timer0.ctl    ; audio DMA transfers)
 str  r1,[r11,pause_flag]                       ;/
 cpu_enable_irqs
 bx   lr
;------------------
hw_prepare_audio_dma:
 push lr
 cpu_disable_irqs
 mov  r7,REGBASE_IO                                             ;-I/O base
 mov  r1,4000h+200h                                             ;\
 strh r1,[r7,REG_SOUNDBIAS]      ;bias=200h, 8bit, 65536hz      ;
 mov  r1,80h                                                    ; sound control
 strh r1,[r7,REG_SOUNDCNT+4]     ;sound master enable           ;
 strh r7,[r7,REG_SOUNDCNT+0]     ;disable psg sound             ;
 ldr   r3,[r11,mp3ctx_output_num_channels]                      ; ;\check
 cmp   r3,2                                                     ; ;/stereo
 ldr   r1,=08b0ch  ;mono   (ch0=both speakers)                  ;
 xoreq r1,001100h  ;stereo (ch0=left, ch1=right)                ;
 strh r1,[r7,REG_SOUNDCNT+2]     ;sound fifo control            ;/
;- - -
 strb r7,[r7,REG_TIMER0CNT+2]  ;timer0, sysclk/1, stop  ;\timer0 (sample rate)
 ;(timer val is set elsewhere, via "apply_pitch")       ;/(but don't start yet)
 ldr  r4,[r11,mp3ctx_samples_output_size]               ;\
 ldr  r5,[r11,mp3ctx_output_num_channels]               ;
 mov  r5,r5,lsr 1   ;1,2 --> 0,1                           ; timer1 (length)
 mov  r4,r4,lsr r5  ;div2 when stereo                      ; (count-up)
 str  r4,[r12,snd_dma_blk_siz]                          ;
 rsb  r4,10000h+(0c4h << 16)    ;\timer1, count-up,    ;
 str  r4,[r7,REG_TIMER1CNT]      ;/start, irq           ;/

 ldr  r2,=sample_buffer                                 ;\
 str  r2,[r12,snd_dma_rd_ptr]                           ; rd/wr ptr
 str  r2,[r12,snd_dma_wr_ptr]                           ;/
 add  r3,r2,snd_dma_max_size                            ;\max ptr
 str  r3,[r12,snd_dma_max_ptr]                          ;/

 ldr   r3,[r11,mp3ctx_output_num_channels]                        ;\check
 cmp   r3,2                                                       ;/stereo
 mov   r4,0                         ;zero
 str   r4,[r7,REG_DMA1_CNT]         ;dma1.stop                    ;\dma off
 str   r4,[r7,REG_DMA2_CNT]         ;dma2.stop                    ;/
 str   r4,[r7,REG_SND_FIFO_A]       ;ch0.fifo manual write        ;\trigger
 streq r4,[r7,REG_SND_FIFO_B]       ;ch1.fifo manual write        ;/

 ldr   r4,=sample_buffer            ;src        ;\                  ;\
 str   r4,[r7,REG_DMA1_SAD]         ;dma1.sad   ;                   ;
 addeq r4,sample_dst_ch1_disp                   ;                   ;
 streq r4,[r7,REG_DMA2_SAD]         ;dma2.sad   ;/                  ;
 add   r4,r7,REG_SND_FIFO_A         ;ch0.fifo   ;\                  ; dma1/dma2
 str   r4,[r7,REG_DMA1_DAD]         ;dma1.dad   ;                   ;
 addeq r4,r7,REG_SND_FIFO_B         ;ch1.fifo   ;                   ;
 streq r4,[r7,REG_DMA2_DAD]         ;dma2.dad   ;/                  ;
 ldr   r4,=0b640h << 16 ;start, sound, 32bit, repeat, dst=fixed    ;
 str   r4,[r7,REG_DMA1_CNT]         ;dma1.ctl                       ;
 streq r4,[r7,REG_DMA2_CNT]         ;dma2.ctl                       ;/

        ;XXX above did originally accidently use 0b340h (16bit, src=fixed)
        ;    (which did accidently work in no$gba, but not on real hw)
        ;    (whereas, hw should ignore the 16bit/32bit flag, but src=fixed might have caused problems... ie. endlessly repeating the same 4-byte pattern?)
 cpu_enable_irqs
 pop  pc
;------------------
;------------------
;:----------------- Hardware I/O (NDS/DSi/3DS)
;------------------
;------------------
;:----------------- Hardware I/O (NDS/DSi)
;------------------
;------------------
;:----------------- Hardware I/O (3DS)
;------------------
;------------------
;:----------------- Timelog
;------------------
;------------------
 timelog_display_results:
  push lr
  ldr  r5,=txt_decode_timing1                   ;\
  bl   tty_wrstr_r5                             ;/
  ldr  r4,[r11,mp3ctx_total_output_size]        ;\
  mov  r5,1000         ;\mul 1000               ;
  umull r4,r5,r4,r5    ;/                       ;
  ldr  r3,[r11,mp3ctx_output_sample_rate]  ;\   ; duration in milliseconds
  ldr  r1,[r11,mp3ctx_output_num_channels] ;    ;
  ldr  r2,[r11,mp3ctx_dst_bytes_per_sample];    ;
  mul  r6,r1,r2   ;\DstBytesPerSecond      ;    ;
  mul  r6,r3,r6   ;/                       ;    ;
  bl   rom_div_r5r4_r6                     ;/   ;
  str  r4,[r11,mp3ctx_output_milliseconds]      ;
  bl   tty_decimal_r4_with_thousands_separator  ;/
  ldr  r5,=txt_decode_timing2                   ;\
  bl   tty_wrstr_r5                             ;/
  ldr  r5,=rdtsc_decoding                       ;\
  ldr  r4,[r5,0]                                ;
  ldr  r5,[r5,4]                                ; decoding time in milliseconds
  scale_clks_r5r4                               ;
  ldr  r6,=sysclk/1000                          ;
  bl   rom_div_r5r4_r6                          ;
  bl   tty_decimal_r4_with_thousands_separator  ;/
  ldr  r5,=txt_decode_timing3                   ;\
  bl   tty_wrstr_r5                             ;/
 ;- - -
  ldr  r5,=txt_clks_per_second          ;\
  bl   tty_wrstr_r5                     ;/
  ldr  r9,=rdtsc_list_start
 @@timelog_lop:
  ldr  r8,[r9]                  ;-get ptr to time
  ldr  r4,[r8,0]                ;\
  ldr  r5,[r8,4]                ; skip if zero
  orrs r4,r5                    ;
  beq  @@timelog_skip           ;/
  bl   tty_wrspc
  add  r5,r9,4                  ;\display name string
  bl   tty_wrstr_r5             ;/
  bl   tty_wrspc
  ldr  r4,[r8,4]   ;msw         ;\
  bl   tty_wrhex32bit           ; show full 64bit cycle count in hex
  ldr  r4,[r8,0]   ;lsw         ;
  bl   tty_wrhex32bit           ;
  bl   tty_wrspc                ;/
  ldr  r4,[r8,0]   ;lsw                          ;\
  ldr  r5,[r8,4]   ;msw                          ;
  scale_clks_r5r4                                ;
  mov  r7,1000          ;\                       ;
  mul  r6,r5,r7         ; mul 1000               ; display
  umull r4,r5,r4,r7     ;                        ; cycles/second
  add  r5,r6            ;/                       ; in decimal
  ldr  r6,[r11,mp3ctx_output_milliseconds]       ;
  cmp  r5,r6                                     ;
  bhs  @@timelog_oops   ;avoid div overkill      ;
  bl   rom_div_r5r4_r6  ;--> divide              ;
  bl   tty_decimal_r4_with_thousands_separator   ;
 @@timelog_oops:                                 ;/
  bl   tty_wrcrlf
 @@timelog_skip:
  add  r9,4+16                  ;\
  ldr  r3,=rdtsc_list_end       ; next
  cmp  r3,r9                    ;
  bne  @@timelog_lop            ;/
  pop  pc
 ;------------------
 reset_rdtsc_counters:
  ldr  r9,=rdtsc_list_start
 @@lop:
  ldr  r8,[r9]                  ;-get ptr to time
  mov  r3,0
  str  r3,[r8,0]
  str  r3,[r8,4]
  add  r9,4+16                  ;\
  ldr  r3,=rdtsc_list_end       ; next
  cmp  r3,r9                    ;
  bne  @@lop                    ;/
  bx   lr
;------------------
;:----------------- Text charset xlat table
;------------------
;------------------
.pool
;------------------
.macro db_ansi_to_utf8, n
 .if UNICODE_UTF8 & n>=80h
   .if n>800h
     db ((n >> 12) & 0Fh) | 0E0h
     db ((n >> 6)  & 3Fh) | 080h
     db ((n >> 0)  & 3Fh) | 080h
   .else
     db ((n >> 6)  & 1Fh) | 0C0h
     db ((n >> 0)  & 3Fh) | 080h
   .endif
 .else
   db n
 .endif
;SHIM-RENAMED .endm -> .endmacro
.endmacro
;------------------
;sort rules:
;sorting multi-language TITLES for multi-language USERS brings up problems:
; different languages may share SAME characters, with DIFFERENT sort rules
;  (eg. german has umlauts sorted same as A,O,U, but many nordic languages
;  have O-umlaut (or stuff like AE O/) sorted after Z).
; most languages simply don't have any sort rules for FOREIGN characters
;  (eg. Z doesn't exist in many nordic languages, and umlauts and other
;  accent marks exist in this or that language).
;anyways, one may assume that most people EXPECT foreign characters being
;located nearby similar latin chars, eg. AE near A, rather than after Z),
;the "chr_xlat_sort" entry follows that expectations.
; some special chars that don't resemble normal latin chars:
;  Eth   Used in Icelandic and Faroese (both have it after "d").
;  Thorn Used in Icelandic (which has it after "z") (although it may be also transcribed as "th" as in "the old", or "y" as in "ye olde", the latter being a cosmetic trabscription, because Thorn and Y did have similar shapes at some point in history)
; some symbols may be abused as letters...
;  $           Misused as S, like $hockwave
;  Euro        Misused as E
;  Yen         Misused as Y
;  Cent or (C) Misused as C
;  (R)         Misused as R
;see also: https://en.wikipedia.org/wiki/Alphabetical_order
;------------------
 sortcode_nul     equ 00h       ;-used as string end marker
 sortcode_unused  equ 0FFh      ;-
 sortcode_blank   equ ' '       ;-space/punctuation/symbols
 sortcode_digit_0 equ '0'       ;\
 sortcode_digit_1 equ '1'       ;
 sortcode_digit_2 equ '2'       ;
 sortcode_digit_3 equ '3'       ; digits 0-9
 sortcode_digit_4 equ '4'       ;
 sortcode_digit_5 equ '5'       ;
 sortcode_digit_6 equ '6'       ;
 sortcode_digit_7 equ '7'       ;
 sortcode_digit_8 equ '8'       ;
