.macro mp3mac_upsample_2_point_nonlinear_3x
 timelog_start rdtsc_upsampler
 ldr  r8,[r11,mp3ctx_samples_output_size]  ;siz
 ldr  r7,=mp3_upsample_buf                 ;src
 mov  r6,r9                                ;dst
 ldr  r1,[r11,mp3ctx_upsample_recent]          ;-end of recent block
@@lop:
;SHIM-UNROLLED .rept 4 = 4
   ldrsb r4,[r7],1        ;new
   sub  r5,r4,r1          ;diff=new-old
   sub  r2,r4,r5,asr 2    ;new-(1/4)
   sub  r1,r2,r5,asr 1    ;new-(3/4)
   strb r1,[r6],1
   strb r2,[r6],1
   mov  r1,r4
   strb r1,[r6],1
   ldrsb r4,[r7],1        ;new
   sub  r5,r4,r1          ;diff=new-old
   sub  r2,r4,r5,asr 2    ;new-(1/4)
   sub  r1,r2,r5,asr 1    ;new-(3/4)
   strb r1,[r6],1
   strb r2,[r6],1
   mov  r1,r4
   strb r1,[r6],1
   ldrsb r4,[r7],1        ;new
   sub  r5,r4,r1          ;diff=new-old
   sub  r2,r4,r5,asr 2    ;new-(1/4)
   sub  r1,r2,r5,asr 1    ;new-(3/4)
   strb r1,[r6],1
   strb r2,[r6],1
   mov  r1,r4
   strb r1,[r6],1
   ldrsb r4,[r7],1        ;new
   sub  r5,r4,r1          ;diff=new-old
   sub  r2,r4,r5,asr 2    ;new-(1/4)
   sub  r1,r2,r5,asr 1    ;new-(3/4)
   strb r1,[r6],1
   strb r2,[r6],1
   mov  r1,r4
   strb r1,[r6],1
 subs r8,4*3
 bhi  @@lop
;blo  $        ;oops
 str  r1,[r11,mp3ctx_upsample_recent]          ;-end of curr block
 timelog_end rdtsc_upsampler
 bx   lr
;SHIM-RENAMED .endm -> .endmacro
.endmacro
